---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
// import { useTranslations } from '~/utils/i18n';
import NewUserPromotion from '~/components/common/NewUserPromotion.astro';


const { lang = 'zh' } = Astro.params; // 从URL参数获取语言

// const t = await useTranslations(lang);

// import Announcement from '~/components/widgets/Announcement.astro';

import { getHeaderData } from '~/navigation';

import type { MetaData } from '~/types/index';
import { initializeTranslations } from '~/utils/i18n';

export interface Props {
  metadata?: MetaData;
  lang?: string;
  has_header?: boolean;
  has_footer?: boolean;
}

const { metadata, has_header = true, has_footer = true } = Astro.props;

const headerData = getHeaderData(lang);
initializeTranslations();
---

<Layout metadata={metadata}>
  <!-- <slot name="announcement">
    <Announcement />
  </slot> -->
  <NewUserPromotion lang={lang} />
  { has_header &&
    <slot name="header">
      <Header {...headerData} isSticky  />
    </slot>
  }
  <main>
    <slot />
  </main>
  { has_footer &&
    <slot name="footer">
      <Footer 
        lang={lang}
        theme="light"
      />
    </slot>
  }
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const inviteCode = urlParams.get('invite') || urlParams.get('ref') || urlParams.get('code');
    
    if (inviteCode) {
      // 检查缓存是否存在且未过期
      const cachedData = localStorage.getItem('inviteCodeData');
      const now = new Date().getTime();
      
      if (cachedData) {
        const { code, timestamp } = JSON.parse(cachedData);
        const isExpired = now - timestamp > 3 * 60 * 60 * 1000; // 3小时过期
        
        if (!isExpired) {
          // 缓存未过期，使用缓存的邀请码
          console.log('使用缓存的邀请码:', code);
        } else {
          // 缓存已过期，更新缓存
          updateInviteCodeCache(inviteCode);
        }
      } else {
        // 没有缓存，创建新缓存
        updateInviteCodeCache(inviteCode);
      }
    }

    function updateInviteCodeCache(code: string) {
      const data = {
        code,
        timestamp: new Date().getTime()
      };
      localStorage.setItem('inviteCodeData', JSON.stringify(data));
      console.log('更新邀请码缓存:', code);
    }
  });
</script>
