---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
// import { useTranslations } from '~/utils/i18n';

const { lang = 'zh' } = Astro.params; // 从URL参数获取语言

// const t = await useTranslations(lang);

// import Announcement from '~/components/widgets/Announcement.astro';

import { getHeaderData } from '~/navigation';

import type { MetaData } from '~/types';
import { initializeTranslations } from '~/utils/i18n';

export interface Props {
  metadata?: MetaData;
  lang?: string;
  has_header?: boolean;
  has_footer?: boolean;
}

const { metadata, has_header = true, has_footer = true } = Astro.props;

const headerData = getHeaderData(lang);
initializeTranslations();
---

<Layout metadata={metadata}>
  <!-- <slot name="announcement">
    <Announcement />
  </slot> -->
  { has_header &&
    <slot name="header">
      <Header {...headerData} isSticky  />
    </slot>
  }
  <main>
    <slot />
  </main>
  { has_footer &&
    <slot name="footer">
      <Footer 
        lang={lang}
        theme="light"
      />
    </slot>
  }
</Layout>
