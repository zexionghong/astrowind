---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { CallToAction as Props } from '~/types';

const {
  variant = 'secondary',
  target,
  text = Astro.slots.render('default'),
  icon = '',
  class: className = '',
  type,
  color = '',
  href,
  ...rest
} = Astro.props;

const variants = {
  primary: 'btn-primary bg-primary hover:bg-blue-700 text-white rounded-full shadow-glass transition-all duration-300',
  secondary: 'btn-secondary text-default glass-card',
  tertiary: 'btn btn-tertiary text-default',
  link: 'cursor-pointer hover:text-primary text-default',
  ghost: 'text-white hover:bg-white/20 hover:text-white transition-all duration-300 border border-white/30 hover:border-white/50',
};

const colorClass = color ? `bg-${color}-600 hover:bg-${color}-700 text-white` : '';
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button 
      type={type} 
      class={twMerge(variants[variant] || '', colorClass, className)} 
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </button>
  ) : (
    <a
      href={href}
      class={twMerge(variants[variant] || '', colorClass, className)}
      {...(target ? { target: target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </a>
  )
}
