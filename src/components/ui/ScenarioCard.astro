---
import { findImage } from '~/utils/images';
export interface ScenarioProps {
  color: string;
  title: string;
  description: string;
  benefits: string[];
  image: string;
}

const { color, title, description, benefits, image } = Astro.props;
const imageUrl = await findImage(image);
---

<div class={`group relative overflow-hidden bg-white dark:bg-slate-800 rounded-3xl p-8 mb-6 mx-auto max-w-6xl hover:shadow-lg transition-all duration-300`}>
  <div class="flex items-center justify-between">
    <div class="text-gray-700 dark:text-gray-100 max-w-[60%]">
      <h3 class={`text-2xl font-bold mb-4 text-gray-800 dark:text-white`}>{title}</h3>
      <p class="mb-6 text-gray-600 dark:text-gray-300 text-base leading-relaxed">{description}</p>
      <ul class="space-y-3">
        {benefits.map((benefit) => (
          <li class="flex items-center text-gray-600 dark:text-gray-300">
            <span class={`w-1.5 h-1.5 bg-blue-500 rounded-full mr-2.5`}></span>
            <span class="text-sm">{benefit}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="w-[320px] h-[180px] flex-shrink-0 pr-4 flex items-center">
      {imageUrl && <img 
        src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src} 
        alt={title} 
        class="w-full h-full object-contain"
        loading="lazy"
      />}
    </div>
  </div>
</div>

<style>
  .group {
    backdrop-filter: blur(8px);
  }
</style>