---
import { findImage } from '~/utils/images';
export interface ScenarioProps {
  color: string;
  title: string;
  description: string;
  benefits: string[];
  image: string;
  url?: string;
  lang?: string;
}

const { color, title, description, benefits, image, url, lang = 'zh' } = Astro.props;
const imageUrl = await findImage(image);

// 根据颜色设置主题
const colorThemes = {
  blue: {
    bg: 'bg-blue-50 dark:bg-blue-900/20',
    border: 'border-blue-200 dark:border-blue-800',
    title: 'text-blue-900 dark:text-blue-100',
    bullet: 'bg-blue-500',
    accent: 'text-blue-600 dark:text-blue-400'
  },
  green: {
    bg: 'bg-green-50 dark:bg-green-900/20',
    border: 'border-green-200 dark:border-green-800',
    title: 'text-green-900 dark:text-green-100',
    bullet: 'bg-green-500',
    accent: 'text-green-600 dark:text-green-400'
  },
  purple: {
    bg: 'bg-purple-50 dark:bg-purple-900/20',
    border: 'border-purple-200 dark:border-purple-800',
    title: 'text-purple-900 dark:text-purple-100',
    bullet: 'bg-purple-500',
    accent: 'text-purple-600 dark:text-purple-400'
  },
  red: {
    bg: 'bg-red-50 dark:bg-red-900/20',
    border: 'border-red-200 dark:border-red-800',
    title: 'text-red-900 dark:text-red-100',
    bullet: 'bg-red-500',
    accent: 'text-red-600 dark:text-red-400'
  },
  indigo: {
    bg: 'bg-indigo-50 dark:bg-indigo-900/20',
    border: 'border-indigo-200 dark:border-indigo-800',
    title: 'text-indigo-900 dark:text-indigo-100',
    bullet: 'bg-indigo-500',
    accent: 'text-indigo-600 dark:text-indigo-400'
  },
  teal: {
    bg: 'bg-teal-50 dark:bg-teal-900/20',
    border: 'border-teal-200 dark:border-teal-800',
    title: 'text-teal-900 dark:text-teal-100',
    bullet: 'bg-teal-500',
    accent: 'text-teal-600 dark:text-teal-400'
  },
  emerald: {
    bg: 'bg-emerald-50 dark:bg-emerald-900/20',
    border: 'border-emerald-200 dark:border-emerald-800',
    title: 'text-emerald-900 dark:text-emerald-100',
    bullet: 'bg-emerald-500',
    accent: 'text-emerald-600 dark:text-emerald-400'
  },
  cyan: {
    bg: 'bg-cyan-50 dark:bg-cyan-900/20',
    border: 'border-cyan-200 dark:border-cyan-800',
    title: 'text-cyan-900 dark:text-cyan-100',
    bullet: 'bg-cyan-500',
    accent: 'text-cyan-600 dark:text-cyan-400'
  },
  violet: {
    bg: 'bg-violet-50 dark:bg-violet-900/20',
    border: 'border-violet-200 dark:border-violet-800',
    title: 'text-violet-900 dark:text-violet-100',
    bullet: 'bg-violet-500',
    accent: 'text-violet-600 dark:text-violet-400'
  },
  orange: {
    bg: 'bg-orange-50 dark:bg-orange-900/20',
    border: 'border-orange-200 dark:border-orange-800',
    title: 'text-orange-900 dark:text-orange-100',
    bullet: 'bg-orange-500',
    accent: 'text-orange-600 dark:text-orange-400'
  },
  amber: {
    bg: 'bg-amber-50 dark:bg-amber-900/20',
    border: 'border-amber-200 dark:border-amber-800',
    title: 'text-amber-900 dark:text-amber-100',
    bullet: 'bg-amber-500',
    accent: 'text-amber-600 dark:text-amber-400'
  },
  rose: {
    bg: 'bg-rose-50 dark:bg-rose-900/20',
    border: 'border-rose-200 dark:border-rose-800',
    title: 'text-rose-900 dark:text-rose-100',
    bullet: 'bg-rose-500',
    accent: 'text-rose-600 dark:text-rose-400'
  }
};

const theme = colorThemes[color] || colorThemes.blue;
---

{url ? (
  <a href={url} class={`group relative overflow-hidden ${theme.bg} border ${theme.border} rounded-3xl p-8 mb-6 mx-auto max-w-6xl hover:shadow-lg transition-all duration-300 block cursor-pointer hover:scale-[1.02]`}>
    <div class="flex items-center justify-between">
      <div class="text-gray-700 dark:text-gray-100 max-w-[60%]">
        <h3 class={`text-2xl font-bold mb-4 ${theme.title}`}>{title}</h3>
        <p class="mb-6 text-gray-600 dark:text-gray-300 text-base leading-relaxed">{description}</p>
        <ul class="space-y-3">
          {benefits.map((benefit: string) => (
            <li class="flex items-center text-gray-600 dark:text-gray-300">
              <span class={`w-1.5 h-1.5 ${theme.bullet} rounded-full mr-2.5`}></span>
              <span class="text-sm">{benefit}</span>
            </li>
          ))}
        </ul>
        <div class={`mt-4 inline-flex items-center ${theme.accent} text-sm font-medium`}>
          {lang === 'zh' ? '了解详情' : 'Learn More'}
          <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </div>
      <div class="w-[320px] h-[180px] flex-shrink-0 pr-4 flex items-center">
        {imageUrl && <img
          src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src}
          alt={title}
          class="w-full h-full object-contain"
          loading="lazy"
        />}
      </div>
    </div>
  </a>
) : (
  <div class={`group relative overflow-hidden ${theme.bg} border ${theme.border} rounded-3xl p-8 mb-6 mx-auto max-w-6xl hover:shadow-lg transition-all duration-300`}>
    <div class="flex items-center justify-between">
      <div class="text-gray-700 dark:text-gray-100 max-w-[60%]">
        <h3 class={`text-2xl font-bold mb-4 ${theme.title}`}>{title}</h3>
        <p class="mb-6 text-gray-600 dark:text-gray-300 text-base leading-relaxed">{description}</p>
        <ul class="space-y-3">
          {benefits.map((benefit: string) => (
            <li class="flex items-center text-gray-600 dark:text-gray-300">
              <span class={`w-1.5 h-1.5 ${theme.bullet} rounded-full mr-2.5`}></span>
              <span class="text-sm">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="w-[320px] h-[180px] flex-shrink-0 pr-4 flex items-center">
        {imageUrl && <img
          src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src}
          alt={title}
          class="w-full h-full object-contain"
          loading="lazy"
        />}
      </div>
    </div>
  </div>
)}

<style>
  .group {
    backdrop-filter: blur(8px);
  }
</style>