---
const { lang = 'zh' } = Astro.params;
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-gray-200 bg-white/95 p-4 shadow-2xl backdrop-blur dark:border-gray-700 dark:bg-gray-900/95"
  role="dialog"
  aria-live="polite"
  aria-label={lang === 'zh' ? 'Cookie同意弹窗' : 'Cookie consent dialog'}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="text-sm leading-6 text-gray-700 dark:text-gray-200">
      {lang === 'zh'
        ? '我们使用 Cookie 提升网站体验，并在你同意后启用统计分析。你可以接受或仅使用必要 Cookie。'
        : 'We use cookies to improve site experience and only enable analytics after your consent. You can accept or keep necessary cookies only.'}
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        id="cookie-accept"
        type="button"
        class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
      >
        {lang === 'zh' ? '接受全部' : 'Accept all'}
      </button>
      <button
        id="cookie-decline"
        type="button"
        class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800"
      >
        {lang === 'zh' ? '仅必要 Cookie' : 'Necessary only'}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const key = 'ipflex-cookie-consent';
    const banner = document.getElementById('cookie-consent');
    const acceptedEvent = 'ipflex-cookie-accepted';
    if (!banner) return;
    const saved = localStorage.getItem(key);
    if (saved === 'accepted' || saved === 'necessary') return;
    banner.classList.remove('hidden');

    const closeBanner = (value) => {
      localStorage.setItem(key, value);
      banner.classList.add('hidden');
      if (value === 'accepted') {
        window.dispatchEvent(new CustomEvent(acceptedEvent));
      }
    };

    document.getElementById('cookie-accept')?.addEventListener('click', () => closeBanner('accepted'));
    document.getElementById('cookie-decline')?.addEventListener('click', () => closeBanner('necessary'));
  })();
</script>
