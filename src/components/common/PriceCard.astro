---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import cardBg from '~/assets/images/bg/card_b.png';

export interface PriceItem {
  description: string;
}

export interface PriceCardProps {
  title: string;
  subtitle?: string;
  price: string | number;
  period?: string;
  items?: Array<PriceItem>;
  callToAction?: {
    text: string;
    href: string;
    target?: string;
  } | string;
  hasRibbon?: boolean;
  ribbonTitle?: string;
  isHighlighted?: boolean;
}

const {
  index,
  title,
  subtitle = '',
  price,
  period = '',
  items = [],
  callToAction,
  hasRibbon = false,
  ribbonTitle = '',
  isHighlighted = false
} = Astro.props;

const showHighlight = isHighlighted || hasRibbon;

let opacity = "";
let isWhite = false;
if (index % 2 === 0) {
  opacity = "opacity-10"
  isWhite = false
} else {
  opacity = "opacity-100"
  isWhite = true
}
---

<div class="w-full flex justify-center">
  <div class="w-full max-w-xs transform scale-70 origin-center">
    <div class={`rounded-xl overflow-hidden shadow-lg h-full flex flex-col relative ${showHighlight ? 'bg-blue-600 text-white' : 'bg-white text-gray-800'}`}>
      {!showHighlight && (
        <div class={`absolute inset-0 z-0 ${opacity}`}>
          <img src={cardBg.src} alt="" class="w-full h-full max-w-full object-cover" loading="lazy" decoding="async" />
        </div>
      )}
      
      {showHighlight && (
        <div class="absolute inset-0 z-0">
          <div class="absolute bottom-0 right-0 w-full h-1/2 overflow-hidden">
            <div class="w-full h-full rounded-[40%] bg-blue-500 opacity-20 transform translate-x-[10%] translate-y-[20%]"></div>
          </div>
        </div>
      )}
      
      {hasRibbon && ribbonTitle && (
        <div class="absolute right-0 top-0 z-10">
          <div class="bg-orange-500 text-white py-1 px-5 transform rotate-45 translate-x-[30%] translate-y-[40%] font-medium text-xs">
            {ribbonTitle}
          </div>
        </div>
      )}
      
      <div class={`px-5 py-8 relative z-1 ${showHighlight ? 'pt-12 pb-10' : ''}`}>
        <h2 class={`text-2xl font-bold mb-2 ${showHighlight || isWhite ? 'text-blue-100' : 'text-gray-600'}`}>{title}</h2>
        <p class={`text-sm mb-6 ${showHighlight || isWhite ? 'text-blue-100' : 'text-gray-600'}`}>{subtitle}</p>
        
        <div class="flex items-center my-7">
          <div>
            <span class={`text-4xl font-bold ${showHighlight || isWhite ? 'text-blue-100' : 'text-blue-600'}`}>￥{price}</span>
            <span class={`text-lg ml-1 ${showHighlight || isWhite ? 'text-blue-100' : 'text-blue-600'}`}>{period}</span>
          </div>
        </div>
        <br/>
        <ul class="space-y-2 mt-12 mb-2">
          {items && items.map(({ description }) => (
            <li class="flex items-center">
              <div class={`rounded-full p-1 mr-2 ${showHighlight ? 'bg-blue-400' : 'bg-blue-500'}`}>
                <Icon name="tabler:check" class="w-3 h-3 text-white" />
              </div>
              <span class={`${showHighlight ? 'text-blue-50' : 'text-gray-700'} text-sm`}>{description}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="px-5 pb-7 mt-auto relative z-1">
        {callToAction && (
          <div class="text-center">
            {typeof callToAction === 'string' ? (
              <div set:html={callToAction} />
            ) : (
              callToAction && callToAction.href && 
              <a
                href={callToAction.href}
                class={`block w-full py-2.5 px-4 rounded-lg text-center font-medium text-sm ${showHighlight ? 'bg-white text-blue-600 hover:bg-gray-100' : !isWhite ? 'bg-blue-100 text-blue-600 hover:bg-blue-200' : 'bg-blue-600 text-white hover:bg-blue-700'}`}
                target={callToAction.target || '_self'}
                rel={callToAction.target === '_blank' ? 'noopener noreferrer' : undefined}
              >
                {callToAction.text || '立即购买'}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</div> 
