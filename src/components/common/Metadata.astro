---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props {
  title?: string;
  ignoreTitleTemplate?: boolean;
  canonical?: string;
  robots?: {
    index?: boolean;
    follow?: boolean;
  };
  description?: string;
  openGraph?: {
    title?: string;
    description?: string;
    url?: string;
    type?: string;
    image?: string;
    site_name?: string;
    images?: Array<{
      url: string;
      width?: number;
      height?: number;
    }>;
  };
  twitter?: {
    card?: string;
    site?: string;
    creator?: string;
    title?: string;
    description?: string;
    image?: string;
  };
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

// 获取当前语言和生成 hreflang URLs（稳定处理 /、/en、/zh 以及子路径）
const { lang = 'zh' } = Astro.params;

const autoDescription =
  !description && typeof title === 'string' && title.trim().length > 0
    ? lang === 'zh'
      ? `${title}。IPFlex面向企业提供稳定可扩展的代理网络接入能力，覆盖静态住宅、动态住宅与数据中心节点，支持城市级定位、API集成与长期运维支持，适用于数据采集、广告验证与跨境运营。`
      : `${title} - IPFlex enterprise proxy services for static residential, dynamic residential, and datacenter proxies with HTTP/SOCKS5 support.`
    : undefined;
const currentPath = Astro.url.pathname;

const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
const pathWithoutLocale = normalizedPath
  .replace(/^\/(zh|en)(?=\/|$)/, '')
  .replace(/^$/, '/');

const isRootWithoutLocale = normalizedPath === '/';
const alternateUrls = {
  zh: isRootWithoutLocale ? '/' : `/zh${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`,
  en: `/en${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`,
};

const routePath = normalizedPath;
const isHomePage = /^\/(zh|en)?$/.test(routePath);
const isBlogPage = /^\/(zh|en)\/blog(\/|$)/.test(routePath);
const isNoindexLandingPage = /^\/(zh|en)\/register(\/)?$/.test(routePath);
const isCommercialPage = /(proxy|pricing|detail|use-case|scenarios|register)/.test(routePath);

const shouldRenderWebsiteSchema = isHomePage;
const shouldRenderProductSchema = isCommercialPage && !isBlogPage && !isNoindexLandingPage;
const shouldRenderServiceSchema = isCommercialPage && !isNoindexLandingPage;
const shouldRenderMainSchema = isHomePage;

const currentOgLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const schemaServiceName = lang === 'zh' ? 'IPFlex IP代理服务' : 'IPFlex Proxy Services';
const schemaPageName = typeof title === 'string' && title.trim().length > 0 ? title.trim() : schemaServiceName;
const isZh = lang === 'zh';
const schemaDescription =
  description ||
  (isZh
    ? 'IPFlex提供企业级住宅代理、动态代理与数据中心代理服务，覆盖全球200+国家和地区。'
    : 'IPFlex provides enterprise-grade residential, rotating, and datacenter proxy services across 200+ countries and regions.');
const schemaAlternateNames = isZh
  ? ['IPFlex IP代理服务', 'IPFlex住宅代理', 'IPFlex数据中心代理', 'IPFlex HTTP代理', 'IPFlex SOCKS5代理']
  : ['IPFlex Proxy Service', 'IPFlex Residential Proxy', 'IPFlex Datacenter Proxy', 'IPFlex HTTP Proxy', 'IPFlex SOCKS5 Proxy'];
const schemaKeywords = isZh
  ? ['IP代理', '住宅代理', '数据中心代理', 'HTTP代理', 'SOCKS5代理', '网页抓取代理', '跨境电商代理', '广告验证代理', '静态代理', '动态代理']
  : ['IP proxy', 'residential proxy', 'datacenter proxy', 'HTTP proxy', 'SOCKS5 proxy', 'web scraping proxy', 'ecommerce proxy', 'ad verification proxy', 'static proxy', 'rotating proxy'];
const schemaServiceTypes = isZh
  ? ['静态住宅代理服务', '动态住宅代理服务', '数据中心代理服务', 'HTTP代理服务', 'SOCKS5代理服务', '网页抓取代理API', '跨境电商代理服务', '广告验证代理服务', '企业级IP解决方案']
  : ['Static Residential Proxy Service', 'Dynamic Residential Proxy Service', 'Datacenter Proxy Service', 'HTTP Proxy Service', 'SOCKS5 Proxy Service', 'Web Scraping Proxy API', 'Cross-border E-commerce Proxy', 'Ad Verification Proxy Service', 'Enterprise IP Solutions'];
const serviceCatalogItems = isZh
  ? [
      {
        name: '静态住宅代理',
        description: '高质量住宅IP，稳定可靠，适合跨境电商、市场调研等长期业务场景',
        category: '住宅代理服务',
      },
      {
        name: '动态住宅代理',
        description: '动态轮换IP池，千万级IP资源，适合大规模数据采集、网页抓取等场景',
        category: '动态代理服务',
      },
      {
        name: '数据中心代理',
        description: '高速数据中心IP，性价比高，适合API调用、自动化测试等场景',
        category: '数据中心服务',
      },
    ]
  : [
      {
        name: 'Static Residential Proxy',
        description: 'Stable real residential IPs for long-session operations such as cross-border e-commerce and market research.',
        category: 'Residential proxy service',
      },
      {
        name: 'Dynamic Residential Proxy',
        description: 'Rotating residential IP pool for high-volume crawling and data collection with anti-blocking resilience.',
        category: 'Rotating proxy service',
      },
      {
        name: 'Datacenter Proxy',
        description: 'High-speed datacenter IPs for API access, automation testing, and cost-efficient scalable workloads.',
        category: 'Datacenter proxy service',
      },
    ];
const organizationSchema = {
  '@type': 'Organization',
  name: 'IPFlex',
  url: SITE.site,
  description: isZh
    ? 'IPFlex 提供企业级代理网络服务，覆盖住宅代理、动态代理与数据中心代理。'
    : 'IPFlex provides enterprise-grade proxy services including residential, rotating, and datacenter proxies.',
  sameAs: ['https://x.com/IPFlexSupport', 'https://t.me/IPFlexProxy', 'https://docs.ipflex.ink/'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@ipflex.ink',
    availableLanguage: ['zh-CN', 'en-US'],
  },
};

const localizedDefaultMetadata =
  lang === 'en'
    ? {
        title: {
          default: 'IPFlex - Premium IP Proxy Service | Residential Proxy | HTTP Proxy | SOCKS5 Proxy',
          template: '%s — IPFlex Proxy Service',
        },
        description:
          'IPFlex offers enterprise-grade IP proxy services: static residential proxies, dynamic residential proxies, datacenter proxies. Supports HTTP/SOCKS5 protocols, covers 200+ countries, serves web scraping proxy, e-commerce proxy, ad verification proxy scenarios. 99.9% uptime, free trial, 24/7 support. Buy proxy service now!',
      }
    : {
        title: {
          default: METADATA?.title?.default,
          template: METADATA?.title?.template,
        },
        description: METADATA?.description,
      };

const normalizeMetaText = (text: unknown) => {
  if (typeof text !== 'string') return text;
  return text.replace(/\s+/g, ' ').trim();
};

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: currentOgLocale,
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: localizedDefaultMetadata.title.default,
    titleTemplate: localizedDefaultMetadata.title.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: localizedDefaultMetadata.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description ?? autoDescription,
    openGraph: { url: canonical, description: openGraph?.description ?? description ?? autoDescription, ...openGraph },
    twitter: twitter,
  }
);

const shouldRenderHreflang = seoProps.noindex !== true;

// 标题/描述规范化：仅清理空白，避免输出被强制截断为省略号
seoProps.title = normalizeMetaText(seoProps.title) as string;
seoProps.description = normalizeMetaText(seoProps.description) as string;
if (seoProps.openGraph) {
  seoProps.openGraph.title = normalizeMetaText(seoProps.openGraph.title || seoProps.title) as string;
  seoProps.openGraph.description = normalizeMetaText(seoProps.openGraph.description || seoProps.description) as string;
}
if (seoProps.twitter) {
  seoProps.twitter.title = normalizeMetaText(seoProps.twitter.title || seoProps.title) as string;
  seoProps.twitter.description = normalizeMetaText(seoProps.twitter.description || seoProps.description) as string;
}

// 添加结构化数据
const mainStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: schemaPageName,
  alternateName: schemaAlternateNames,
  applicationCategory: 'IP Proxy Service',
  operatingSystem: 'All',
  keywords: schemaKeywords,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    price: '0',
    priceCurrency: 'USD'
  },
  ...(isHomePage
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: '1320',
        },
      }
    : {}),
  description: schemaDescription,
  provider: organizationSchema,
  serviceType: schemaServiceTypes,
  areaServed: {
    '@type': 'Country',
    name: 'Global'
  }
};


const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: schemaPageName,
  description: schemaDescription,
  url: canonical,
  image: `${SITE.site}/images/hero-proxy.webp`,
  category: 'Proxy Service',
  brand: {
    '@type': 'Brand',
    name: 'IPFlex'
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: canonical
  }
};

// 添加WebSite结构化数据
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IPFlex',
  url: SITE.site,
  description: schemaDescription,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
  publisher: {
    ...organizationSchema
  }
};

// 添加Service结构化数据
const serviceStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: schemaPageName,
  serviceType: 'Proxy Server Service',
  provider: {
    ...organizationSchema,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Global',
      addressCountry: 'Worldwide'
    }
  },
  areaServed: [
    {
      '@type': 'Place',
      name: 'China',
      description: '专为中国用户优化的代理服务'
    },
    {
      '@type': 'Place', 
      name: 'Worldwide',
      description: '全球200+国家和地区代理服务'
    }
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'IP Proxy Services',
    itemListElement: serviceCatalogItems.map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        ...item,
      },
    })),
  }
};
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />

<!-- 添加hreflang多语言支持 -->
{shouldRenderHreflang && (
  <>
    <link rel="alternate" hreflang="zh" href={`${SITE.site}${alternateUrls.zh}`} />
    <link rel="alternate" hreflang="en" href={`${SITE.site}${alternateUrls.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.site}${alternateUrls.zh}`} />
  </>
)}
<link rel="alternate" type="text/plain" href={`${SITE.site}/llms.txt`} />

<!-- 细化爬虫抓取策略 -->
<meta name="googlebot" content="index, follow, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-video-preview:-1" />
<meta name="baiduspider" content="index, follow, max-image-preview:large" />
<meta name="sogou" content="index, follow" />
<meta name="360spider" content="index, follow" />

<!-- 添加更多搜索引擎优化标签 -->
<meta name="author" content="IPFlex Team" />
<meta name="generator" content="Astro" />
<meta name="rating" content="General" />
<meta name="distribution" content="Global" />
<meta name="language" content={lang || 'zh'} />
<meta name="geo.region" content="Global" />
<meta name="geo.placename" content="Worldwide" />

<!-- 添加更多SEO meta标签 -->
<meta name="theme-color" content="#0ea5e9" />
<meta name="msapplication-TileColor" content="#0ea5e9" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<!-- 多语言关键词优化 -->
{lang === 'zh' ? (
  <meta name="keywords" content="IP代理,住宅代理,数据中心代理,SOCKS5代理,HTTP代理,网页抓取,跨境电商,代理服务器,动态IP,静态IP" />
) : (
  <meta name="keywords" content="IP proxy,residential proxy,datacenter proxy,SOCKS5 proxy,HTTP proxy,web scraping proxy,ecommerce proxy,rotating proxy,static IP,dynamic IP" />
)}
<meta name="Classification" content="Business" />
<meta name="copyright" content="IPFlex" />
<meta name="revisit-after" content="7 days" />
<meta name="resource-type" content="document" />

<!-- Inter font is loaded automatically by Astro from Tailwind CSS -->

<!-- DNS预解析和预连接优化 -->
<link rel="dns-prefetch" href="https://www.google-analytics.com" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://www.google-analytics.com" />
<link rel="preconnect" href="https://dashboard.ipflex.ink" />

<!-- CSS and JS assets are loaded automatically by Astro -->

{shouldRenderMainSchema && <script type="application/ld+json" set:html={JSON.stringify(mainStructuredData)} />}
{shouldRenderProductSchema && <script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />}
{shouldRenderWebsiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />}
{shouldRenderServiceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />}
