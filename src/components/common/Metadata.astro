---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props {
  title?: string;
  ignoreTitleTemplate?: boolean;
  canonical?: string;
  robots?: {
    index?: boolean;
    follow?: boolean;
  };
  description?: string;
  openGraph?: {
    title?: string;
    description?: string;
    url?: string;
    type?: string;
    image?: string;
    site_name?: string;
    images?: Array<{
      url: string;
      width?: number;
      height?: number;
    }>;
  };
  twitter?: {
    card?: string;
    site?: string;
    creator?: string;
    title?: string;
    description?: string;
    image?: string;
  };
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

// 获取当前语言和生成hreflang URLs
const { lang = 'zh' } = Astro.params;
const currentPath = Astro.url.pathname;
const alternateUrls = {
  'zh': currentPath.replace('/en/', '/zh/').replace(/^\/en$/, '/zh').replace(/^\/en\//, '/zh/'),
  'en': currentPath.replace('/zh/', '/en/').replace(/^\/zh$/, '/en').replace(/^\/zh\//, '/en/')
};

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);

// 添加结构化数据
const mainStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'IPFlex',
  applicationCategory: 'Proxy Service',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    price: '0',
    priceCurrency: 'USD'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '1320'
  },
  description: description || METADATA?.description,
  provider: {
    '@type': 'Organization',
    name: 'IPFlex',
    description: 'Enterprise-grade proxy solutions provider',
    url: 'https://ipflex.ink',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      availableLanguage: ['en', 'zh']
    }
  },
  serviceType: [
    'Static Residential Proxies',
    'Dynamic Datacenter IPs',
    'Web Scraping Proxy API',
    'Enterprise IP Solutions'
  ],
  areaServed: {
    '@type': 'Country',
    name: 'Global'
  }
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '代理IP如何工作？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '代理IP作为中间服务器，可以隐藏您的真实IP地址，帮助您访问受地理限制的内容，同时提供额外的安全性和匿名性保护。'
      }
    },
    {
      '@type': 'Question',
      name: '静态住宅IP和动态IP有什么区别？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '静态住宅IP是固定不变的真实住宅IP地址，适合需要保持IP稳定的业务场景；动态IP则会定期自动更换，适合需要频繁切换IP的数据采集任务。'
      }
    },
    {
      '@type': 'Question',
      name: 'IPFlex的IP资源覆盖哪些地区？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '我们的IP资源池覆盖全球200+国家和地区，支持精确到城市的地理位置定位，满足您的全球业务需求。'
      }
    }
  ]
};

const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'IPFlex Proxy Services',
  description: description || METADATA?.description,
  brand: {
    '@type': 'Brand',
    name: 'IPFlex'
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    highPrice: '999',
    lowPrice: '0',
    offerCount: '5'
  }
};
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />

<!-- 添加hreflang多语言支持 -->
<link rel="alternate" hreflang="zh" href={`${SITE.site}${alternateUrls.zh}`} />
<link rel="alternate" hreflang="en" href={`${SITE.site}${alternateUrls.en}`} />
<link rel="alternate" hreflang="x-default" href={`${SITE.site}${alternateUrls.zh}`} />

<!-- 优化缓存控制策略 -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="baidu-site-verification" content="codeva-Jb90hwYhf4" />

<!-- 添加更多SEO meta标签 -->
<meta name="theme-color" content="#0ea5e9" />
<meta name="msapplication-TileColor" content="#0ea5e9" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<!-- 预加载关键资源 -->
<link rel="preload" href="/@fontsource-variable/inter/index.css" as="style" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<script type="application/ld+json" set:html={JSON.stringify(mainStructuredData)} />
<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
<script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />
