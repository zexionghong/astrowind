---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props {
  title?: string;
  ignoreTitleTemplate?: boolean;
  canonical?: string;
  robots?: {
    index?: boolean;
    follow?: boolean;
  };
  description?: string;
  openGraph?: {
    title?: string;
    description?: string;
    url?: string;
    type?: string;
    image?: string;
    site_name?: string;
    images?: Array<{
      url: string;
      width?: number;
      height?: number;
    }>;
  };
  twitter?: {
    card?: string;
    site?: string;
    creator?: string;
    title?: string;
    description?: string;
    image?: string;
  };
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

// 获取当前语言和生成 hreflang URLs（稳定处理 /、/en、/zh 以及子路径）
const { lang = 'zh' } = Astro.params;

const autoDescription =
  !description && typeof title === 'string' && title.trim().length > 0
    ? lang === 'zh'
      ? `${title} - IPFlex企业级代理IP服务，覆盖静态住宅、动态住宅与数据中心代理，支持HTTP/SOCKS5协议。`
      : `${title} - IPFlex enterprise proxy services for static residential, dynamic residential, and datacenter proxies with HTTP/SOCKS5 support.`
    : undefined;
const currentPath = Astro.url.pathname;

const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
const pathWithoutLocale = normalizedPath
  .replace(/^\/(zh|en)(?=\/|$)/, '')
  .replace(/^$/, '/');

const alternateUrls = {
  zh: `/zh${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`,
  en: `/en${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`,
};

const routePath = normalizedPath;
const isHomePage = /^\/(zh|en)?$/.test(routePath);
const isBlogPage = /^\/(zh|en)\/blog(\/|$)/.test(routePath);
const isCommercialPage = /(proxy|pricing|detail|use-case|scenarios)/.test(routePath);

const shouldRenderWebsiteSchema = isHomePage;
const shouldRenderProductSchema = !isBlogPage;
const shouldRenderServiceSchema = isHomePage || isCommercialPage;
const shouldRenderMainSchema = !isBlogPage;

const currentOgLocale = lang === 'zh' ? 'zh_CN' : 'en_US';

const localizedDefaultMetadata =
  lang === 'en'
    ? {
        title: {
          default: 'IPFlex - Premium IP Proxy Service | Residential Proxy | HTTP Proxy | SOCKS5 Proxy',
          template: '%s — IPFlex Proxy Service',
        },
        description:
          'IPFlex offers enterprise-grade IP proxy services: static residential proxies, dynamic residential proxies, datacenter proxies. Supports HTTP/SOCKS5 protocols, covers 200+ countries, serves web scraping proxy, e-commerce proxy, ad verification proxy scenarios. 99.9% uptime, free trial, 24/7 support. Buy proxy service now!',
      }
    : {
        title: {
          default: METADATA?.title?.default,
          template: METADATA?.title?.template,
        },
        description: METADATA?.description,
      };

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: currentOgLocale,
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: localizedDefaultMetadata.title.default,
    titleTemplate: localizedDefaultMetadata.title.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: localizedDefaultMetadata.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description ?? autoDescription,
    openGraph: { url: canonical, description: openGraph?.description ?? description ?? autoDescription, ...openGraph },
    twitter: twitter,
  }
);

// 添加结构化数据
const mainStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'IPFlex IP代理服务',
  alternateName: ['IPFlex Proxy Service', 'IPFlex住宅代理', 'IPFlex数据中心代理', 'IPFlex HTTP代理', 'IPFlex SOCKS5代理'],
  applicationCategory: 'IP Proxy Service',
  operatingSystem: 'All',
  keywords: ['IP代理', '住宅代理', '数据中心代理', 'HTTP代理', 'SOCKS5代理', '网页抓取代理', '跨境电商代理', '广告验证代理', '静态代理', '动态代理'],
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    price: '0',
    priceCurrency: 'USD'
  },
  ...(isHomePage
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: '1320',
        },
      }
    : {}),
  description: description || METADATA?.description,
  provider: {
    '@type': 'Organization',
    name: 'IPFlex',
    description: 'Professional IP proxy service provider offering residential proxies, datacenter proxies, HTTP/SOCKS5 proxy solutions for enterprise customers',
    url: 'https://ipflex.ink',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      availableLanguage: ['en', 'zh']
    }
  },
  serviceType: [
    'Static Residential Proxy Service',
    'Dynamic Residential Proxy Service', 
    'Datacenter Proxy Service',
    'HTTP Proxy Service',
    'SOCKS5 Proxy Service',
    'Web Scraping Proxy API',
    'Cross-border E-commerce Proxy',
    'Ad Verification Proxy Service',
    'Enterprise IP Solutions'
  ],
  areaServed: {
    '@type': 'Country',
    name: 'Global'
  }
};


const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'IPFlex Proxy Services',
  description: description || METADATA?.description,
  brand: {
    '@type': 'Brand',
    name: 'IPFlex'
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    highPrice: '999',
    lowPrice: '0',
    offerCount: '5'
  }
};

// 添加WebSite结构化数据
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IPFlex',
  url: SITE.site,
  description: description || METADATA?.description,
  publisher: {
    '@type': 'Organization',
    name: 'IPFlex',
    url: SITE.site
  }
};

// 添加Service结构化数据
const serviceStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IP代理服务',
  serviceType: 'Proxy Server Service',
  provider: {
    '@type': 'Organization',
    name: 'IPFlex',
    url: SITE.site,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Global',
      addressCountry: 'Worldwide'
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'support@ipflex.ink',
      availableLanguage: ['zh-CN', 'en-US']
    }
  },
  areaServed: [
    {
      '@type': 'Place',
      name: 'China',
      description: '专为中国用户优化的代理服务'
    },
    {
      '@type': 'Place', 
      name: 'Worldwide',
      description: '全球200+国家和地区代理服务'
    }
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'IP Proxy Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: '静态住宅代理',
          description: '高质量住宅IP，稳定可靠，适合跨境电商、市场调研等长期业务场景',
          category: '住宅代理服务'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: '动态住宅代理',
          description: '动态轮换IP池，千万级IP资源，适合大规模数据采集、网页抓取等场景',
          category: '动态代理服务'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: '数据中心代理',
          description: '高速数据中心IP，性价比高，适合API调用、自动化测试等场景',
          category: '数据中心服务'
        }
      }
    ]
  }
};
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />

<!-- 添加hreflang多语言支持 -->
<link rel="alternate" hreflang="zh" href={`${SITE.site}${alternateUrls.zh}`} />
<link rel="alternate" hreflang="en" href={`${SITE.site}${alternateUrls.en}`} />
<link rel="alternate" hreflang="x-default" href={`${SITE.site}${alternateUrls.zh}`} />

<!-- 细化爬虫抓取策略 -->
<meta name="googlebot" content="index, follow, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-video-preview:-1" />
<meta name="baiduspider" content="index, follow, max-image-preview:large" />
<meta name="sogou" content="index, follow" />
<meta name="360spider" content="index, follow" />

<!-- 添加更多搜索引擎优化标签 -->
<meta name="author" content="IPFlex Team" />
<meta name="generator" content="Astro" />
<meta name="rating" content="General" />
<meta name="distribution" content="Global" />
<meta name="language" content={lang || 'zh'} />
<meta name="geo.region" content="Global" />
<meta name="geo.placename" content="Worldwide" />

<!-- 添加更多SEO meta标签 -->
<meta name="theme-color" content="#0ea5e9" />
<meta name="msapplication-TileColor" content="#0ea5e9" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<!-- 多语言关键词优化 -->
{lang === 'zh' ? (
  <meta name="keywords" content="IP代理,住宅代理,数据中心代理,SOCKS5代理,HTTP代理,网页抓取,跨境电商,代理服务器,动态IP,静态IP" />
) : (
  <meta name="keywords" content="IP proxy,residential proxy,datacenter proxy,SOCKS5 proxy,HTTP proxy,web scraping proxy,ecommerce proxy,rotating proxy,static IP,dynamic IP" />
)}
<meta name="Classification" content="Business" />
<meta name="copyright" content="IPFlex" />
<meta name="revisit-after" content="7 days" />
<meta name="resource-type" content="document" />

<!-- Inter font is loaded automatically by Astro from Tailwind CSS -->

<!-- DNS预解析和预连接优化 -->
<link rel="dns-prefetch" href="https://www.google-analytics.com" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://www.google-analytics.com" />
<link rel="preconnect" href="https://dashboard.ipflex.ink" />

<!-- CSS and JS assets are loaded automatically by Astro -->

<!-- 中国本地化结构化数据 -->
{lang === 'zh' && (
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IPFlex',
  description: 'IPFlex专业提供企业级IP代理服务，覆盖全球200+国家和地区。',
  url: SITE.site,
  email: 'support@ipflex.ink',
  areaServed: ['CN', 'Worldwide'],
  knowsAbout: ['IP代理', '住宅代理', '数据中心代理', 'HTTP代理', 'SOCKS5代理', '跨境电商', '网页抓取']
})} />
)}

{shouldRenderMainSchema && <script type="application/ld+json" set:html={JSON.stringify(mainStructuredData)} />}
{shouldRenderProductSchema && <script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />}
{shouldRenderWebsiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />}
{shouldRenderServiceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />}
