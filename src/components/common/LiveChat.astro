---
const baseURL = import.meta.env.PUBLIC_LIBREDESK_BASE_URL?.trim().replace(/\/+$/, '');
const inboxID = import.meta.env.PUBLIC_LIBREDESK_INBOX_ID?.trim();
const isConfigured = Boolean(baseURL && inboxID);
---

{
  isConfigured && (
    <>
      <script define:vars={{ baseURL, inboxID }}>
        window.LibredeskSettings = {
          baseURL,
          inboxID,
        };
      </script>
      <script async src={`${baseURL}/widget.js`}></script>
    </>
  )
}
