---
// import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';
import {
  getImagesOptimized,
  astroAsseetsOptimizer,
  unpicOptimizer,
  isUnpicCompatible,
  type ImageProps,
} from '~/utils/images-optimization';

type Props = ImageProps;
type ImageType = {
  src: string;
  attributes: HTMLAttributes<'img'>;
};

const props = Astro.props;
const { lang = 'zh' } = Astro.params;

// 如果没有提供alt属性，则添加智能生成的alt文本
import { generateOptimizedAlt } from '~/utils/seo-optimization';

if (props.alt === undefined || props.alt === null) {
  // 从图片路径提取有意义的信息
  const imagePath = typeof props.src === 'string' ? props.src : '';
  const imageName = imagePath.split('/').pop()?.split('.')[0];
  const pageUrl = Astro.url.pathname;
  
  let pageName = '';
  let productName = '';
  
  // 根据页面路径提取产品信息
  if (pageUrl.includes('static-residential-proxy')) {
    productName = lang === 'zh' ? '静态住宅代理' : 'Static Residential Proxy';
  } else if (pageUrl.includes('dynamic-residential-proxy')) {
    productName = lang === 'zh' ? '动态住宅代理' : 'Dynamic Residential Proxy';
  } else if (pageUrl.includes('static-datacenter-proxy')) {
    productName = lang === 'zh' ? '数据中心代理' : 'Datacenter Proxy';
  } else if (pageUrl.includes('pricing')) {
    pageName = lang === 'zh' ? '定价方案' : 'Pricing Plans';
  } else if (pageUrl.includes('blog')) {
    pageName = lang === 'zh' ? '技术博客' : 'Technical Blog';
  }
  
  props.alt = generateOptimizedAlt({
    imageName,
    pageName,
    productName,
    lang
  });
}

if (typeof props.width === 'string') {
  props.width = parseInt(props.width);
}

if (typeof props.height === 'string') {
  props.height = parseInt(props.height);
}

// 优化图片加载策略
const isAboveFold = props.fetchpriority === 'high' || props.loading === 'eager';
if (isAboveFold) {
  props.fetchpriority = 'high';
  props.loading = 'eager';
} else {
  if (!props.loading) {
    props.loading = 'lazy';
  }
  if (!props.fetchpriority) {
    props.fetchpriority = 'auto';
  }
}

if (!props.decoding) {
  props.decoding = 'async';
}

// 优先使用AVIF格式，回退到WebP（如果没有指定格式）
if (!props.format && typeof props.src === 'string' && !props.src.includes('.svg')) {
  // 对于关键图片使用AVIF，其他使用WebP以平衡质量和兼容性
  props.format = isAboveFold ? 'avif' : 'webp';
}

const _image = await findImage(props.src);

let image: ImageType | undefined = undefined;

if (
  typeof _image === 'string' &&
  (_image.startsWith('http://') || _image.startsWith('https://')) &&
  isUnpicCompatible(_image)
) {
  image = await getImagesOptimized(_image, props, unpicOptimizer);
} else if (_image) {
  image = await getImagesOptimized(_image, props, astroAsseetsOptimizer);
}
---

{
  !image ? (
    <Fragment />
  ) : (
    <img
      src={image.src}
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      fetchpriority={props.fetchpriority}
      {...image.attributes}
    />
  )
}
