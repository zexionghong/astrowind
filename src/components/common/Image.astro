---
// import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';
import {
  getImagesOptimized,
  astroAsseetsOptimizer,
  unpicOptimizer,
  isUnpicCompatible,
  type ImageProps,
} from '~/utils/images-optimization';

type Props = ImageProps;
type ImageType = {
  src: string;
  attributes: HTMLAttributes<'img'>;
};

const props = Astro.props;
const { lang = 'zh' } = Astro.params;

// 如果没有提供alt属性，则添加默认的alt文本
if (props.alt === undefined || props.alt === null) {
  props.alt = lang === 'zh'
    ? 'IPFlex代理IP服务 - 全球优质IP代理资源提供商'
    : 'IPFlex Proxy IP Service - Global Quality IP Resource Provider';
}

if (typeof props.width === 'string') {
  props.width = parseInt(props.width);
}

if (typeof props.height === 'string') {
  props.height = parseInt(props.height);
}

// 优化图片加载策略
const isAboveFold = props.fetchpriority === 'high' || props.loading === 'eager';
if (isAboveFold) {
  props.fetchpriority = 'high';
  props.loading = 'eager';
} else {
  if (!props.loading) {
    props.loading = 'lazy';
  }
  if (!props.fetchpriority) {
    props.fetchpriority = 'auto';
  }
}

if (!props.decoding) {
  props.decoding = 'async';
}

// 优先使用WebP格式（如果没有指定格式）
if (!props.format && typeof props.src === 'string' && !props.src.includes('.svg')) {
  props.format = 'webp';
}

const _image = await findImage(props.src);

let image: ImageType | undefined = undefined;

if (
  typeof _image === 'string' &&
  (_image.startsWith('http://') || _image.startsWith('https://')) &&
  isUnpicCompatible(_image)
) {
  image = await getImagesOptimized(_image, props, unpicOptimizer);
} else if (_image) {
  image = await getImagesOptimized(_image, props, astroAsseetsOptimizer);
}
---

{
  !image ? (
    <Fragment />
  ) : (
    <img
      src={image.src}
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      fetchpriority={props.fetchpriority}
      {...image.attributes}
    />
  )
}
