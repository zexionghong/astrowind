---
interface Props {
  lang?: string;
}

const { lang = 'zh' } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="friend-links-container">
  <!-- 加载状态 -->
  <div class="col-span-full text-center py-4">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-500 border-t-transparent"></div>
  </div>
</div>

<script>
  async function fetchFriendLinks() {
    try {
      const response = await fetch('https://api.ipflex.ink/api/links');
      if (!response.ok) {
        throw new Error('Failed to fetch friend links');
      }
      const data = await response.json();
      return data.data.links;
    } catch (error) {
      console.error('Error fetching friend links:', error);
      return [];
    }
  }

  async function renderFriendLinks() {
    const container = document.getElementById('friend-links-container');
    if (!container) return;

    const links = await fetchFriendLinks();
    const lang = document.documentElement.lang || 'zh';

    container.innerHTML = links.map(link => `
      <a 
        href="${link.url}" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group flex items-center p-4 border border-gray-200 dark:border-slate-800 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 transition duration-300"
      >
        <div class="w-[50px] h-[50px] flex-shrink-0 flex items-center justify-center overflow-hidden">
          <img 
            src="${link.logo}" 
            alt="${link.name}" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="ml-4 flex-grow min-w-0">
          <div>
            <h3 class="font-medium text-blue-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
              ${lang === 'zh' ? link.name : link.en_name}
            </h3>
            <div class="text-xs text-gray-500 dark:text-gray-400 truncate">
              ${lang === 'zh' ? link.en_name : link.name}
            </div>
          </div>
          <p class="text-xs text-blue-700/80 dark:text-gray-400 mt-1 line-clamp-2">
            ${lang === 'zh' ? link.description : link.en_description}
          </p>
        </div>
      </a>
    `).join('');
  }

  // 页面加载完成后获取友链数据
  document.addEventListener('DOMContentLoaded', renderFriendLinks);
</script> 