---
import { readFile } from 'node:fs/promises';

interface Props {
  lang?: string;
}

interface FriendLink {
  name?: string;
  en_name?: string;
  url?: string;
  logo?: string;
  description?: string;
  en_description?: string;
}

const { lang = 'zh' } = Astro.props;
const friendLinksUrl = new URL('../../public/friend-links.json', import.meta.url);

async function loadFriendLinks(): Promise<FriendLink[]> {
  try {
    const file = await readFile(friendLinksUrl, 'utf8');
    const data = JSON.parse(file);
    return Array.isArray(data?.links)
      ? data.links.filter((link: FriendLink) => link.url && (link.name || link.en_name))
      : [];
  } catch (error) {
    console.warn('Failed to read public/friend-links.json:', error);
    return [];
  }
}

const links = await loadFriendLinks();
const isZh = lang === 'zh';
---

{
  links.length > 0 && (
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {links.map((link) => {
        const name = isZh ? link.name : link.en_name || link.name;
        const secondaryName = isZh ? link.en_name : link.name;
        const description = isZh ? link.description : link.en_description || link.description;

        return (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center rounded-lg border border-gray-200 p-4 transition duration-300 hover:bg-blue-50 dark:border-slate-800 dark:hover:bg-slate-800"
          >
            <div class="flex h-[50px] w-[50px] flex-shrink-0 items-center justify-center overflow-hidden">
              {link.logo && (
                <img
                  src={link.logo}
                  alt={
                    isZh
                      ? `${link.name || name} - IPFlex代理IP服务合作伙伴`
                      : `${link.en_name || name} - IPFlex Proxy IP Service Partner`
                  }
                  class="h-full w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div class="ml-4 min-w-0 flex-grow">
              <div>
                <h3 class="truncate font-medium text-blue-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                  {name}
                </h3>
                {secondaryName && (
                  <div class="truncate text-xs text-gray-500 dark:text-gray-400">
                    {secondaryName}
                  </div>
                )}
              </div>
              {description && (
                <p class="mt-1 line-clamp-2 text-xs text-blue-700/80 dark:text-gray-400">
                  {description}
                </p>
              )}
            </div>
          </a>
        );
      })}
    </div>
  )
}
