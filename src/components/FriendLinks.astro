---
interface Props {
  lang?: string;
}

const { lang = 'zh' } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="friend-links-container" data-current-lang={lang}>
  <!-- 加载状态 -->

  <div class="col-span-full text-center py-4">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-500 border-t-transparent"></div>
  </div>
</div>

<script>
  // 友链数据类型定义
  interface FriendLink {
    name: string;
    en_name: string;
    url: string;
    logo: string;
    description: string;
    en_description: string;
  }

  // 缓存配置
  const CACHE_KEY = 'friend_links_cache';
  const CACHE_EXPIRY = 10 * 60 * 1000; // 10分钟过期

  // 缓存数据结构
  interface CacheData {
    data: FriendLink[];
    timestamp: number;
  }

  // 获取缓存数据
  function getCachedData(): CacheData | null {
    const cached = localStorage.getItem(CACHE_KEY);
    if (!cached) return null;
    
    const cacheData: CacheData = JSON.parse(cached);
    const now = Date.now();
    
    if (now - cacheData.timestamp > CACHE_EXPIRY) {
      localStorage.removeItem(CACHE_KEY);
      return null;
    }
    
    return cacheData;
  }

  // 设置缓存数据
  function setCachedData(data: FriendLink[]) {
    const cacheData: CacheData = {
      data,
      timestamp: Date.now()
    };
    localStorage.setItem(CACHE_KEY, JSON.stringify(cacheData));
  }

  async function fetchFriendLinks(): Promise<FriendLink[]> {
    try {
      // 检查缓存
      const cached = getCachedData();
      if (cached) {
        return cached.data;
      }

      const response = await fetch('https://api.ipflex.ink/api/links');
      if (!response.ok) {
        throw new Error('Failed to fetch friend links');
      }
      const data = await response.json();
      const links = data.data.links;
      
      // 设置缓存
      setCachedData(links);
      
      return links;
    } catch (error) {
      console.error('Error fetching friend links:', error);
      return [];
    }
  }

  async function renderFriendLinks() {
    const container = document.getElementById('friend-links-container');
    if (!container) return;

    const links = await fetchFriendLinks();
    const lang = (container.getAttribute('data-current-lang') || 'zh') as 'zh' | 'en';

    container.innerHTML = links.map(link => `
      <a 
        href="${link.url}" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group flex items-center p-4 border border-gray-200 dark:border-slate-800 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 transition duration-300"
      >
        <div class="w-[50px] h-[50px] flex-shrink-0 flex items-center justify-center overflow-hidden">
          <img 
            src="${link.logo}" 
            alt="${lang === 'zh' 
              ? `${link.name} - IPFlex代理IP服务合作伙伴` 
              : `${link.name} - IPFlex Proxy IP Service Partner`}" 
            class="w-full h-full object-contain"
          />
        </div>
        <div class="ml-4 flex-grow min-w-0">
          <div>
            <h3 class="font-medium text-blue-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
              ${lang === 'zh' ? link.name : link.en_name}
            </h3>
            <div class="text-xs text-gray-500 dark:text-gray-400 truncate">
              ${lang === 'zh' ? link.en_name : link.name}
            </div>
          </div>
          <p class="text-xs text-blue-700/80 dark:text-gray-400 mt-1 line-clamp-2">
            ${lang === 'zh' ? link.description : link.en_description}
          </p>
        </div>
      </a>
    `).join('');
  }

  // 监听语言变化
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'lang') {
        renderFriendLinks();
      }
    });
  });

  // 开始观察语言变化
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['lang']
  });

  // 页面加载完成后获取友链数据
  document.addEventListener('DOMContentLoaded', renderFriendLinks);
</script> 