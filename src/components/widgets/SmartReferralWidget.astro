---
interface Props {
  lang?: string;
}

const { lang = 'zh' } = Astro.props;
---

<!-- Smart Floating Referral Widget -->
<div id="smart-referral-widget" class="fixed bottom-6 right-6 z-50 hidden lg:block">
  <!-- Main Widget -->
  <div id="referral-widget-collapsed" class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-3 rounded-full shadow-lg cursor-pointer hover:shadow-xl transition-all duration-300 hover:scale-105">
    <div class="flex items-center space-x-2">
      <svg class="w-6 h-6 text-yellow-300" fill="currentColor" viewBox="0 0 20 20">
        <path d="M11 5H7a1 1 0 000 2h4a1 1 0 100-2zM7 9a1 1 0 000 2h4a1 1 0 100-2zM7 13a1 1 0 100 2h4a1 1 0 100-2z"></path>
      </svg>
      <span class="text-sm font-medium hidden xl:inline">
        {lang === 'zh' ? '立返10%佣金' : 'Instant 10% Back'}
      </span>
    </div>
  </div>

  <!-- Expanded Widget -->
  <div id="referral-widget-expanded" class="bg-white rounded-lg shadow-2xl p-4 w-80 hidden border border-gray-100">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-lg font-bold text-gray-900">
        {lang === 'zh' ? '🎉 推荐好友赚钱' : '🎉 Refer & Earn'}
      </h3>
      <button id="close-widget" class="text-gray-400 hover:text-gray-600 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
    
    <div class="text-sm text-gray-600 mb-4">
      {lang === 'zh' 
        ? '邀请好友注册充值代理服务，好友完成充值立即返现10%佣金！' 
        : 'Invite friends to register and recharge proxy services, get instant 10% cashback when they recharge!'
      }
    </div>

    <div class="flex items-center justify-between mb-4">
      <div class="text-center">
        <div class="text-2xl font-bold text-blue-600">10%</div>
        <div class="text-xs text-gray-500">{lang === 'zh' ? '最高佣金' : 'Max Commission'}</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-green-600">∞</div>
        <div class="text-xs text-gray-500">{lang === 'zh' ? '无限推荐' : 'Unlimited'}</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-purple-600">$0</div>
        <div class="text-xs text-gray-500">{lang === 'zh' ? '零门槛' : 'No Threshold'}</div>
      </div>
    </div>

    <div class="flex space-x-2">
      <button 
        onclick={`window.open('/${lang}/referral-program', '_blank')`}
        class="flex-1 bg-gradient-to-r from-blue-600 to-purple-600 text-white px-3 py-2 rounded text-sm font-medium hover:shadow-lg transition-all duration-300"
      >
        {lang === 'zh' ? '了解详情' : 'Learn More'}
      </button>
      <button 
        onclick="window.open('https://dashboard.ipflex.ink/register', '_blank')"
        class="flex-1 border border-blue-600 text-blue-600 px-3 py-2 rounded text-sm font-medium hover:bg-blue-50 transition-colors"
      >
        {lang === 'zh' ? '立即注册' : 'Register'}
      </button>
    </div>

    <div class="text-xs text-gray-400 mt-2 text-center">
      {lang === 'zh' ? '点击了解完整推荐计划详情' : 'Click to learn complete referral details'}
    </div>
  </div>
</div>

<!-- Mobile Referral Banner -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-gradient-to-r from-blue-600 to-purple-600 text-white p-3 shadow-lg">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <svg class="w-6 h-6 text-yellow-300" fill="currentColor" viewBox="0 0 20 20">
        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
      </svg>
      <div>
        <div class="font-semibold text-sm">
          {lang === 'zh' ? '推荐好友充值立返10%' : 'Refer Friends, Instant 10% Back'}
        </div>
        <div class="text-xs opacity-90">
          {lang === 'zh' ? '充值立返，无限推荐' : 'Instant cashback, unlimited referrals'}
        </div>
      </div>
    </div>
    <button 
      onclick={`window.open('/${lang}/referral-program', '_blank')`}
      class="bg-white text-blue-600 px-4 py-2 rounded text-sm font-semibold hover:bg-gray-100 transition-colors"
    >
      {lang === 'zh' ? '了解' : 'Learn'}
    </button>
  </div>
</div>

<script>
  // Smart widget interaction
  document.addEventListener('DOMContentLoaded', function() {
    const collapsedWidget = document.getElementById('referral-widget-collapsed');
    const expandedWidget = document.getElementById('referral-widget-expanded');
    const closeButton = document.getElementById('close-widget');
    
    if (collapsedWidget && expandedWidget && closeButton) {
      // Expand widget on click
      collapsedWidget.addEventListener('click', function() {
        collapsedWidget.classList.add('hidden');
        expandedWidget.classList.remove('hidden');
      });
      
      // Close expanded widget
      closeButton.addEventListener('click', function() {
        expandedWidget.classList.add('hidden');
        collapsedWidget.classList.remove('hidden');
      });
      
      // Auto-show widget after user stays for 30 seconds
      setTimeout(function() {
        if (!sessionStorage.getItem('referral-widget-shown')) {
          collapsedWidget.style.animation = 'pulse 2s infinite';
          sessionStorage.setItem('referral-widget-shown', 'true');
        }
      }, 30000);
    }
  });
</script>

<style>
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  /* 添加渐变动画 */
  #referral-widget-collapsed {
    background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 50%, #3B82F6 100%);
    background-size: 200% 200%;
    animation: gradientShift 3s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>