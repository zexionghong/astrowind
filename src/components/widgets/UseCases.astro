---
interface UseCase {
  icon?: string;
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  useCases?: Array<UseCase>;
  classes?: Record<string, string>;
}

const {
  title = '互联网服务提供商代理的使用案例',
  subtitle = '',
  useCases = [
    {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M9 12l2 2 4-4"></path></svg>',
      title: '广告验证',
      description: '确保您的广告能够正确展示给不同的受众。'
    },
    {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
      title: '市场研究',
      description: '在地域限制的网站上收集公共数据，以便进行数据驱动的决策。'
    },
    {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>',
      title: '电子商务',
      description: '从市场中提取公共数据，以提高竞争情报。'
    },
    {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>',
      title: '网络安全',
      description: '识别威胁、测试应用程序和监控网站，以控制风险并保护您的品牌。'
    }
  ],
  classes = {},
} = Astro.props;
---

<section class="py-16">
  
  <div class={`mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 ${classes?.container ?? ''}`}>
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">{title}</h2>
      {subtitle && <p class="text-xl text-gray-600 dark:text-slate-400">{subtitle}</p>}
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {useCases.map((useCase) => (
        <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <div class="mb-4 text-[#00E062] w-16 h-16 flex items-center justify-center">
            <Fragment set:html={useCase.icon} />
          </div>
          <h3 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">{useCase.title}</h3>
          <p class="text-gray-600 dark:text-slate-400">{useCase.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
