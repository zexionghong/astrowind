---
import { twMerge } from 'tailwind-merge';
import type { HTMLAttributes } from 'astro/types';

interface Item {
  title: string;
  amount: string;
}

interface Props extends HTMLAttributes<'section'> {
  title?: string;
  subtitle?: string;
  highlight?: string;
  items?: Item[];
  classes?: {
    container?: string;
    items?: string;
  };
  bg?: string;
}

const {
  title = '',
  subtitle = '',
  highlight = '',
  items = [],
  id,
  classes = {},
  bg = '',
} = Astro.props;

const {
  container: containerClass = '',
  items: itemsClass = '',
} = classes;

---
<section class="relative" {...id ? { id } : {}}>
  {
    bg && (
      <Fragment set:html={bg} />
    )
  }
  <div class={twMerge('relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default', containerClass)}>
    <div class="flex flex-col gap-8 md:gap-12">
      {(title || subtitle || highlight) && (
        <div class="mb-8 md:mx-auto md:mb-12 text-center">
          {highlight && (
            <p class="text-base font-semibold uppercase tracking-wide text-primary dark:text-blue-200">
              {highlight}
            </p>
          )}
          {title && (
            <h2 class="font-heading mb-4 font-bold tracking-tight text-2xl md:text-3xl text-heading">
              {title}
            </h2>
          )}
          {subtitle && (
            <p class="mx-auto max-w-3xl text-xl text-muted dark:text-slate-400">
              {subtitle}
            </p>
          )}
        </div>
      )}
      <div class={twMerge('grid grid-cols-2 md:grid-cols-4 gap-4 dark:text-white', itemsClass)}>
        {
          items.map(({ title, amount }) => (
            <div class="text-center relative">
              <div class="font-heading text-[2.6rem] font-bold lg:text-5xl xl:text-6xl text-white flex items-center justify-center gap-2">
                {amount}
                <span class="text-xl">↑</span>
              </div>
              <div class="relative">
                <div class="absolute left-1/2 -translate-x-1/2 w-12 h-[1px] bg-white/50 my-2"></div>
                <p class="text-sm font-medium uppercase tracking-widest text-white/80 lg:text-base pt-6">
                  {title}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .text-white span {
    animation: bounce 1s infinite;
  }
  
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-25%);
    }
  }
</style> 