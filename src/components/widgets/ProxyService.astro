---
import { findImage } from '~/utils/images/images';
interface Feature {
  title: string;
  bg: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  description: string;
  descriptionList: string[];
  features: Feature[];
  isEven?: boolean;
}


const { title, subtitle,  features,description="",descriptionList=[], isEven = false } = Astro.props;
---

<div class={`mx-auto px-4 sm:px-6 ${title ? 'py-12' : 'pb-12'} mb-12`}>
  <div class="max-w-7xl mx-auto">
    {title && 
      <div class="text-center mb-8">
        <h2 class="text-4xl font-bold text-primary">{title}</h2>
      </div>
    }
    {subtitle && 
      <div class="max-w-16xl mx-auto">
        <h2 class={`text-xl text-secondary mb-6 relative ${isEven ? 'text-right' : 'text-left'}`}>
          {subtitle}
          <span aria-hidden="true" class={`block absolute bottom-0 h-0.5 w-[300px] ${
            isEven 
              ? 'right-0 bg-gradient-to-l from-accent via-primary to-transparent' 
              : 'left-0 bg-gradient-to-r from-accent via-primary to-transparent'
          }`}></span>
        </h2>
      </div>
    }
    <div class="max-w-16xl mx-auto">
      <p class={`text-muted mb-12 text-sm ${isEven ? 'text-right' : 'text-left'}`}>
        {description?description:descriptionList.map((l) => (
          <span>{l}</span><br/>
        ))}
      </p>
    </div>
    <div class="grid grid-cols-4 gap-8">
      {features.map(async (feature, index) => {
        
        const bgUrl = await findImage(feature.bg);
        const src = bgUrl?.src;
        return (
        <div class="glass-card rounded-2xl p-12 flex items-end justify-start relative overflow-hidden h-32 cursor-pointer">
            {src && (
              <img
                src={src}
                alt={feature.title}
                width="320"
                height="128"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover opacity-80"
              />
            )}
            <span class={`absolute bottom-2 left-2 z-10 ${index % 2 === 1 ? 'text-white' : 'text-heading'}`}>{feature.title}</span>
        </div>
      )
      })}
    </div>
  </div>
</div> 
