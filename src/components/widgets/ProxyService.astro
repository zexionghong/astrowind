---
import { findImage } from '~/utils/images';
interface Feature {
  title: string;
  bg: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  description: string;
  descriptionList: string[];
  features: Feature[];
  isEven?: boolean;
}


const { title, subtitle,  features,description="",descriptionList=[], isEven = false } = Astro.props;
---

<div class={`mx-auto px-4 sm:px-6 ${title ? 'py-12' : 'pb-12'} mb-12`}>
  <div class="max-w-7xl mx-auto">
    {title && 
      <div class="text-center mb-8">
        <h2 class="text-4xl font-bold text-blue-600">{title}</h2>
      </div>
    }
    {subtitle && 
      <div class="max-w-16xl mx-auto">
        <h2 class={`text-xl text-blue-500 mb-6 relative ${isEven ? 'text-right' : 'text-left'}`}>
          {subtitle}
          <div class={`absolute bottom-0 h-0.5 w-[300px] ${
            isEven 
              ? 'right-0 bg-gradient-to-l from-purple-500 via-blue-500 to-transparent' 
              : 'left-0 bg-gradient-to-r from-purple-500 via-blue-500 to-transparent'
          }`}></div>
        </h2>
      </div>
    }
    <div class="max-w-16xl mx-auto">
      <p class={`text-gray-600 dark:text-gray-300 mb-12 text-sm ${isEven ? 'text-right' : 'text-left'}`}>
        {description?description:descriptionList.map((l) => (
          <span>{l}</span><br/>
        ))}
      </p>
    </div>
    <div class="grid grid-cols-4 gap-8">
      {features.map(async (feature, index) => {
        
        const bgUrl = await findImage(feature.bg);
        const src = bgUrl?.src;
        console.log(src)
        return (
        <div class="bg-blue-50/50 backdrop-blur-sm rounded-2xl p-12 flex items-end justify-start shadow-sm hover:translate-y-[-8px] transition-transform duration-300 ease-in-out hover:shadow-md relative overflow-hidden h-32" style={`background-image: url(${src}); background-size: cover; background-position: center;`}>
            <span class={`absolute bottom-2 left-2 ${index % 2 === 1 ? 'text-white' : 'text-gray-700 dark:text-gray-300'}`}>{feature.title}</span>
        </div>
      )
      })}
    </div>
  </div>
</div> 
