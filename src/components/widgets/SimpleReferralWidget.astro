---
interface Props {
  lang?: string;
}

const { lang = 'zh' } = Astro.props;
---

<!-- Simple Floating Referral Widget -->
<div class="fixed bottom-6 left-6 z-50 block">
  <div class="simple-referral-card text-white p-4 rounded-lg shadow-2xl border border-blue-300 max-w-sm hover:scale-105 transition-transform duration-300">
    <div class="flex items-center space-x-3">
      <div class="text-2xl">🎉</div>
      <div class="flex-1">
        <h3 class="font-bold text-sm">
          {lang === 'zh' ? '推荐好友返现' : 'Refer & Earn'}
        </h3>
        <p class="text-xs opacity-90">
          {lang === 'zh' ? '充值立即返现10%' : 'Instant 10% Cashback'}
        </p>
      </div>
      <a 
        href={`/${lang}/referral-program`}
        class="bg-white text-blue-600 px-3 py-2 rounded-md text-xs font-bold hover:bg-yellow-100 hover:text-blue-700 transition-colors shadow-md"
      >
        {lang === 'zh' ? '了解' : 'Learn'}
      </a>
    </div>
  </div>
</div>

<style>
  /* 静态渐变背景，移除任何动画效果 */
  .simple-referral-card {
    background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  }
</style>