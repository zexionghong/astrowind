---
import SimpleSteps from '~/components/widgets/SimpleSteps.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const { bg, lang } = Astro.props;
---

<WidgetWrapper
  containerClass="!pt-0 !py-0 !mt-0 !px-0"
>
  <div slot="bg" set:html={bg} />
  <SimpleSteps lang={lang} />
</WidgetWrapper>

