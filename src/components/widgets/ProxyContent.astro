---
import ProxyService from '~/components/widgets/ProxyService.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

interface Props {
  bg?: string;
  residentialProxy: {
    title: string;
    subtitle: string;
    description: string;
    descriptionList: string[];
    features: Array<{ title: string }>;
  };
  dynamicProxy: {
    subtitle: string;
    description: string;
    descriptionList: string[];
    features: Array<{ title: string }>;
  };
  dataCenterProxy: {
    title: string;
    subtitle: string;
    description: string;
    descriptionList: string[];
    features: Array<{ title: string }>;
  };
}

const { 
  bg,
  residentialProxy,
  dynamicProxy,
  dataCenterProxy
} = Astro.props;
---

<WidgetWrapper
  containerClass="!pt-0 !py-0 !mt-0 !px-0 !opacity-100"
>
  <div slot="bg" set:html={bg} />
  <div class="glass rounded-[50px] pb-8 relative z-10">
    <ProxyService
      title={residentialProxy.title}
      subtitle={residentialProxy.subtitle}
      description={residentialProxy.description}
      descriptionList={residentialProxy.descriptionList}
      features={residentialProxy.features}
    />

    <ProxyService
      subtitle={dynamicProxy.subtitle}
      description={dynamicProxy.description}
      descriptionList={dynamicProxy.descriptionList}
      features={dynamicProxy.features}
      isEven={true}
    />
  </div>
  <br />
  <div class="glass rounded-[50px] pb-8 relative z-10">
    <ProxyService
      title={dataCenterProxy.title}
      subtitle={dataCenterProxy.subtitle}
      description={dataCenterProxy.description}
      descriptionList={dataCenterProxy.descriptionList}
      features={dataCenterProxy.features}
    />
  </div>
</WidgetWrapper>

<!-- Content Widget **************** -->
