---
import { twMerge } from 'tailwind-merge';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonHref: string;
  classes?: {
    container?: string;
    title?: string;
    subtitle?: string;
    button?: string;
  };
  bg?: string;
  id?: string;
}

const {
  title,
  subtitle,
  buttonText,
  buttonHref,
  classes = {},
  bg = '',
  id,
} = Astro.props;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
  button: buttonClass = '',
} = classes;
---

<section class="relative min-h-[200px]" {...id ? { id } : {}}>
  {
    bg && (
      <Fragment set:html={bg} />
    )
  }
  <div class={twMerge('relative z-10 mx-auto max-w-xl px-4 md:px-6 pt-12 md:pt-16 lg:pt-10 text-default text-center', containerClass)}>
    <div class="glass-container rounded-t-3xl p-6 md:p-8 lg:p-10 relative overflow-hidden">
      <div class="relative z-10">
        <h1 class={twMerge('text-4xl md:text-4xl lg:text-4xl font-bold text-white mb-6', titleClass)}>
          {title}
        </h1>
        <p class={twMerge('text-sm md:text-sm text-white mb-8 whitespace-pre-line', subtitleClass)}>
          {subtitle}
        </p>
        <a
          href={buttonHref}
          class={twMerge('inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 px-10 rounded-full transition-all duration-300 hover:shadow-lg hover:scale-105', buttonClass)}
        >
          {buttonText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .glass-container {
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    isolation: isolate;
  }

  .glass-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
    border-radius: inherit;
    z-index: -1;
  }

  .glass-container > * {
    isolation: isolate;
  }
</style> 