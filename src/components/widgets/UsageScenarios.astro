---
import { twMerge } from 'tailwind-merge';
import type { HTMLAttributes } from 'astro/types';

interface Item {
  title: string;
  description: string;
  icon?: string;
}

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle: string;
  items: Item[];
  classes?: {
    container?: string;
    title?: string;
    subtitle?: string;
    items?: string;
  };
  bg?: string;
  id?: string;
}

const {
  title,
  subtitle,
  items,
  classes = {},
  bg = '',
  id,
} = Astro.props;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
  items: itemsClass = '',
} = classes;
---

<div class="bg-white rounded-3xl shadow-xl p-6 md:p-8 lg:p-10">
  <section class="relative min-h-[400px]" {...id ? { id } : {}}>
    {
      bg && (
        <Fragment set:html={bg} />
      )
    }
    <div class={twMerge('relative z-10 mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default', containerClass)}>
      <div class="mb-8 md:mx-auto md:mb-12 text-center">
        <h2 class={twMerge('text-3xl md:text-4xl font-bold mb-4 text-gray-900', titleClass)}>
          {title}
        </h2>
        <p class={twMerge('text-xl text-gray-600', subtitleClass)}>
          {subtitle}
        </p>
      </div>
      <div class={twMerge('grid grid-cols-1 md:grid-cols-3 gap-6', itemsClass)}>
        {
          items.map(({ title, description, icon }) => (
            <div class="bg-gray-50 rounded-2xl p-6 shadow-md hover:shadow-lg transition-all duration-300 hover:scale-[1.02]">
              <div class="flex items-start">
                {/* {icon && <span class="text-3xl mr-4">{icon}</span>} */}
                <div>
                  <h3 class="text-xl font-semibold mb-2 text-gray-900">{title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  .backdrop-blur-md {
    backdrop-filter: blur(12px);
  }
</style> 