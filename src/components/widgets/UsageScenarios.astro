---
import { twMerge } from 'tailwind-merge';
import type { HTMLAttributes } from 'astro/types';

interface Item {
  title: string;
  description: string;
  icon?: string;
}

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle: string;
  items: Item[];
  classes?: {
    container?: string;
    title?: string;
    subtitle?: string;
    items?: string;
  };
  bg?: string;
  id?: string;
}

const {
  title,
  subtitle,
  items,
  classes = {},
  bg = '',
  id,
} = Astro.props;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
  items: itemsClass = '',
} = classes;
---

<section class="relative min-h-[400px]" {...id ? { id } : {}}>
  {
    bg && (
      <Fragment set:html={bg} />
    )
  }
  <div class={twMerge('relative z-10 mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default', containerClass)}>
    <div class="mb-8 md:mx-auto md:mb-12 text-center">
      <h2 class={twMerge('text-3xl md:text-4xl font-bold mb-4 text-white', titleClass)}>
        {title}
      </h2>
      <p class={twMerge('text-xl text-white/80', subtitleClass)}>
        {subtitle}
      </p>
    </div>
    <div class={twMerge('grid grid-cols-1 md:grid-cols-3 gap-6', itemsClass)}>
      {
        items.map(({ title, description, icon }) => (
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] hover:bg-white/20">
            <div class="flex items-start">
              {icon && <span class="text-3xl mr-4">{icon}</span>}
              <div>
                <h3 class="text-xl font-semibold mb-2 text-white">{title}</h3>
                <p class="text-white/80 text-sm leading-relaxed">{description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .backdrop-blur-md {
    backdrop-filter: blur(12px);
  }
</style> 