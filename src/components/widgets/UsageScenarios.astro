---
import { twMerge } from 'tailwind-merge';
import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';

interface Item {
  title: string;
  description: string;
  icon?: string;
  backgroundImage?: string;
}

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle: string;
  items: Item[];
  classes?: {
    container?: string;
    title?: string;
    subtitle?: string;
    items?: string;
  };
  bg?: string;
  id?: string;
}

const {
  title,
  subtitle,
  items,
  classes = {},
  bg = '',
  id,
} = Astro.props;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
  items: itemsClass = '',
} = classes;
---

<div class="bg-white rounded-3xl shadow-xl p-6 md:p-8 lg:p-10">
  <section class="relative min-h-[400px]" {...id ? { id } : {}}>
    {
      bg && (
        <Fragment set:html={bg} />
      )
    }
    <div class={twMerge('relative z-10 mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default', containerClass)}>
      <div class="mb-8 md:mx-auto md:mb-12 text-center">
        <h2 class={twMerge('text-3xl md:text-4xl font-bold mb-4 text-gray-900', titleClass)}>
          {title}
        </h2>
        <p class={twMerge('text-xl text-gray-600', subtitleClass)}>
          {subtitle}
        </p>
      </div>
      <div class={twMerge('grid grid-cols-1 md:grid-cols-3 gap-6', itemsClass)}>
        {
          items.map(async ({ title, description, backgroundImage }) => 
        {
          const imageUrl = await findImage(backgroundImage);
          return (
            <div class="rounded-2xl p-5 md:p-10 shadow-md hover:shadow-lg transition-all duration-300 hover:scale-[1.02] relative overflow-hidden bg-gradient-to-br from-white to-white/50 min-h-[260px]">
              {imageUrl && (
                <div 
                  class={`absolute inset-0 w-full h-full`}
                >
                  <img 
                    src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src} 
                    class="w-full h-full object-cover opacity-90"
                    alt={title}
                  />
                </div>
              )}
              <div class="flex items-start relative z-10">
                {/* {icon && <span class="text-3xl mr-4">{icon}</span>} */}
                <div class="space-y-4">
                  <h3 class="text-2xl font-semibold text-gray-900">{title}</h3>
                  <p class="text-gray-600 text-base leading-relaxed">{description}</p>
                </div>
              </div>
            </div>
          )
        })
        }
      </div>
    </div>
  </section>
</div>

<style>
  .backdrop-blur-md {
    backdrop-filter: blur(12px);
  }
</style> 