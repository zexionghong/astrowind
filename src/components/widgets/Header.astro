---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import LanguagePicker from '~/components/LanguagePicker.astro';

import { getHomePermalinkEn, getHomePermalinkZh } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import { getHeaderData } from '~/navigation';

interface CallToAction {
  text?: string;
  href?: string;
  target?: string;
  color?: string;
}

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  links?: Array<Link>;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  // links = [],
  // actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const { lang = 'zh' } = Astro.params;
const homePermalink = lang === 'zh' ? getHomePermalinkZh() : getHomePermalinkEn();
const headerData = getHeaderData(lang);
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out bg-white dark:bg-white',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 bg-white dark:bg-white"></div>
  <div
    class:list={[
      'relative text-default px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={homePermalink}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <!-- 移动端语言切换和登录注册按钮 -->
        <div class="mobile-header-actions flex items-center mr-2">
          <LanguagePicker />
          {
            headerData.actions?.length ? (
              <div class="flex ml-2">
                {headerData.actions.map((btnProps) => (
                  <div class="relative inline-block">
                    <Button {...btnProps} class="ml-1 py-1.5 px-3 font-semibold shadow-none text-xs w-auto" />
                    {/* 移动端不显示促销标签，避免布局混乱 */}
                  </div>
                ))}
              </div>
            ) : (
              ''
            )
          }
        </div>
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          headerData.links.map((link: any) => {
            const { text, href, links } = link;
            return (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                    >
                      {text}{' '}
                      <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                    </button>
                    <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded-lg md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/95 md:min-w-[320px] drop-shadow-xl border border-gray-200/50">
                      {links.map(({ text: text2, href: href2, icon, description, badge, links: subLinks }) => (
                        subLinks ? (
                          subLinks.map(({ text: subText, href: subHref }) => (
                            <li>
                              <a
                                class:list={[
                                  'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                                  { 'aw-link-active': subHref === currentPath },
                                ]}
                                href={subHref || '#'}
                                {...(subHref && subHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                              >
                                {subText}
                              </a>
                            </li>
                          ))
                        ) : (
                          <li class="relative">
                            <a
                              class:list={[
                                'group flex items-start p-4 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200',
                                { 'aw-link-active': href2 === currentPath },
                              ]}
                              href={href2 || '#'}
                              {...(href2 && href2.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                            >
                              {icon && (
                                <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3 group-hover:bg-blue-200 transition-colors duration-200">
                                  <Icon name={icon} class="w-5 h-5 text-blue-600" />
                                </div>
                              )}
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center">
                                  <p class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-blue-600 transition-colors duration-200">
                                    {text2}
                                  </p>
                                  {badge && (
                                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                      {badge}
                                    </span>
                                  )}
                                </div>
                                {description && (
                                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
                                    {description}
                                  </p>
                                )}
                              </div>
                            </a>
                          </li>
                        )
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href || '#'}
                    {...(href && href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {text}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'desktop-header-actions hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          <LanguagePicker />
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          headerData.actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {headerData.actions.map((btnProps, index) => (
                <div class="relative inline-block">
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                  {/* 为注册按钮添加促销标签 */}
                  {index === 0 && (btnProps.text === '注册' || btnProps.text === 'Sign Up') && (
                    <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full whitespace-nowrap transform rotate-12 shadow-lg">
                      {btnProps.text === '注册' ? '注册就送￥15' : 'Get ¥15 Free'}
                    </span>
                  )}
                </div>
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>
