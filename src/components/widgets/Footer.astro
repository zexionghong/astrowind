---
import { Icon } from 'astro-icon/components';
import { getFooterData } from '~/navigation';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

interface FriendLink {
  name: string;
  nameCn: string;
  nameEn: string;
  logo: string;
  description: string;
  href: string;
}

interface Props {
  links?: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  friendLinks?: Array<FriendLink>;
  theme?: string;
  footNote?: string;
  lang?: string;
}

const { theme = 'light', lang = 'zh' } = Astro.props;

const footerData = getFooterData(lang);
const links = footerData.links;
const socialLinks = footerData.socialLinks;
const friendLinks = footerData.friendLinks;
const footNote = footerData.footNote;
---

<!-- 友链区域 -->
<section class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="py-8 md:py-12">
      <h2 class="text-2xl font-bold text-blue-900 dark:text-white mb-8 text-center">
        {lang === 'zh' ? '友情链接' : 'Friend Links'}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          friendLinks?.map((link) => (
            <a 
              href={link.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group flex items-center p-4 border border-gray-200 dark:border-slate-800 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 transition duration-300"
            >
              <div class="w-[50px] h-[50px] flex-shrink-0 flex items-center justify-center">
                <img src={`/images/friends/${link.logo}`} alt={link.name} class="max-w-full max-h-full" />
              </div>
              <div class="ml-4 flex-grow min-w-0">
                <div>
                  <h3 class="font-medium text-blue-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                    {lang === 'zh' ? link.nameCn : link.nameEn}
                  </h3>
                  <div class="text-xs text-gray-500 dark:text-gray-400 truncate">
                    {lang === 'zh' ? link.nameEn : link.nameCn}
                  </div>
                </div>
                <p class="text-xs text-blue-700/80 dark:text-gray-400 mt-1 line-clamp-2">{link.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 py-8 md:py-12">
      <div class="col-span-2 md:col-span-5 lg:col-span-2 lg:pr-8">
        <div class="mb-4">
          <a class="inline-flex items-center gap-3 font-bold text-xl text-blue-900 dark:text-white" href={`/${lang}`}>
            <Logo />
          </a>
        </div>
        <div class="text-sm text-blue-700/80 dark:text-gray-400 mb-6 max-w-md">
          {lang === 'zh' ? '专业的IP代理服务提供商，为您提供优质的代理服务' : 'Professional proxy service provider offering high-quality proxy services'}
        </div>
        {
          socialLinks?.length ? (
            <div class="flex gap-3">
              {socialLinks.map(({ ariaLabel, href, icon }) => (
                <a
                  class="text-blue-600 dark:text-gray-400 hover:bg-blue-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-blue-100 dark:focus:ring-gray-700 rounded-lg p-2.5 inline-flex items-center text-sm"
                  aria-label={ariaLabel}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              ))}
            </div>
          ) : null
        }
      </div>
      <div class="col-span-2 md:col-span-5 lg:col-span-3">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            links.map(({ title, links }) => (
              <div>
                <div class="font-semibold text-blue-900 dark:text-gray-300 mb-3">{title}</div>
                {links && Array.isArray(links) && links.length > 0 && (
                  <ul class="text-sm">
                    {links.map(({ text, href }) => (
                      <li class="mb-2">
                        <a
                          class="text-blue-700/80 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white transition duration-150 ease-in-out"
                          href={href}
                        >
                          <Fragment set:html={text} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="text-sm text-center py-6 border-t border-blue-100 dark:border-gray-800 text-blue-700/80 dark:text-slate-400">
      <Fragment set:html={footNote} />
    </div>
  </div>
</footer>
