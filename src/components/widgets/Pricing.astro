---
import type { PriceCardProps } from '../common/PriceCard.astro';
import PriceCard from '../common/PriceCard.astro';
import { Image } from 'astro:assets';
import { findImage } from '~/utils/images';
import bg from '~/assets/images/bg/pricing_bg.png'
export interface FeatureCardProps {
  title: string;
  subtitle: string;
  items: Array<{
    title: string;
    description: string;
    img: string;
  }>;
}

export interface Pricing {
  title?: string;
  subtitle?: string;
  prices?: Array<PriceCardProps>;
  id?: string;
  features?: FeatureCardProps;
}

const {
  title = '',
  subtitle = '',
  prices = [],
  id,
  features ,
} = Astro.props as Pricing;
---

<div class="w-full relative py-16 text-white overflow-x-hidden" id={id}>
  <Image
    src={bg}
    alt="pricing background"
    class="absolute inset-0 w-full h-full max-w-full object-cover pointer-events-none"
    width={1920}
    height={1080}
  />
  <div class="container mx-auto max-w-7xl px-4 relative z-10 overflow-x-hidden">
    <div class="text-center mb-32">
      <h1 class="text-4xl font-bold mb-2">{title}</h1>
      <p class="text-lg">{subtitle}</p>
    </div>

    
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 max-w-5xl mx-auto overflow-x-hidden">
      {prices && prices.map((price, index) => (
        <div class={index === 1 ? 'md:-mt-10' : ''}>
          <PriceCard {...price} index={index} />
        </div>
      ))}
    </div>
  </div>
</div>

<!-- 价格相关特性部分 -->

<div class="w-full bg-white py-16" id="pricing-features">
  
  <div class="container mx-auto max-w-7xl px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-blue-600 mb-2">{features.title}</h2>
      <p class="text-gray-600">{features.subtitle}</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {features && features.items.map(async (feature) => {
        const image = await findImage(feature.img);
        return (
        <div class="flex flex-col items-center text-center">
          <div class="p-4 rounded-lg mb-4">
            <Image 
              src={image} 
              alt={feature.title} 
              class="w-12 h-12"
              width={60}
              height={60}
            />
          </div>
          <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
          <p class="text-gray-600">{feature.description}</p>
        </div>
      )
      })}
    </div>
  </div>
</div>
