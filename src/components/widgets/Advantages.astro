---
interface Item {
  title: string;
  description: string;
  icon?: string;
  image?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  items?: Array<Item>;
  bg?: string;
}

const {
  title = '',
  subtitle = '',
  items = [],
  bg = ''
} = Astro.props;

const itemsArray = Array.isArray(items) ? items : [];
---

<section class="relative">
  <Fragment set:html={bg} />
  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="mb-16 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">{title}</h2>
      <span class="text-sm text-white">{subtitle}</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {itemsArray.map(({ title, description, icon, image }) => (
        <div class="bg-white rounded-2xl p-8 min-w-[380px]">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              {image ? (
                <img src={image} alt={title} class="w-20 h-20 object-contain" />
              ) : icon ? (
                <i class={`${icon} w-20 h-20 text-4xl text-blue-600`}></i>
              ) : null}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-2xl font-bold text-gray-900 mb-3">{title}</h3>
              <p class="text-gray-600 text-base leading-relaxed">{description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section> 