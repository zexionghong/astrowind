        href: 'https://ipflex.com',
        target: '_blank',
        // icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      IPFlex&nbsp;&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">{t('index.callToAction.title')}</span>
    </Fragment>

    <Fragment slot="subtitle">
      {t('index.callToAction.subtitle1')}
      <br class="hidden md:inline" />
      {t('index.callToAction.subtitle2')}
    </Fragment>
  </CallToAction>
