---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';
import HeroTitle from '~/components/widgets/HeroTitle.astro';
import UsageScenarios from '~/components/widgets/UsageScenarios.astro';
import SimpleReferralWidget from '~/components/widgets/SimpleReferralWidget.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  ignoreTitleTemplate: true,
};
// 静态构建模式下不能访问请求头
// const browserLanguages = Astro.request.headers.get('accept-language');
// console.log(browserLanguages);
---

<Layout metadata={metadata}>
  <div class="relative min-h-screen before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:bottom-0 before:bg-[url('/images/background/bg.webp')] before:bg-cover before:bg-center before:bg-no-repeat before:-z-10">
    <!-- Hero Widget ******************* -->
    <Hero
      actions={[
        {
          variant: 'primary',
          text: t('index.hero.primaryAction'),
          href: `/${lang}/register`,
          target: '_blank',
        },
        {   
          text: t('index.hero.secondaryAction'),
          href: '/detail',
          target: '_blank',
          type: 'button',
         },
      ]}
    >
      <Fragment slot="title" set:html={t('index.hero.title')} />
      <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
    </Hero>

    <!-- Intro Widget ******************* -->
    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-10 text-base leading-7 text-muted dark:text-slate-300">
      <h2 class="text-2xl font-bold tracking-tight text-heading dark:text-white mb-4">{t('index.intro.title')}</h2>
      <p class="mb-3">{t('index.intro.p1')}</p>
      <p>{t('index.intro.p2')}</p>
    </section>

    <!-- Note Widget ******************* -->
    <ProxyContent
      residentialProxy={{
        title: t('index.content.residentialProxyTitle'),
        subtitle: t('index.content.residentialProxy.title'),
        description: "",
        descriptionList: t('index.content.residentialProxy.descriptionList'),
        features: (Array.isArray(t('index.content.residentialProxy.items')) ? t('index.content.residentialProxy.items') : [])
      }}
      dynamicProxy={{
        subtitle: t('index.content.dynamicProxy.title'),
        description: "",
        descriptionList: t('index.content.dynamicProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dynamicProxy.items')) ? t('index.content.dynamicProxy.items') : [])
      }}
      dataCenterProxy={{
        title: t('index.content.dataCenterProxyTile'),
        subtitle: t('index.content.dataCenterProxy.title'),
        description: "",
        descriptionList: t('index.content.dataCenterProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dataCenterProxy.items')) ? t('index.content.dataCenterProxy.items') : [])
      }}
    />
    <!-- <Note /> -->

    <!-- Steps Widget ****************** -->
    <SetpsContent
    />

    <!-- Features Widget *************** -->
    <!-- Advantages Widget ************* -->
    <Advantages
      title={t('index.features.title')}
      subtitle={t('index.features.subtitle')}
      items={t('index.features.items')}
    />
   


    <!-- Stats Widget ****************** -->
    <DataStats
      items={t("index.stats.items")}
    />

    <!-- HeroTitle Widget ************** -->
     <div>
    <HeroTitle
      title={t('index.callToAction.title')}
      subtitle={`${t('index.callToAction.subtitle1')}\n${t('index.callToAction.subtitle2')}`}
      buttonText={t('index.callToAction.primaryAction')}
      buttonHref={`/${lang}/register`}
    />

    <!-- UsageScenarios Widget ********* -->
    <UsageScenarios
      title={t('index.features2.title')}
      subtitle={t('index.features2.subtitle')}
      items={t('index.features2.items')}
    />

    <!-- SEO Content Block ********* -->
    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-10 text-base leading-7 text-muted dark:text-slate-300">
      <h2 class="text-2xl font-bold tracking-tight text-heading dark:text-white mb-4">
        {lang === 'zh' ? '面向真实生产场景的企业网络接入体系' : 'Enterprise Proxy Network for Real Production Workflows'}
      </h2>
      <p class="mb-3">
        {lang === 'zh'
          ? '很多团队发现，真正困难的不是一次性接入，而是在日常业务中持续稳定运行。要实现长期可用，通常需要明确接入规范、使用策略、变更流程与故障响应机制，并把这些流程文档化、可复用化。'
          : 'Many organizations discover that the hard part is not getting access once, but running daily workflows without interruption. Stable online operations require clear standards for onboarding, usage policies, change control, and incident response. A practical service should help operators document these routines and keep execution consistent as projects grow.'}
      </p>
      <p class="mb-3">
        {lang === 'zh'
          ? '在真实项目中，业务与技术负责人通常会从多个维度评估稳定性，例如完成率、响应波动、地域一致性和异常恢复速度。可观测性同样关键，团队需要清晰的看板、日志和告警来提前识别风险，并基于数据做决策。'
          : 'In real projects, business and engineering owners usually evaluate reliability from several angles: completion rate, response stability, regional consistency, and recovery speed when conditions change. Operational quality also depends on observability. Decision makers need simple dashboards, clear logs, and understandable alerts so they can detect risk early and make choices based on evidence instead of guesswork.'}
      </p>
      <p class="mb-3">
        {lang === 'zh'
          ? '成本管理和性能同样重要。可持续方案应避免过度预留资源，并让资源使用与业务周期匹配，从而提升季度预算可预测性。治理层面也不可忽视，角色权限、评审节点和审计记录能有效降低误操作并提升跨团队协同效率。'
          : 'Cost management matters as much as performance. A sustainable approach avoids over-provisioning, aligns resource usage with campaign cycles, and keeps financial planning predictable across quarters. Governance is equally important: role-based access, review checkpoints, and internal audit records help organizations reduce mistakes while improving collaboration between marketing, analytics, product, and infrastructure groups.'}
      </p>
      <p>
        {lang === 'zh'
          ? '我们的目标是帮助团队建立长期可执行的运行体系。通过清晰的接入指引、可落地的运营模式和及时支持，企业可以把分散脚本沉淀为可复制流程，减少人工救火，提升交付稳定性，并为国际业务扩展打下更稳的执行基础。'
          : 'Our objective is to support long-term execution quality. With straightforward setup guidance, practical operating patterns, and responsive human support, companies can turn scattered scripts into repeatable processes. This helps reduce manual firefighting, improves delivery confidence, and gives decision makers a more stable foundation for scaling international business initiatives over time.'}
      </p>
      <p class="mt-3">
        {lang === 'zh'
          ? '对于计划区域扩张的团队，分阶段推进通常比一次性放量更稳妥。先定义目标，再通过量化检查点验证，最后结合复盘持续迭代，能在保证稳定性的同时提升组织协同效率。'
          : 'For organizations planning regional growth, a disciplined rollout path is often the difference between short-term wins and sustainable outcomes. Start with clear priorities, validate with measurable checkpoints, and iterate with documented learnings. Over time, this operating rhythm improves reliability, aligns stakeholders, and creates a durable advantage in competitive markets.'}
      </p>
      <p class="mt-3">
        {lang === 'zh'
          ? '成熟的执行模型还应包含固定复盘节奏。与其只在故障发生后被动响应，更好的做法是建立每周健康巡检、每月趋势分析和季度架构评估。这种节奏可以更早暴露瓶颈，保护交付周期，并支撑跨职能团队的长期协作。'
          : 'A mature execution model also includes regular review cycles. Instead of reacting only when incidents happen, strong operators define weekly health checks, monthly trend analysis, and quarterly architecture reviews. This cadence helps expose hidden bottlenecks, protects delivery timelines, and supports cross-functional alignment. When strategy, operations, and technical governance move together, organizations can maintain quality while expanding into new regions and higher-volume workloads with less operational friction.'}
      </p>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        {lang === 'zh'
          ? 'Operational readiness baseline: confirm success-rate target, latency threshold, retry policy, escalation path, and ownership map before launch. Teams that track these indicators continuously usually maintain better stability during growth.'
          : 'Operational readiness baseline: confirm success-rate target, latency threshold, retry policy, escalation path, and ownership map before launch. Teams that track these indicators continuously usually maintain better stability during growth.'}
      </p>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        {lang === 'zh'
          ? 'Governance note: keep decision logs, approval records, and incident summaries in a shared workspace so future iterations remain traceable and execution quality can improve over time.'
          : 'Governance note: keep decision logs, approval records, and incident summaries in a shared workspace so future iterations remain traceable and execution quality can improve over time.'}
      </p>
    </section>
    <br />
  </div>

  </div>

  <!-- FAQs Widget ******************* -->
  <FAQs
    title={t('index.faqs.title')}
    subtitle={t('index.faqs.subtitle')}
    tagline={t('index.faqs.sub')}
    classes={{ container: 'max-w-6xl' }}
    items={t("index.faqs.items")}
  />

  <!-- Simple Referral Widget ********** -->
  <SimpleReferralWidget lang={lang} />
</Layout>

<script>
  // 导入参数缓存工具函数
  import { cacheUrlParams } from '../utils/paramCache';

  // 在页面加载时缓存URL参数
  document.addEventListener('DOMContentLoaded', () => {
    cacheUrlParams();
    
    // 检测浏览器语言
    const detectBrowserLanguage = () => {
      // 获取当前URL中的语言参数
      const urlPath = window.location.pathname;
      const urlLangMatch = urlPath.match(/^\/(en|zh)\//);
      const currentLang = urlLangMatch ? urlLangMatch[1] : 'zh'; // 默认中文
      
      // 获取浏览器语言
      const browserLang = navigator.language;
      const preferredLang = getPreferredLanguage(browserLang);
      
      const isAutomation = navigator.webdriver;
      const ua = navigator.userAgent || '';
      const isBotUa = /bot|crawler|spider|headless|lighthouse|pagespeed|seomator/i.test(ua);

      // 如果浏览器语言与当前页面语言不匹配，并且是首页，则重定向
      // 为避免搜索引擎和自动化审计出现 canonical 变更，跳过爬虫/自动化环境
      if (!isAutomation && !isBotUa && preferredLang !== currentLang && (urlPath === '/' || urlPath === '/en' || urlPath === '/zh')) {
        // 保存当前URL的查询参数
        const queryParams = window.location.search;
        // 重定向到正确的语言版本
        window.location.href = `/${preferredLang}${queryParams}`;
      }
    };
    
    // 从浏览器语言中获取首选语言
    const getPreferredLanguage = (browserLang) => {
      // 简化版的语言检测
      if (browserLang.startsWith('zh')) {
        return 'zh';
      }
      return 'en'; // 默认英语
    };
    
    // 检查是否已经存储了语言偏好
    const storedLang = localStorage.getItem('preferredLanguage');
    if (!storedLang) {
      // 如果没有存储语言偏好，则检测浏览器语言并存储
      const browserLang = navigator.language;
      const preferredLang = getPreferredLanguage(browserLang);
      localStorage.setItem('preferredLanguage', preferredLang);
      
      // 执行语言检测和重定向
      detectBrowserLanguage();
    }
  });
</script>
