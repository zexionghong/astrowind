---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';
import HeroTitle from '~/components/widgets/HeroTitle.astro';
import UsageScenarios from '~/components/widgets/UsageScenarios.astro';
import SimpleReferralWidget from '~/components/widgets/SimpleReferralWidget.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  description: t('index.metadata.description'),
  ignoreTitleTemplate: true,
};
// 静态构建模式下不能访问请求头
// const browserLanguages = Astro.request.headers.get('accept-language');
// console.log(browserLanguages);
---

<Layout metadata={metadata}>
  <div class="relative min-h-screen before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:bottom-0 before:bg-[url('/images/background/bg.webp')] before:bg-cover before:bg-center before:bg-no-repeat before:-z-10">
    <!-- Hero Widget ******************* -->
    <Hero
      actions={[
        {
          variant: 'primary',
          text: t('index.hero.primaryAction'),
          href: `/${lang}/register`,
          target: '_blank',
        },
        {   
          text: t('index.hero.secondaryAction'),
          href: '/detail',
          target: '_blank',
          type: 'button',
         },
      ]}
    >
      <Fragment slot="title" set:html={t('index.hero.title')} />
      <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
    </Hero>

    <!-- Note Widget ******************* -->
    <ProxyContent
      residentialProxy={{
        title: t('index.content.residentialProxyTitle'),
        subtitle: t('index.content.residentialProxy.title'),
        description: "",
        descriptionList: t('index.content.residentialProxy.descriptionList'),
        features: (Array.isArray(t('index.content.residentialProxy.items')) ? t('index.content.residentialProxy.items') : [])
      }}
      dynamicProxy={{
        subtitle: t('index.content.dynamicProxy.title'),
        description: "",
        descriptionList: t('index.content.dynamicProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dynamicProxy.items')) ? t('index.content.dynamicProxy.items') : [])
      }}
      dataCenterProxy={{
        title: t('index.content.dataCenterProxyTile'),
        subtitle: t('index.content.dataCenterProxy.title'),
        description: "",
        descriptionList: t('index.content.dataCenterProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dataCenterProxy.items')) ? t('index.content.dataCenterProxy.items') : [])
      }}
    />
    <!-- <Note /> -->

    <!-- Steps Widget ****************** -->
    <SetpsContent
    />

    <!-- Features Widget *************** -->
    <!-- Advantages Widget ************* -->
    <Advantages
      title={t('index.features.title')}
      subtitle={t('index.features.subtitle')}
      items={t('index.features.items')}
    />
   


    <!-- Stats Widget ****************** -->
    <DataStats
      items={t("index.stats.items")}
    />

    <!-- HeroTitle Widget ************** -->
     <div>
    <HeroTitle
      title={t('index.callToAction.title')}
      subtitle={`${t('index.callToAction.subtitle1')}\n${t('index.callToAction.subtitle2')}`}
      buttonText={t('index.callToAction.primaryAction')}
      buttonHref={`/${lang}/register`}
    />

    <!-- UsageScenarios Widget ********* -->
    <UsageScenarios
      title={t('index.features2.title')}
      subtitle={t('index.features2.subtitle')}
      items={t('index.features2.items')}
    />

    <br />
  </div>

  </div>

  <!-- FAQs Widget ******************* -->
  <FAQs
    title={t('index.faqs.title')}
    subtitle={t('index.faqs.subtitle')}
    tagline={t('index.faqs.sub')}
    classes={{ container: 'max-w-6xl' }}
    items={t("index.faqs.items")}
  />

  <!-- Simple Referral Widget ********** -->
  <SimpleReferralWidget lang={lang} />
</Layout>

<script>
  // 导入参数缓存工具函数
  import { cacheUrlParams } from '../utils/paramCache';

  // 在页面加载时缓存URL参数
  document.addEventListener('DOMContentLoaded', () => {
    cacheUrlParams();
    
    // 检测浏览器语言
    const detectBrowserLanguage = () => {
      // 获取当前URL中的语言参数
      const urlPath = window.location.pathname;
      const urlLangMatch = urlPath.match(/^\/(en|zh)\//);
      const currentLang = urlLangMatch ? urlLangMatch[1] : 'zh'; // 默认中文
      
      // 获取浏览器语言
      const browserLang = navigator.language;
      const preferredLang = getPreferredLanguage(browserLang);
      
      const isAutomation = navigator.webdriver;
      const ua = navigator.userAgent || '';
      const isBotUa = /bot|crawler|spider|headless|lighthouse|pagespeed|seomator/i.test(ua);

      // 如果浏览器语言与当前页面语言不匹配，并且是首页，则重定向
      // 为避免搜索引擎和自动化审计出现 canonical 变更，跳过爬虫/自动化环境
      if (!isAutomation && !isBotUa && preferredLang !== currentLang && (urlPath === '/' || urlPath === '/en' || urlPath === '/zh')) {
        // 保存当前URL的查询参数
        const queryParams = window.location.search;
        // 重定向到正确的语言版本
        window.location.href = `/${preferredLang}${queryParams}`;
      }
    };
    
    // 从浏览器语言中获取首选语言
    const getPreferredLanguage = (browserLang) => {
      // 简化版的语言检测
      if (browserLang.startsWith('zh')) {
        return 'zh';
      }
      return 'en'; // 默认英语
    };
    
    // 检查是否已经存储了语言偏好
    const storedLang = localStorage.getItem('preferredLanguage');
    if (!storedLang) {
      // 如果没有存储语言偏好，则检测浏览器语言并存储
      const browserLang = navigator.language;
      const preferredLang = getPreferredLanguage(browserLang);
      localStorage.setItem('preferredLanguage', preferredLang);
      
      // 执行语言检测和重定向
      detectBrowserLanguage();
    }
  });
</script>
