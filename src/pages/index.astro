---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';
import HeroTitle from '~/components/widgets/HeroTitle.astro';
import UsageScenarios from '~/components/widgets/UsageScenarios.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  ignoreTitleTemplate: true,
};
console.log(t('index.hero.primaryAction'));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    actions={[
      {
        variant: 'primary',
        text: t('index.hero.primaryAction'),
        href: 'https://dashboard.ipflex.ink/register',
        target: '_blank',
        // icon: 'tabler:download',
      },
      {   
        text: t('index.hero.secondaryAction'),
        href: '/detail',
        target: '_blank',
        type: 'button',
       },
    ]}
  >
    <Fragment slot="title" set:html={t('index.hero.title')} />

    <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
  </Hero>



  <!-- Note Widget ******************* -->
<ProxyContent
  bg={`<div class="absolute inset-0" style="background-image: url('/images/background/2.png'); background-size: cover; background-position: center;"></div>`}
  residentialProxy={{
    title: t('index.content.residentialProxyTitle'),
    subtitle: t('index.content.residentialProxy.title'),
    description: "",
    descriptionList: [t('index.content.residentialProxy.description')],
    features: t('index.content.residentialProxy.items').map(item => ({ title: item }))
  }}
  dynamicProxy={{
    subtitle: t('index.content.dynamicProxy.title'),
    description: "",
    descriptionList: [t('index.content.dynamicProxy.description')],
    features: t('index.content.dynamicProxy.items').map(item => ({ title: item }))
  }}
  dataCenterProxy={{
    title: t('index.content.dataCenterProxyTile'),
    subtitle: t('index.content.dataCenterProxy.title'),
    description: "",
    descriptionList: [t('index.content.dataCenterProxy.description')],
    features: t('index.content.dataCenterProxy.items').map(item => ({ title: item }))
  }}
/>
  <!-- <Note /> -->

  <!-- Steps Widget ****************** -->
  <SetpsContent
  bg={`<div class="absolute inset-0" style="background-image: url('/images/background/3.png'); background-size: cover; background-position: center;"></div>`}
 />

  <!-- Features Widget *************** -->
  <!-- Advantages Widget ************* -->
  <Advantages
    title={t('index.features.title')}
    subtitle={t('index.features.subtitle')}
    items={t('index.features.items')}
  />
 


  <!-- Stats Widget ****************** -->
  <DataStats
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    items={t("index.stats.items")}
  />

  <!-- HeroTitle Widget ************** -->
  <HeroTitle
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    title={t('index.callToAction.title')}
    subtitle={`${t('index.callToAction.subtitle1')}\n${t('index.callToAction.subtitle2')}`}
    buttonText={t('index.callToAction.primaryAction')}
    buttonHref="https://dashboard.ipflex.ink/register"
  />

  <!-- UsageScenarios Widget ********* -->
  <UsageScenarios
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    title={t('index.features2.title')}
    subtitle={t('index.features2.subtitle')}
    items={t('index.features2.items')}
  />

  

  <!-- FAQs Widget ******************* -->

  <FAQs
    title={t('index.faqs.title')}
    subtitle={t('index.faqs.subtitle')}
    tagline={t('index.faqs.sub')}
    classes={{ container: 'max-w-6xl' }}
    items={t("index.faqs.items")}
  />

  
</Layout>
