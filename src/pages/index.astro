---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  ignoreTitleTemplate: true,
};
console.log(t('index.hero.primaryAction'));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    actions={[
      {
        variant: 'primary',
        text: t('index.hero.primaryAction'),
        href: 'https://dashboard.ipflex.ink/register',
        target: '_blank',
        // icon: 'tabler:download',
      },
      {   
        text: t('index.hero.secondaryAction'),
        href: '/detail',
        target: '_blank',
        type: 'button',
       },
    ]}
  >
    <Fragment slot="title" set:html={t('index.hero.title')} />

    <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
  </Hero>



  <!-- Note Widget ******************* -->
<ProxyContent
bg={`<div class="absolute inset-0" style="background-image: url('/images/background/2.png'); background-size: cover; background-position: center;"></div>`}
/>
  <!-- <Note /> -->

  <!-- Steps Widget ****************** -->
  <SetpsContent
  bg={`<div class="absolute inset-0" style="background-image: url('/images/background/3.png'); background-size: cover; background-position: center;"></div>`}
 />

  <!-- Features Widget *************** -->
  <!-- Advantages Widget ************* -->
  <Advantages
    title="IPFlex的优势"
    subtitle="我们提供市场上上最专业、最全面的IP代理服务。"
    items={[
      {
        title: '全球IP资源池',
        description: 'IPFLEX拥有广泛覆盖的全球IP资源池，遍布多个国家和地区，能够为您提供多样化的IP地址选择，开拓您的全球网络视野。',
        icon: 'tabler:world',
      },
      {
        title: '高效技术支持',
        description: 'IPFLEX提供全天候24/7的专业技术支持，无论您遇到任何问题技术团队都会迅速响应，确保您的体验处于巅峰状态。',
        icon: 'tabler:headset',
      },
      {
        title: '丰富的IP类型',
        description: 'IPFLEX为您提供多样化的IP类型选择，包括住宅代理、数据中心代理、静态代理、动态代理等，以满足不同业务场景的需求。',
        icon: 'tabler:list-details',
      },
      {
        title: '快速稳定的连接',
        description: '使用IPFLEX，您将享受卓越的网络连接，快速且稳定的连接让您的网络访问更加不卡顿不掉线，提升工作效率和用户体验。',
        icon: 'tabler:rocket',
      },
      {
        title: '无限带宽',
        description: 'IPFLEX为您提供无限制的带宽使用，彻底消除流量限制的束缚，让您在任何情况下都能享受超高速率和极低延迟的网络服务。',
        icon: 'tabler:infinity',
      },
      {
        title: '高级安全保障',
        description: 'IPFLEX提供顶级的安全保障措施，全面保护您的隐私和数据安全，确保您的信息安全无虞，安心使用我们的服务。',
        icon: 'tabler:shield-lock',
      },
    ]}
  />
 


  <!-- Stats Widget ****************** -->
  <DataStats
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    items={[
      { title: t('index.stats.items.0.title'), amount: t('index.stats.items.0.amount') },
      { title: t('index.stats.items.1.title'), amount: t('index.stats.items.1.amount') },
      { title: t('index.stats.items.2.title'), amount: t('index.stats.items.2.amount') },
      { title: t('index.stats.items.3.title'), amount: t('index.stats.items.3.amount') },
    ]}
  />


  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: t('index.callToAction.primaryAction'),
        href: 'https://ipflex.com',
        target: '_blank',
        // icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      IPFlex&nbsp;&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">{t('index.callToAction.title')}</span>
    </Fragment>

    <Fragment slot="subtitle">
      {t('index.callToAction.subtitle1')}
      <br class="hidden md:inline" />
      {t('index.callToAction.subtitle2')}
    </Fragment>
  </CallToAction>
