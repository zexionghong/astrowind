     alt: '步骤图片',
   }}
 />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title={t('index.features.title')}
    subtitle={t('index.features.subtitle')}
    items={[
      {
        title: t('index.features.items.0.title'),
