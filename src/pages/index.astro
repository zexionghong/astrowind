      },
      {
        title: t('index.features.items.5.title'),
        description:
          t('index.features.items.5.description'),
        icon: 'tabler:shield-lock',
      },
    ]}
  />

 


  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: t('index.stats.items.0.title'), amount: t('index.stats.items.0.amount') },
      { title: t('index.stats.items.1.title'), amount: t('index.stats.items.1.amount') },
      { title: t('index.stats.items.2.title'), amount: t('index.stats.items.2.amount') },
      { title: t('index.stats.items.3.title'), amount: t('index.stats.items.3.amount') },
    ]}
  />


  <!-- CallToAction Widget *********** -->

