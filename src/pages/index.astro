---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
// import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/utils/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  ignoreTitleTemplate: true,
};
console.log(t('index.hero.primaryAction'));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    bg={`<div class="absolute inset-0" style="background-image: url('/images/background/1.png'); background-size: cover; background-position: center;"></div>`}
    actions={[
      {
        variant: 'primary',
        text: t('index.hero.primaryAction'),
        href: 'https://dashboard.ipflex.ink/register',
        target: '_blank',
        // icon: 'tabler:download',
      },
      {   
        text: t('index.hero.secondaryAction'),
        href: '/detail',
        target: '_blank',
        type: 'button',
       },
    ]}
  >
    <Fragment slot="title" set:html={t('index.hero.title')} />

    <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- <Note /> -->


  <Content
    isReversed
    title={t('index.content.residentialProxyTitle')}
    items={[
      {
        title:
          t('index.content.residentialProxy.items.0'),
      },
      {
        title:
          t('index.content.residentialProxy.items.1'),
      },
      {
        title: t('index.content.residentialProxy.items.2'),
      },
      {
        title: t('index.content.residentialProxy.items.3'),
      },
    ]}
    image={{
      src: '~/assets/images/proxy1.png',
      alt: '服务内容图片',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{t('index.content.residentialProxy.title')}</h3>
      {t('index.content.residentialProxy.description')}
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[{title: t('index.content.dynamicProxy.items.0')},{title: t('index.content.dynamicProxy.items.1')},{title: t('index.content.dynamicProxy.items.2')},{title: t('index.content.dynamicProxy.items.3')}]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: '灵活定制图片',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{t('index.content.dynamicProxy.title')}</h3>
      {t('index.content.dynamicProxy.description')}
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    title={t('index.content.dataCenterProxyTile')}
    items={[
      {title: t('index.content.dataCenterProxy.items.0')},
      {title: t('index.content.dataCenterProxy.items.1')},
      {title: t('index.content.dataCenterProxy.items.2')},
      {title: t('index.content.dataCenterProxy.items.3')},
