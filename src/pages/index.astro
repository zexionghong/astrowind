    </Fragment>
  </Content>


   <!-- Steps Widget ****************** -->

   <Steps
   title={t('index.steps.title')}
   items={[
     {
       title: t('index.steps.items.0.title'),
       description:
         t('index.steps.items.0.description'),
       icon: 'tabler:package',
     },
