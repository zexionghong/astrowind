---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'ipflex — 专业的IP代理服务提供商',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '开始试用',
        href: 'https://ipflex.com',
        target: '_blank',
        // icon: 'tabler:download',
      },
      { text: '了解更多', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      专业的 <span class="hidden xl:inline">IP代理服务</span>
      <span class="text-accent dark:text-white highlight"> ipflex</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">ipflex</span> 提供高效、稳定、安全的IP代理服务，适用于各种业务需求。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">ipflex: 专业的IP代理服务。</span>
      适用于电商、社交媒体、数据采集等多种场景。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="特点"
    title="ipflex的优势"
    subtitle="我们提供市场上最专业、最全面的IP代理服务。"
    items={[
      {
        title: '高效稳定',
        description:
          '我们的IP代理服务具有高效稳定的特点，确保您的业务不间断运行。',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: '多种IP类型',
        description:
          '提供静态住宅IP、动态住宅IP、机房IP等多种类型，满足不同业务需求。',
        icon: 'tabler:components',
      },
      {
        title: '安全可靠',
        description:
          '我们采用先进的加密技术，确保您的数据安全。',
        icon: 'tabler:list-check',
      },
      {
        title: '全球覆盖',
        description:
          '我们的IP代理服务覆盖全球，支持多国家和地区的IP切换。',
        icon: 'tabler:rocket',
      },
      {
        title: '灵活计费',
        description:
          '根据您的需求灵活计费，我们没有套餐捆绑。您可以按需购买，按流量计费。',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: '专业支持',
        description:
          '我们的专业团队随时为您提供技术支持和服务。',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="服务内容"
    title="ipflex的服务内容"
    items={[
      {
        title: '静态住宅IP',
        description:
          '提供长效静态IP，适用于需要24小时在线稳定IP的业务。',
      },
      {
        title: '动态住宅IP',
        description:
          '提供短效动态IP，适用于需要频繁更换IP的业务。',
      },
      {
        title: '机房IP',
        description:
          '提供高效稳定的机房IP，适用于大流量业务。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '服务内容图片',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">专业的IP代理服务</h3>
      我们致力于为客户提供高效、稳定、安全的IP代理服务。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '灵活定制',
        description: `根据您的业务需求，灵活定制IP代理服务，确保最佳效果。`,
      },
      {
        title: '多种套餐选择',
        description:
          '提供多种套餐选择，满足不同业务需求。',
      },
      {
        title: '全天候支持',
        description:
          "我们的专业团队提供24/7全天候技术支持，确保您的业务顺利进行。",
      },
      {
        title: '高效切换',
        description:
          '支持快速切换IP，确保您的业务不间断运行。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: '灵活定制图片',
    }}
  >
    <Fragment slot="content">确保您的业务始终在线。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '提升用户体验',
        description:
          '通过高效稳定的IP代理服务，提升用户体验，增加用户粘性。',
      },
      {
        title: '持续改进',
        description:
          '我们不断优化和改进服务，确保为客户提供最优质的IP代理服务。',
      },
      {
        title: '节省时间和资源',
        description:
          '通过我们的IP代理服务，节省您的时间和资源，快速上线业务。',
      },
      {
        title: '社区支持',
        description: `加入ipflex社区，获取更多资源和支持，确保您的业务顺利进行。`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '提升用户体验图片',
    }}
  >
    <Fragment slot="content">致力于为客户提供最佳服务。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="快速开始使用ipflex的IP代理服务"
    items={[
      {
        title: '步骤 1: <span class="font-medium">注册账号</span>',
        description:
          "在ipflex官网注册账号，开始您的IP代理服务之旅。",
        icon: 'tabler:package',
      },
      {
        title: '步骤 2: <span class="font-medium">选择套餐</span>',
        description:
          "根据您的业务需求，选择合适的IP代理套餐。",
        icon: 'tabler:letter-case',
      },
      {
        title: '步骤 3: <span class="font-medium">开始使用</span>',
        description:
          '配置您的IP代理服务，开始使用我们的高效稳定的IP代理服务。',
        icon: 'tabler:paint',
      },
      {
        title: '完成!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: '步骤图片',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="常用组件"
    subtitle="提供构建网站常用的组件，使用Tailwind CSS"
    tagline="组件"
    items={[
      {
        title: 'Headers',
        description: "网站的导航部分，帮助用户快速找到所需内容。",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Heros',
        description:
          "网站的首屏部分，展示最重要的信息和内容。",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Features',
        description:
          '展示网站的主要特点和优势。',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Content',
        description:
          "网站的主要内容部分，展示详细信息。",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Call-to-Action',
        description:
          '引导用户进行下一步操作的按钮或链接。',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Pricing',
        description: '展示服务的价格和套餐选择。',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Testimonial',
        description: '展示用户的评价和反馈。',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Contact',
        description:
          '提供联系方式，方便用户与我们联系。',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Footers',
        description: "网站的底部部分，展示版权信息和其他链接。",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="了解更多内容"
    information={`我们的博客提供最新的IP代理服务资讯和技术文章。
                        每篇新文章都是您了解IP代理服务的重要一步。
                        ipflex致力于为您提供最优质的服务。`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="常见问题"
    subtitle="了解ipflex的强大功能以及如何提升您的业务。"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '为什么选择ipflex?',
        description:
          "ipflex提供高效、稳定、安全的IP代理服务，适用于各种业务需求。",
      },
      {
        title: '我需要什么来开始使用?',
        description:
          '只需在ipflex官网注册账号，选择合适的套餐，即可开始使用我们的IP代理服务。',
      },
      {
        title: '如何安装和配置ipflex的IP代理服务?',
        description:
          "在官网注册账号后，根据提示选择套餐并配置IP代理服务，即可开始使用。",
      },
      {
        title: "ipflex的IP代理服务有哪些优势?",
        description:
          "ipflex提供高效稳定的IP代理服务，支持全球覆盖，灵活计费，专业支持。",
      },
      {
        title: 'ipflex的IP代理服务适用于哪些场景?',
        description:
          "ipflex的IP代理服务适用于电商、社交媒体、数据采集等多种场景。",
      },
      {
        title: '如何获取技术支持?',
        description:
          "我们的专业团队提供24/7全天候技术支持，确保您的业务顺利进行。",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '用户数量', amount: '132K' },
      { title: '服务次数', amount: '24.8K' },
      { title: '覆盖国家', amount: '10.3K' },
      { title: '满意度', amount: '98%' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '获取服务',
        href: 'https://ipflex.com',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      ipflex&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">专业的IP代理服务</span>
    </Fragment>

    <Fragment slot="subtitle">
      立即体验ipflex的高效稳定的IP代理服务。<br class="hidden md:inline" />不要再犹豫了，立即行动！
    </Fragment>
  </CallToAction>
</Layout>
