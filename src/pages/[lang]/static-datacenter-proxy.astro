---
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import PerformanceFeatures from '~/components/widgets/PerformanceFeatures.astro';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import DeductionMethods from '~/components/widgets/DeductionMethods.astro';
import { useTranslations } from '~/utils/i18n';

// Import images
import heroImage from '~/assets/images/proxies/3-1.webp';
import comparisonImage from '~/assets/images/proxies/3-2.webp';
// import googlesvg from "~/assets/images/proxies/google.svg"

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('staticDatacenterProxy.metadata.title'),
  description: t('staticDatacenterProxy.metadata.description'),
  ignoreTitleTemplate: true,
};

const answerFirstSummary =
  lang === 'zh'
    ? '直接结论：如果工作负载以高并发吞吐、接口调用效率和成本可预测性为核心，静态数据中心代理通常是首选。'
    : 'Answer first: static datacenter proxies are usually the first choice when throughput, API efficiency, and predictable cost matter most.';

const stats = t('staticDatacenterProxy.stats.items');
const faqs = t('staticDatacenterProxy.faqs.items');

const whyChooseUsFeatures = t('staticDatacenterProxy.whyChooseUs.features').map((feature, index) => ({
  ...feature,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-zap"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"></polygon></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-dollar-sign"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shield"><path d="M12,22s8-4 8-10V5l-8-3-8,3v7c0,6 8,10 8,10z"></path></svg>'
  ][index]
}));

const useCasesItems = t('staticDatacenterProxy.useCases.items').map((item, index) => ({
  ...item,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16,18 22,12 16,6"></polyline><polyline points="8,6 2,12 8,18"></polyline></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12,6 12,12 16,14"></polyline></svg>'
  ][index]
}));

const relatedLinks = [
  { href: `/${lang}/pricing`, label: lang === 'zh' ? '查看代理定价' : 'View Pricing' },
  { href: `/${lang}/static-residential-proxy`, label: lang === 'zh' ? '静态住宅代理' : 'Static Residential Proxy' },
  { href: `/${lang}/dynamic-residential-proxy`, label: lang === 'zh' ? '动态住宅代理' : 'Dynamic Residential Proxy' },
  { href: `/${lang}/detail`, label: lang === 'zh' ? '产品详情' : 'Product Details' },
  { href: `/${lang}/blog`, label: lang === 'zh' ? '代理博客' : 'Proxy Blog' },
];
const geoMethodFaqs = lang === 'zh'
  ? [
      {
        q: '静态数据中心代理适合哪些任务？',
        a: '适合高并发 API 调用、自动化测试和吞吐优先的批处理任务，重点是性能与成本可预测性。',
      },
      {
        q: '如何判断吞吐与稳定性是否达标？',
        a: '建议同时观察吞吐能力、P95 时延和失败重试占比，并覆盖峰值与常态窗口。',
      },
      {
        q: '如何降低预算波动？',
        a: '通过固定负载模型压测、月度偏差复盘和资源配比迭代，可以提升成本可控性。',
      },
    ]
  : [
      {
        q: 'What workloads fit static datacenter proxies best?',
        a: 'They fit high-throughput API calls, automation testing, and batch workflows with strong cost-performance requirements.',
      },
      {
        q: 'How should teams validate throughput stability?',
        a: 'Measure throughput, P95 latency, and retry ratio across both peak and normal traffic windows.',
      },
      {
        q: 'How can teams reduce budget variance?',
        a: 'Use fixed-load benchmarking, monthly variance reviews, and iterative resource tuning.',
      },
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IPFlex',
      item: `https://ipflex.ink/${lang}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '静态数据中心代理' : 'Static Datacenter Proxy',
      item: `https://ipflex.ink/${lang}/static-datacenter-proxy`,
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero Widget -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-b from-green-600 to-green-10"></div>
    <Hero
      image={{
        src: heroImage,
        alt: t('staticDatacenterProxy.hero.title'),
      }}
      class="relative z-10 pt-16 pb-10"
    >
      <Fragment slot="title">
        <span class="block text-5xl font-bold text-white leading-tight" style="margin-left:50px;">
          {t('staticDatacenterProxy.hero.title')}
        </span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="block text-left" style="margin-left:50px;">
          {t('staticDatacenterProxy.hero.subtitle')}
        </span>
      </Fragment>
      <Fragment slot="content">
        <div class="text-gray-200 space-y-6 mt-6" style="margin-left:50px;">
          <p class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-base font-medium leading-7 text-left text-white/95">
            {answerFirstSummary}
          </p>
          <ul class="space-y-3 text-lg">
            {t('staticDatacenterProxy.hero.features').map((feature) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 pt-4">
             <a  href="https://dashboard.ipflex.ink/register" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              {t('staticDatacenterProxy.hero.cta.primary')}
            </a>
          </div>
        </div>
      </Fragment>
    </Hero>
  </div>

  <!-- Stats Widget -->
  <Stats
    stats={stats}
    title={t('staticDatacenterProxy.stats.title')}
    subtitle={t('staticDatacenterProxy.stats.subtitle')}
    classes={{
      container: 'max-w-6xl',
      title: 'text-white',
      subtitle: 'text-green-100',
    }}
  />

  <!-- Performance Features Widget -->
  <PerformanceFeatures
    title={t('staticDatacenterProxy.performance.title')}
    description={t('staticDatacenterProxy.performance.description')}
    features={t('staticDatacenterProxy.performance.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('staticDatacenterProxy.performance.title')
    }}
    classes={{
      container: 'py-16'
    }}
  />

  <!-- Why Choose Us Widget -->
  <WhyChooseUs
    title={t('staticDatacenterProxy.whyChooseUs.title')}
    features={whyChooseUsFeatures}
  />

  <!-- Use Cases Widget -->
  <UseCases
    title={t('staticDatacenterProxy.useCases.title')}
    useCases={useCasesItems}
  />

  <!-- 计费方式对比 -->
  <DeductionMethods lang={lang} deductionData={t('staticDatacenterProxy.deductionMethods')} />

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '静态数据中心代理选择清单' : 'Static Datacenter Proxy Selection Checklist'}
    </h2>
    <p class="text-base leading-7 text-gray-700 dark:text-gray-300">
      {lang === 'zh'
        ? '静态数据中心代理的价值不只在低单价，而在于它能否在固定预算内持续交付吞吐和响应稳定性。评估时应把性能、预算偏差和失败重试占比放在同一视角比较。'
        : 'The value of static datacenter proxies is not just a lower unit price. It comes from whether the product can deliver stable throughput and response performance inside a fixed budget envelope.'}
    </p>
    <ol class="mt-4 list-decimal pl-5 space-y-2 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '先用固定负载压测确认稳定吞吐区间。' : 'Use a fixed-load benchmark to identify the stable throughput range first.'}</li>
      <li>{lang === 'zh' ? '同时记录 P95 时延、失败重试占比和单位完成成本。' : 'Record P95 latency, retry ratio, and unit completion cost together.'}</li>
      <li>{lang === 'zh' ? '用月度预算偏差和高峰窗口表现决定是否扩容。' : 'Use monthly budget variance and peak-window behavior to decide whether to scale.'}</li>
    </ol>
  </section>

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '静态数据中心代理如何评估是否适配' : 'How to Evaluate Static Datacenter Proxy Fit'}
    </h2>
    <p class="rounded-lg border border-green-100 bg-green-50/60 p-4 text-sm leading-6 text-green-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
      {lang === 'zh'
        ? '直接结论：若业务以高并发吞吐、API 调用效率和成本可预测性为核心，静态数据中心代理通常更合适。'
        : 'Answer-first: static datacenter proxies are usually the best option when throughput, API efficiency, and predictable cost are the primary goals.'}
    </p>
    <div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'zh' ? '关键指标口径' : 'Key Metric Definitions'}
      </h3>
      <ul class="list-disc pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
        <li>{lang === 'zh' ? '吞吐能力：单位时间内稳定完成请求数。' : 'Throughput: stable completed requests per unit time.'}</li>
        <li>{lang === 'zh' ? 'P95 时延：高负载下的关键响应时延指标。' : 'P95 latency: tail latency metric under high-load windows.'}</li>
        <li>{lang === 'zh' ? '成本波动率：预算周期内单位任务成本波动幅度。' : 'Cost variance: fluctuation range of unit workflow cost within budget cycles.'}</li>
      </ul>
    </div>
    <ol class="mt-4 list-decimal pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '用固定负载模型做压测并记录峰值窗口。' : 'Benchmark with a fixed load model and include peak windows.'}</li>
      <li>{lang === 'zh' ? '同时监控吞吐、P95 时延和失败重试占比。' : 'Track throughput, P95 latency, and retry ratio together.'}</li>
      <li>{lang === 'zh' ? '按月复盘预算偏差并迭代资源配比。' : 'Review monthly budget variance and tune resource allocation.'}</li>
    </ol>
  </section>

  <!-- FAQs Widget -->
  <FAQs
    title={t('staticDatacenterProxy.faqs.title')}
    subtitle={t('staticDatacenterProxy.faqs.subtitle')}
    tagline={t('staticDatacenterProxy.faqs.tagline')}
    items={faqs}
    classes={{
      container: 'max-w-6xl py-16 bg-gray-50',
      title: 'text-3xl font-bold',
      subtitle: 'text-xl text-gray-600',
    }}
  />

  <section class="max-w-6xl mx-auto py-10 px-4 md:px-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '相关页面' : 'Related Pages'}</h2>
    <div class="flex flex-wrap gap-3">
      {relatedLinks.map((link) => (
        <a href={link.href} class="px-4 py-2 rounded-lg border border-green-200 bg-green-50 text-green-700 hover:bg-green-100 transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '方法型常见问题' : 'Method FAQ'}</h2>
    <div class="space-y-3">
      {geoMethodFaqs.map((item) => (
        <div class="rounded-lg border border-gray-200 p-4 dark:border-slate-700">
          <h3 class="font-semibold text-gray-900 dark:text-white">{item.q}</h3>
          <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">{item.a}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-gray-500 dark:text-slate-400">
      {lang === 'zh' ? 'Last updated: 2026-03-05。来源：定价页、数据中心代理评估口径、帮助中心文档。' : 'Last updated: 2026-03-05. Sources: pricing framework, datacenter proxy evaluation baseline, and help center docs.'}
    </p>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: geoMethodFaqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    })} />
  </section>

</Layout>

<style>
  .bg-gradient-to-b {
    background-size: 100% 100%;
    background-position: 0% 0%;
  }
  
  .from-green-600 {
    --tw-gradient-from: #16a34a;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(22 163 74 / 0));
  }
  
  .to-green-10 {
    --tw-gradient-to: #f0fdf4;
  }
</style>
