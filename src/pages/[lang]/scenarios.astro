---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

type ScenarioItem = { title?: string; description?: string; url?: string };
const scenarios = (t('scenarios.data_list') || []) as ScenarioItem[];

const metadata = {
  title:
    lang === 'zh'
      ? 'IPFlex 企业代理应用场景与行业落地实践方案导航'
      : 'IPFlex Proxy Use Cases for Ad Verification, Data Collection, and E-commerce',
  description:
    lang === 'zh'
      ? '了解 IPFlex 在广告验证、跨境电商、数据采集、品牌监测与安全风控中的落地方法，覆盖静态住宅、动态住宅和数据中心代理组合，支持会话管理、区域路由、重试策略、稳定性优化与成本控制，帮助团队按业务目标持续扩展。'
      : 'See how IPFlex supports ad verification, data collection, e-commerce, and security tasks with static, rotating, and datacenter proxies, plus session control, geo routing, retry strategy, and cost management.',
  ignoreTitleTemplate: true,
};

const answerFirstSummary =
  lang === 'zh'
    ? '直接结论：广告验证优先覆盖与区域准确性，电商运营优先会话稳定，数据采集优先轮换与成本效率，安全风控优先可复现和策略控制。'
    : 'Answer first: ad verification needs geo accuracy and coverage, e-commerce operations need session stability, data collection needs rotation and cost efficiency, and security workflows need reproducibility and policy control.';

const scenarioFaqs = lang === 'zh'
  ? [
      {
        q: '应该先从哪类场景开始验证代理方案？',
        a: '建议先从业务价值高且可量化的单一链路开始，例如广告验证、登录稳定性或固定区域采集，再逐步扩展到多区域和高并发场景。',
      },
      {
        q: '不同场景选择代理类型的核心依据是什么？',
        a: '核心依据是业务优先级。如果优先考虑会话稳定和账号一致性，倾向静态住宅代理；如果优先考虑覆盖和轮换，倾向动态住宅代理；如果优先考虑吞吐和成本，倾向数据中心代理。',
      },
      {
        q: '场景落地时应该先监控哪些指标？',
        a: '建议先监控成功率、时延、重试开销、失败类型分布和单业务流程成本，再按场景补充区域覆盖或会话保持指标。',
      },
    ]
  : [
      {
        q: 'Which use case should teams validate first?',
        a: 'Start with a single, high-value workflow that can be measured clearly, such as ad verification, login stability, or geo-targeted data collection.',
      },
      {
        q: 'How should teams choose proxy types for different scenarios?',
        a: 'Choose by workload priority: static residential for session stability, dynamic residential for coverage and rotation, and datacenter for throughput-cost efficiency.',
      },
      {
        q: 'Which metrics should scenario rollout monitor first?',
        a: 'Track success ratio, latency, retry overhead, failure distribution, and cost per completed workflow before adding scenario-specific metrics.',
      },
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IPFlex',
      item: `https://ipflex.ink/${lang}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '应用场景' : 'Use Cases',
      item: `https://ipflex.ink/${lang}/scenarios`,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: scenarioFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <header class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{t('scenarios.title')}</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto">{t('scenarios.subtitle')}</p>
      <p class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-5 py-4 text-sm leading-6 text-blue-900 max-w-4xl mx-auto">
        {answerFirstSummary}
      </p>
    </header>

    <section class="mb-10 rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '场景选择方法' : 'Scenario Selection Method'}
      </h2>
      <p class="mt-4 text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? '场景选择不应只按行业名称判断，而应按任务目标来拆解。一个稳定的选择顺序通常是：先确认是否依赖长期会话，再确认是否依赖大规模覆盖，最后判断吞吐和预算是否是主要约束。'
          : 'Use case selection should start from workload goals, not industry labels alone. A reliable decision order is session persistence first, broad coverage second, and throughput-budget constraint third.'}
      </p>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-gray-700">
        <li>{lang === 'zh' ? '会话与账号稳定优先的任务，优先验证静态住宅代理。' : 'Validate static residential proxies first for workflows that depend on stable sessions and account identity.'}</li>
        <li>{lang === 'zh' ? '覆盖率与轮换优先的任务，优先验证动态住宅代理。' : 'Validate dynamic residential proxies first for workloads that depend on reach and rotation.'}</li>
        <li>{lang === 'zh' ? '吞吐与成本优先的任务，优先验证数据中心代理。' : 'Validate datacenter proxies first for workloads that prioritize throughput and cost efficiency.'}</li>
      </ol>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {Array.isArray(scenarios) &&
        scenarios.map((item) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <h2 class="text-xl font-semibold text-gray-900">{item.title}</h2>
            <p class="mt-3 text-sm text-gray-600 line-clamp-4">{item.description}</p>
            <a
              href={item.url}
              class="inline-flex mt-5 items-center text-blue-600 hover:text-blue-700 font-medium"
            >
              {t('scenarios.cta')} →
            </a>
          </article>
        ))}
    </div>

    <section class="mt-14 rounded-2xl border border-gray-200 bg-gray-50 p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '场景落地实施建议' : 'Implementation Guidance by Scenario'}
      </h2>
      <p class="mt-4 text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? '真实业务落地通常分为三个阶段：第一阶段进行目标站点可达性验证，确认请求头、会话策略与基础成功率；第二阶段进行并发压测，确定在不同时间窗口和地域策略下的稳定区间；第三阶段进入持续运营，建立失败重试、异常告警与成本监控机制。通过这种分阶段方法，团队可以在控制风险的前提下逐步扩大代理流量。'
          : 'Production rollout usually has three stages: first validate reachability and baseline success rate, then run concurrency stress tests across regions and time windows, and finally operate with retries, alerting, and cost monitoring. This staged approach helps teams scale proxy traffic while keeping risk and spend predictable.'}
      </p>
      <p class="mt-4 text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? '对于广告验证场景，建议优先覆盖核心投放国家和城市并保留样本日志；对于电商运营场景，建议将登录、浏览、下单等行为拆分为独立会话策略；对于安全风控场景，建议结合黑白名单和频率控制，确保检测结果可复现。IPFlex 的多产品组合能力可支持同一团队在多场景下采用不同代理策略。'
          : 'For ad verification, prioritize major campaign regions and keep sample logs for traceability. For e-commerce operations, split login, browse, and order actions into separate session policies. For security operations, combine allowlists, denylists, and rate controls to make results reproducible. IPFlex product combinations allow one team to run different strategies for different use cases.'}
      </p>
      <p class="mt-3 text-sm leading-7 text-gray-600" lang="en">
        Operational playbook: define KPI baseline, map target markets, configure session persistence, set retry budget, monitor failure taxonomy, compare provider pools, and review cost per successful workflow every week.
      </p>
    </section>

    <section class="mt-14 rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '场景常见问题' : 'Scenario FAQs'}
      </h2>
      <div class="mt-6 space-y-4">
        {scenarioFaqs.map((item) => (
          <article class="rounded-xl border border-gray-200 p-4">
            <h3 class="text-lg font-semibold text-gray-900">{item.q}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-700">{item.a}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</Layout>
