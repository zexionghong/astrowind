---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import ScenarioCard from '~/components/ui/ScenarioCard.astro';
import { Image } from 'astro:assets';
import bg from '~/assets/images/bg/scenarios.png';
export const getStaticPaths = () => {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'en' } },
  ];
};

const { lang = 'zh' } = Astro.params;
const t = await useTranslations(lang);

const metadata = {
  title: t('scenarios.title'),
};

const scenarios = t('scenarios.data_list');
---

<Layout metadata={metadata}>
  <main class="relative">
    <!-- 背景图片 -->
    <div class="absolute inset-0 z-0">
      <Image src={bg} alt="Background" class="w-full h-full object-cover" />
    </div>

    <!-- 主要内容 -->
    <div class="relative z-10 min-h-[calc(100vh-4rem)] py-20 px-4 sm:px-6 lg:px-8">
      <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
        <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-white">
          {t('scenarios.title')}
        </h2>
        <p class="text-xl text-white">
          {t('scenarios.subtitle')}
        </p>
        <div class="mt-6">
          <a href="https://dashboard.ipflex.ink/register" 
             class="relative inline-flex items-center justify-center rounded-full border-2 border-white bg-transparent px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-white hover:text-blue-600 transition-all duration-300">
            {t('scenarios.cta')}
          </a>
        </div>
      </div>
        <br/>
        <br/>
        <br/>
        <br/>
        {scenarios.map((scenario, index) => (
          <ScenarioCard
            color={scenario.color}
            title={scenario.title}
            description={scenario.description}
            benefits={scenario.benefits}
            image={scenario.image}
          />
        ))}
    </div>
  </main>
</Layout>

<style>
  .bg-gradient-overlay {
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.7), rgba(59, 130, 246, 0.2));
    mix-blend-mode: multiply;
  }
</style> 
