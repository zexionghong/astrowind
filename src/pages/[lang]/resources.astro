---
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang = 'zh' } = Astro.params;

const metadata = {
  title:
    lang === 'zh'
      ? 'IPFlex 知识中心：代理定义、接入文档、选择指南与方法文章'
      : 'IPFlex Resources: Proxy Definitions, Onboarding Docs, Selection Guides, and Playbooks',
  description:
    lang === 'zh'
      ? '浏览 IPFlex 主域知识中心，快速获取代理类型定义、套餐选择方法、场景落地建议、接入文档入口与精选方法文章，帮助团队更快完成评估、接入与扩容。'
      : 'Browse the IPFlex resource hub for proxy definitions, plan selection guidance, implementation methods, integration docs, and curated playbooks for evaluation and rollout.',
  ignoreTitleTemplate: true,
};

const sections = lang === 'zh'
  ? [
      {
        title: '代理定义与选择',
        description: '先明确静态住宅、动态住宅与数据中心代理的差异，再决定哪个更适合你的业务目标。',
        links: [
          { href: `/${lang}/detail`, label: '代理类型选择指南', note: '比较三类代理的能力边界、适用场景与实施建议。' },
          { href: `/${lang}/static-residential-proxy`, label: '静态住宅代理', note: '适合长期会话、账号稳定与低身份波动任务。' },
          { href: `/${lang}/dynamic-residential-proxy`, label: '动态住宅代理', note: '适合广覆盖、轮换出口与大规模采集任务。' },
          { href: `/${lang}/static-datacenter-proxy`, label: '静态数据中心代理', note: '适合高并发 API、吞吐优先与成本敏感任务。' },
          { href: `/${lang}/pricing`, label: '套餐与定价选择指南', note: '按成功率、时延与单位完成成本评估套餐。' },
        ],
      },
      {
        title: '场景与落地方法',
        description: '按业务目标查找场景方案，再结合代理类型做更细的技术决策。',
        links: [
          { href: `/${lang}/scenarios`, label: '应用场景总览', note: '按广告验证、电商运营、采集与风控分类查看方案。' },
          { href: `/${lang}/use-case/static-residential-proxy-ad-verification`, label: '广告验证代理', note: '验证地域展示、投放一致性与广告欺诈风险。' },
          { href: `/${lang}/use-case/static-residential-proxy-ecommerce`, label: '跨境电商代理', note: '处理账号运营、会话稳定与多平台执行。' },
          { href: `/${lang}/use-case/static-residential-proxy-scraping`, label: '市场研究与数据采集', note: '面向采集、覆盖率与目标站点稳定性。' },
          { href: `/${lang}/use-case/static-residential-proxy-security`, label: '网络安全与风控', note: '面向可复现测试、巡检与防护策略。' },
        ],
      },
      {
        title: '接入与帮助文档',
        description: '主域负责聚合和决策入口，详细 API 与操作文档仍在帮助中心。',
        links: [
          { href: 'https://docs.ipflex.ink/', label: '帮助中心', note: '查看 API、鉴权、接入流程和常见操作。', external: true },
          { href: `/${lang}/register`, label: '注册与开通', note: '创建账号并启动 PoC 或生产接入。' },
          { href: `/${lang}/privacy`, label: '隐私与数据治理', note: '了解数据处理、留存和安全治理要求。' },
        ],
      },
      {
        title: '精选方法文章',
        description: '这些文章更适合做实施参考和团队内部评审材料。',
        links: [
          { href: `/${lang}/blog/enterprise-proxy-onboarding-playbook-2026${lang === 'en' ? '-en' : ''}`, label: '企业代理接入执行手册', note: '适合 PoC 到生产扩容的实施流程。' },
          { href: `/${lang}/blog/proxy-sticky-session-checkout-login-stability-guide${lang === 'en' ? '-en' : ''}`, label: '会话稳定性评估方法', note: '适合账号、登录、结账和稳定性验证。' },
          { href: `/${lang}/blog/proxy-types-comparison${lang === 'en' ? '-en' : ''}`, label: '代理类型对比文章', note: '补充理解产品差异与适配边界。' },
          { href: `/${lang}/blog`, label: '浏览全部博客', note: '查看更多代理、集成和 GEO 方法文章。' },
        ],
      },
    ]
  : [
      {
        title: 'Definitions and Selection',
        description: 'Clarify the difference between static residential, dynamic residential, and datacenter proxies before choosing the best fit.',
        links: [
          { href: `/${lang}/detail`, label: 'Proxy Type Selection Guide', note: 'Compare capability boundaries, use cases, and rollout guidance.' },
          { href: `/${lang}/static-residential-proxy`, label: 'Static Residential Proxy', note: 'Best for stable sessions, account consistency, and low identity volatility.' },
          { href: `/${lang}/dynamic-residential-proxy`, label: 'Dynamic Residential Proxy', note: 'Best for broad coverage, rotation, and large-scale collection.' },
          { href: `/${lang}/static-datacenter-proxy`, label: 'Static Datacenter Proxy', note: 'Best for high-throughput API workloads and predictable cost.' },
          { href: `/${lang}/pricing`, label: 'Pricing and Plan Selection Guide', note: 'Evaluate plans with success rate, latency, and cost-per-completion.' },
        ],
      },
      {
        title: 'Use Cases and Rollout',
        description: 'Start from business goals, then choose the scenario and proxy strategy that fits operational reality.',
        links: [
          { href: `/${lang}/scenarios`, label: 'Use Case Overview', note: 'Browse ad verification, e-commerce, collection, and security workflows.' },
          { href: `/${lang}/use-case/static-residential-proxy-ad-verification`, label: 'Ad Verification Proxy', note: 'Validate geo accuracy, placement consistency, and fraud exposure.' },
          { href: `/${lang}/use-case/static-residential-proxy-ecommerce`, label: 'E-commerce Proxy', note: 'Support account operations, session stability, and platform execution.' },
          { href: `/${lang}/use-case/static-residential-proxy-scraping`, label: 'Market Research and Data Collection', note: 'Focus on collection reliability, coverage, and target-site access.' },
          { href: `/${lang}/use-case/static-residential-proxy-security`, label: 'Network Security and Risk Control', note: 'Support reproducible testing, inspection, and control strategy.' },
        ],
      },
      {
        title: 'Onboarding and Docs',
        description: 'The main domain is the decision and discovery layer, while the help center remains the detailed documentation layer.',
        links: [
          { href: 'https://docs.ipflex.ink/', label: 'Help Center', note: 'Open API, authentication, onboarding, and operational documentation.', external: true },
          { href: `/${lang}/register`, label: 'Registration and Access', note: 'Create an account and start a PoC or production rollout.' },
          { href: `/${lang}/privacy`, label: 'Privacy and Data Governance', note: 'Review data handling, retention, and security governance policy.' },
        ],
      },
      {
        title: 'Featured Playbooks',
        description: 'These articles work well as execution references and internal review material.',
        links: [
          { href: `/${lang}/blog/enterprise-proxy-onboarding-playbook-2026${lang === 'en' ? '-en' : ''}`, label: 'Enterprise Proxy Onboarding Playbook', note: 'Operational guide from PoC to production scale-up.' },
          { href: `/${lang}/blog/proxy-sticky-session-checkout-login-stability-guide${lang === 'en' ? '-en' : ''}`, label: 'Sticky Session Stability Guide', note: 'Useful for account, login, checkout, and stability validation.' },
          { href: `/${lang}/blog/proxy-types-comparison${lang === 'en' ? '-en' : ''}`, label: 'Proxy Type Comparison', note: 'Complementary explanation of product tradeoffs and fit.' },
          { href: `/${lang}/blog`, label: 'Browse All Blog Posts', note: 'Read more proxy, integration, and GEO methodology content.' },
        ],
      },
    ];

const resourceFaqs = lang === 'zh'
  ? [
      {
        q: '资源中心先看哪一部分最有效？',
        a: '如果你还在评估阶段，先看代理类型选择指南和定价选择方法；如果你已经明确业务目标，先看应用场景和对应产品页；如果你在接入阶段，直接进入帮助中心和接入手册。',
      },
      {
        q: '主域资源中心和帮助中心的分工是什么？',
        a: '主域资源中心负责定义、选择、场景和方法聚合，帮助中心负责 API、鉴权、接入流程和详细操作说明。两者结合可以减少团队查找资料的时间。',
      },
      {
        q: '哪些页面最适合做内部评审或采购决策参考？',
        a: '通常建议先看代理类型选择指南、定价页、应用场景总览，以及企业代理接入执行手册，这几类页面最适合做跨团队评审和采购判断。',
      },
    ]
  : [
      {
        q: 'Which section should teams start with?',
        a: 'Start with the proxy type guide and pricing evaluation if the team is still deciding. Move to use cases and product pages when the workload is already clear. Use the help center when the team is in onboarding.',
      },
      {
        q: 'What is the difference between the resource hub and the help center?',
        a: 'The resource hub is the decision and discovery layer for definitions, selection, and methods. The help center is the detailed documentation layer for API, authentication, onboarding, and operations.',
      },
      {
        q: 'Which pages are best for internal review or procurement decisions?',
        a: 'The most useful pages are the proxy type selection guide, pricing page, use case overview, and the enterprise onboarding playbook because they combine product fit, rollout logic, and evaluation criteria.',
      },
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IPFlex',
      item: `https://ipflex.ink/${lang}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '知识中心' : 'Resources',
      item: `https://ipflex.ink/${lang}/resources`,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: resourceFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 via-white to-slate-50 p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">
        {lang === 'zh' ? 'Knowledge Hub' : 'Resource Hub'}
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        {lang === 'zh' ? 'IPFlex 知识中心' : 'IPFlex Resources'}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? '这个页面的目标不是替代帮助中心，而是把定义、选择、场景、接入和方法资料集中到主域，减少团队在多个入口之间来回切换的成本。'
          : 'This page does not replace the help center. It gives the main domain a clear knowledge entrypoint for definitions, selection, rollout, onboarding, and implementation material.'}
      </p>
    </header>

    <section class="mt-10 grid gap-6 md:grid-cols-2">
      {sections.map((section) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">{section.title}</h2>
          <p class="mt-3 text-base leading-7 text-gray-700">{section.description}</p>
          <div class="mt-6 space-y-4">
            {section.links.map((link) => (
              <a
                href={link.href}
                class="block rounded-xl border border-gray-200 p-4 transition-colors hover:border-blue-300 hover:bg-blue-50/40"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <h3 class="text-lg font-semibold text-gray-900">{link.label}</h3>
                <p class="mt-1 text-sm leading-6 text-gray-700">{link.note}</p>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-gray-50 p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '推荐使用顺序' : 'Recommended Reading Order'}
      </h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-gray-700">
        <li>{lang === 'zh' ? '先看代理类型选择指南，明确业务到底需要稳定性、覆盖率还是吞吐。' : 'Start with the proxy type guide to decide whether stability, coverage, or throughput matters most.'}</li>
        <li>{lang === 'zh' ? '再看定价与场景页，把产品判断和预算判断放到同一套口径里。' : 'Move to pricing and use case pages so product fit and budget fit are evaluated with the same logic.'}</li>
        <li>{lang === 'zh' ? '确定方案后进入帮助中心和执行手册，减少接入过程中的信息断层。' : 'After the decision is clear, use the help center and rollout playbooks to reduce onboarding gaps.'}</li>
      </ol>
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '常见问题' : 'Frequently Asked Questions'}
      </h2>
      <div class="mt-6 space-y-4">
        {resourceFaqs.map((item) => (
          <article class="rounded-xl border border-gray-200 p-4">
            <h3 class="text-lg font-semibold text-gray-900">{item.q}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-700">{item.a}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</Layout>
