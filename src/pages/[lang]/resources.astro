---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang, generateBreadcrumbSchema, generateFAQSchema } from '~/utils/schema';

export async function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('resources.title'),
  description: t('resources.description'),
  ignoreTitleTemplate: true,
};

const sectionsData = t('resources.sections');
const sections = Array.isArray(sectionsData) ? sectionsData.map((section: any) => ({
  ...section,
  links: Array.isArray(section.links) ? section.links.map((link: any) => ({
    ...link,
    href: link.external ? link.href : `/${lang}/${link.href}`
  })) : []
})) : [];

const resourceFaqs = t('resources.faqs');

const breadcrumbSchema = generateBreadcrumbSchema(lang, t('resources.header.title'), 'resources');
const faqSchema = generateFAQSchema(Array.isArray(resourceFaqs) ? resourceFaqs : []);
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 via-white to-slate-50 p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">
        {t('resources.header.eyebrow')}
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        {t('resources.header.title')}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-gray-700">
        {t('resources.header.description')}
      </p>
    </header>

    <section class="mt-10 grid gap-6 md:grid-cols-2">
      {sections.map((section: any) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">{section.title}</h2>
          <p class="mt-3 text-base leading-7 text-gray-700">{section.description}</p>
          <div class="mt-6 space-y-4">
            {section.links.map((link: any) => (
              <a
                href={link.href}
                class="block rounded-xl border border-gray-200 p-4 transition-colors hover:border-blue-300 hover:bg-blue-50/40"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <h3 class="text-lg font-semibold text-gray-900">{link.label}</h3>
                <p class="mt-1 text-sm leading-6 text-gray-700">{link.note}</p>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-gray-50 p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {t('resources.readingOrder.title')}
      </h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-gray-700">
        {Array.isArray(t('resources.readingOrder.steps')) && t('resources.readingOrder.steps').map((step: any) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900">
        {t('resources.faqTitle')}
      </h2>
      <div class="mt-6 space-y-4">
        {Array.isArray(resourceFaqs) && resourceFaqs.map((item: any) => (
          <article class="rounded-xl border border-gray-200 p-4">
            <h3 class="text-lg font-semibold text-gray-900">{item.q}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-700">{item.a}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</Layout>
