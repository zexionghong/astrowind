---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import { useTranslations } from '~/utils/i18n';
import type { CollectionEntry } from 'astro:content';
import { getNormalizedPost } from '~/utils/blog';

export const getStaticPaths = (async () => {
  const posts = await getCollection('post');
  const paths = [];

  for (const post of posts) {
    const { language } = post.data;
    const slug = post.slug.split('/').pop() || post.slug;
    
    const normalizedPost = await getNormalizedPost(post);
    paths.push({
      params: {
        slug,
        lang: language
      },
      props: { post, normalizedPost },
    });
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'post'>;
  normalizedPost: any;
}

const { post, normalizedPost } = Astro.props;
const { lang } = Astro.params;
const t = await useTranslations(lang);

const { Content } = await post.render();

const siteBase = String(Astro.site || '').replace(/\/$/, '');
const canonicalUrl = `${siteBase}${Astro.url.pathname}`;
const datePublished = new Date(post.data.publishDate).toISOString();

const metadata = {
  title: post.data.title,
  description: post.data.excerpt,
  openGraph: {
    type: 'article',
    url: canonicalUrl,
    title: post.data.title,
    description: post.data.excerpt,
  },
};

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  author: {
    '@type': 'Organization',
    name: post.data.author || 'IPFlex',
  },
  publisher: {
    '@type': 'Organization',
    name: 'IPFlex',
    url: 'https://ipflex.ink',
  },
  datePublished,
  dateModified: datePublished,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  keywords: Array.isArray(post.data.tags) ? post.data.tags.join(',') : undefined,
  articleSection: post.data.category,
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <SinglePost post={normalizedPost}>
    <Content />
  </SinglePost>
  <ToBlogLink lang={lang} />
</Layout> 