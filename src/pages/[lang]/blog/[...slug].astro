---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import { useTranslations } from '~/utils/i18n';
import type { CollectionEntry } from 'astro:content';
import { getNormalizedPost } from '~/utils/blog';

export const getStaticPaths = (async () => {
  const posts = await getCollection('post');
  const paths = [];

  for (const post of posts) {
    const { language } = post.data;
    const slug = post.slug.split('/').pop() || post.slug;
    
    const normalizedPost = await getNormalizedPost(post);
    paths.push({
      params: {
        slug,
        lang: language
      },
      props: { post, normalizedPost },
    });
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'post'>;
  normalizedPost: any;
}

interface FAQItem {
  question: string;
  answer: string;
}

const extractFaqItems = (body: string): FAQItem[] => {
  const faqSectionMatch = body.match(/(?:^|\n)##\s+(?:FAQ|常见问题)\s*\n([\s\S]*?)(?=\n##\s+|$)/i);
  if (!faqSectionMatch) return [];

  const sectionBody = faqSectionMatch[1];
  const items = [...sectionBody.matchAll(/(?:^|\n)###\s+(.+?)\s*\n([\s\S]*?)(?=\n###\s+|$)/g)];

  return items
    .map(([, question, answer]) => ({
      question: question.trim(),
      answer: answer
        .replace(/^\s*[-*]\s+/gm, '')
        .replace(/`/g, '')
        .replace(/\[(.*?)\]\((.*?)\)/g, '$1')
        .replace(/\s+/g, ' ')
        .trim(),
    }))
    .filter((item) => item.question && item.answer);
};

const { post, normalizedPost } = Astro.props;
const { lang } = Astro.params;
const t = await useTranslations(lang);

const { Content } = await post.render();
const faqItems = extractFaqItems(post.body);

const siteBase = String(Astro.site || '').replace(/\/$/, '');
const canonicalUrl = `${siteBase}${Astro.url.pathname}`;
const datePublished = new Date(post.data.publishDate).toISOString();

const metadata = {
  title: post.data.title,
  description: post.data.excerpt,
  openGraph: {
    type: 'article',
    url: canonicalUrl,
    title: post.data.title,
    description: post.data.excerpt,
  },
};

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  author: {
    '@type': 'Organization',
    name: post.data.author || 'IPFlex',
  },
  publisher: {
    '@type': 'Organization',
    name: 'IPFlex',
    url: 'https://ipflex.ink',
  },
  datePublished,
  dateModified: datePublished,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  keywords: Array.isArray(post.data.tags) ? post.data.tags.join(',') : undefined,
  articleSection: post.data.category,
};

const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : undefined;
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <SinglePost post={normalizedPost}>
    <Content />
  </SinglePost>
  <ToBlogLink lang={lang} />
</Layout>
