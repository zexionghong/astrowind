---
import Layout from '~/layouts/PageLayout.astro';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;
const privacy = await getEntry('privacy', lang);
const { Content } = await privacy.render();

const metadata = {
  title: privacy.data.title,
  description:
    lang === 'zh'
      ? 'IPFlex 隐私政策：详细说明我们如何收集、使用、存储与保护用户数据，覆盖账号信息、日志留存、安全审计、跨境传输、访问控制与数据主体权利，便于企业建立可追溯的数据治理机制。'
      : 'IPFlex Privacy Policy explains how we collect, use, store, and protect user data, including account details, logs, security audits, cross-border transfers, and data subject rights.',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="prose prose-lg lg:prose-xl dark:prose-invert max-w-4xl mx-auto">
      <h1 class="text-center mb-8">{privacy.data.title}</h1>
      <Content />
    </div>

    <section class="mx-auto mt-10 max-w-4xl rounded-2xl border border-gray-200 bg-gray-50 p-6">
      <h2 class="mb-3 text-2xl font-bold text-gray-900">
        {lang === 'zh' ? '数据安全与用户权利说明' : 'Data Security and User Rights'}
      </h2>
      <p class="mb-3 text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? 'IPFlex 仅在提供服务所必需的范围内处理数据，并通过访问控制、加密传输、日志审计和最小权限策略降低数据风险。针对账号相关数据，我们会依据业务与合规要求设置合理留存周期，并在到期后执行归档或删除。'
          : 'IPFlex processes data only as needed to deliver services and applies access control, encrypted transport, audit logging, and least-privilege practices to reduce risk. For account-related records, we keep data only for justified operational and compliance periods, then archive or delete it when retention expires.'}
      </p>
      <p class="text-base leading-7 text-gray-700">
        {lang === 'zh'
          ? '用户可通过支持渠道申请访问、更正或删除个人信息，并可就处理目的、留存期限和跨境传输安排提出咨询。企业客户建议在接入前完成数据分级、权限审计和供应商合规评估，以确保业务上线后的可追溯性与可控性。'
          : 'Users can request access, correction, or deletion through support channels, and may ask about processing purposes, retention windows, and cross-border transfer controls. Enterprise customers should complete data classification, permission audits, and vendor compliance checks before production rollout to improve traceability and governance.'}
      </p>
      <p class="mt-3 text-sm leading-7 text-gray-600" lang="en">
        Privacy control checklist: lawful purpose mapping, minimization by design, encrypted data transit, access review cadence, retention schedule, deletion workflow, data subject request handling, and incident notification timeline.
      </p>
    </section>
  </section>
</Layout> 
