<Layout metadata={metadata}>
  <section class="ai-hero relative overflow-hidden bg-[#030620]">
    <div class="absolute inset-0 ai-grid opacity-35"></div>
    <div class="absolute left-1/2 top-14 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-4 py-1.5 text-sm font-medium text-blue-100 backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          {copy.badge}
        </div>
        <h1 class="mb-6 text-4xl font-bold leading-tight tracking-normal text-white md:text-5xl lg:text-6xl">
          {copy.title}
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
          {copy.subtitle}
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://dashboard.ipflex.ink" target="_blank" rel="noopener noreferrer" class="ai-btn-primary inline-flex items-center justify-center rounded-full px-8 py-3.5 text-base font-semibold text-white">
            {copy.primaryCta}
          </a>
          <a href="#how-it-works" class="inline-flex items-center justify-center rounded-full border border-white/25 px-8 py-3.5 text-base font-medium text-white transition hover:border-white/60 hover:bg-white/10">
            {copy.secondaryCta}
          </a>
        </div>
        <div class="mt-12 flex flex-col items-center justify-center gap-4 text-sm text-slate-400 sm:flex-row sm:gap-8">
          {copy.proof.map((item) => (
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.problemTitle}</h2>
