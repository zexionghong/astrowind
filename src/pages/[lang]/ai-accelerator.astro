---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang } from '~/utils/schema';

export async function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('aiAccelerator.title') + ' - IPFlex',
  description: t('aiAccelerator.subtitle'),
  ignoreTitleTemplate: true,
};

const icons: Record<string, string> = {
  home: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z"/></svg>',
  dns: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>',
  shield: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
  server: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><circle cx="6" cy="6" r="1" fill="currentColor"/><circle cx="6" cy="18" r="1" fill="currentColor"/></svg>',
  globe: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  zap: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  aiCube: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9.75 3.104v5.441a1.5 1.5 0 01-.854 1.353L5 11.482M20.25 20.853V15.44a1.5 1.5 0 00-.86-1.34L16 12.5M5 11.482v7.518a1.5 1.5 0 001.03 1.424L12 23M20.25 20.853l-5.75-2.877a1.5 1.5 0 01-.75-1.3v-7.726M12 12.5l4.413-2.338a1.5 1.5 0 00.837-1.34V3.381M12 23l-4.97-2.576A1.5 1.5 0 016 19.06v-7.56"/></svg>',
  monitor: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
  grid: '<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></svg>',
};

const getIcon = (iconName: string) => icons[iconName] || icons.home;

const copy = {
  badge: t('aiAccelerator.badge'),
  title: t('aiAccelerator.title'),
  subtitle: t('aiAccelerator.subtitle'),
  primaryCta: t('aiAccelerator.primaryCta'),
  secondaryCta: t('aiAccelerator.secondaryCta'),
  proof: t('aiAccelerator.proof'),
  problemTitle: t('aiAccelerator.problemTitle'),
  problemIntro: t('aiAccelerator.problemIntro'),
  solutionEyebrow: t('aiAccelerator.solutionEyebrow'),
  solutionTitle: t('aiAccelerator.solutionTitle'),
  solutionIntro: t('aiAccelerator.solutionIntro'),
  howTitle: t('aiAccelerator.howTitle'),
  howIntro: t('aiAccelerator.howIntro'),
  scenariosTitle: t('aiAccelerator.scenariosTitle'),
  scenariosIntro: t('aiAccelerator.scenariosIntro'),
  stepsTitle: t('aiAccelerator.stepsTitle'),
  stepsIntro: t('aiAccelerator.stepsIntro'),
  compareTitle: t('aiAccelerator.compareTitle'),
  faqTitle: t('aiAccelerator.faqTitle'),
  faqIntro: t('aiAccelerator.faqIntro'),
  ctaTitle: t('aiAccelerator.ctaTitle'),
  ctaIntro: t('aiAccelerator.ctaIntro'),
  contact: t('aiAccelerator.contact'),
  pricingNote: t('aiAccelerator.pricingNote'),
  problems: t('aiAccelerator.problems'),
  solutions: t('aiAccelerator.solutions').map((item: any) => ({ ...item, icon: getIcon(item.icon) })),
  how: t('aiAccelerator.how'),
  scenarios: t('aiAccelerator.scenarios').map((item: any) => ({ ...item, icon: getIcon(item.icon) })),
  steps: t('aiAccelerator.steps'),
  table: t('aiAccelerator.table'),
  faqs: t('aiAccelerator.faqs'),
};
---

<Layout metadata={metadata}>
  <section class="ai-hero relative overflow-hidden bg-[#030620]">
    <div class="absolute inset-0 ai-grid opacity-35"></div>
    <div class="absolute left-1/2 top-14 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-4 py-1.5 text-sm font-medium text-blue-100 backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          {copy.badge}
        </div>
        <h1 class="mb-6 text-4xl font-bold leading-tight tracking-normal text-white md:text-5xl lg:text-6xl">
          {copy.title}
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
          {copy.subtitle}
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://dashboard.ipflex.ink" target="_blank" rel="noopener noreferrer" class="ai-btn-primary inline-flex items-center justify-center rounded-full px-8 py-3.5 text-base font-semibold text-white">
            {copy.primaryCta}
          </a>
          <a href="#how-it-works" class="inline-flex items-center justify-center rounded-full border border-white/25 px-8 py-3.5 text-base font-medium text-white transition hover:border-white/60 hover:bg-white/10">
            {copy.secondaryCta}
          </a>
        </div>
        <div class="mt-12 flex flex-col items-center justify-center gap-4 text-sm text-slate-400 sm:flex-row sm:gap-8">
          {copy.proof.map((item) => (
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.problemTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg leading-8 text-slate-600">{copy.problemIntro}</p>
      </div>

      <div class="mb-16 grid gap-8 md:grid-cols-3">
        {copy.problems.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <div class:list={[
              'mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-xl text-sm font-bold',
              item.color === 'red' && 'bg-red-50 text-red-500',
              item.color === 'orange' && 'bg-orange-50 text-orange-500',
              item.color === 'yellow' && 'bg-amber-50 text-amber-600',
            ]}>
              {item.icon}
            </div>
            <h3 class="mb-3 text-lg font-semibold text-slate-950">{item.title}</h3>
            <p class="text-sm leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="mb-12 text-center">
        <span class="mb-3 inline-block text-sm font-semibold uppercase tracking-wide text-blue-600">{copy.solutionEyebrow}</span>
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.solutionTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg leading-8 text-slate-600">{copy.solutionIntro}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {copy.solutions.map((item) => (
          <article class="rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-violet-50 p-6 transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="mb-2 text-base font-semibold text-slate-950">{item.title}</h3>
            <p class="text-sm leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="relative overflow-hidden bg-[#030620] py-20 md:py-28">
    <div class="absolute inset-0 ai-grid opacity-20"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">{copy.howTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg leading-8 text-slate-300">{copy.howIntro}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {copy.how.map((item, index) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.06] p-8 text-center backdrop-blur-sm">
            <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-500/20">
              <span class="text-3xl font-bold text-blue-300">{index + 1}</span>
            </div>
            <h3 class="mb-4 text-xl font-semibold text-white">{item.title}</h3>
            <p class="text-sm leading-7 text-slate-400">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.scenariosTitle}</h2>
        <p class="mx-auto max-w-xl text-lg leading-8 text-slate-600">{copy.scenariosIntro}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {copy.scenarios.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:shadow-md">
            <div class:list={[
              'mb-4 flex h-11 w-11 items-center justify-center rounded-xl',
              item.color === 'green' && 'bg-green-50 text-green-600',
              item.color === 'orange' && 'bg-orange-50 text-orange-600',
              item.color === 'purple' && 'bg-purple-50 text-purple-600',
              item.color === 'blue' && 'bg-blue-50 text-blue-600',
            ]}>
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="mb-2 text-base font-semibold text-slate-950">{item.title}</h3>
            <p class="text-sm leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.stepsTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg leading-8 text-slate-600">{copy.stepsIntro}</p>
      </div>
      <div class="mx-auto max-w-4xl">
        {copy.steps.map((item, index) => (
          <div class="mb-10 flex flex-col items-start gap-6 last:mb-0 md:flex-row">
            <div class="ai-step flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white">
              {index + 1}
            </div>
            <article class="flex-1 rounded-2xl bg-slate-50 p-6">
              <h3 class="mb-2 text-lg font-semibold text-slate-950">{item.title}</h3>
              <p class="text-sm leading-7 text-slate-600">{item.description}</p>
            </article>
          </div>
        ))}
      </div>
      <div class="mt-14 text-center">
        <p class="mb-6 text-sm text-slate-600">{copy.pricingNote}</p>
        <a href="https://dashboard.ipflex.ink" target="_blank" rel="noopener noreferrer" class="ai-btn-primary inline-flex items-center justify-center rounded-full px-8 py-3.5 text-base font-semibold text-white">
          {copy.primaryCta}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50/50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h3 class="mb-10 text-center text-2xl font-bold text-gray-900">{copy.compareTitle}</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              {copy.table.headers.map((header, index) => (
                <th class:list={[
                  'px-4 py-4 font-semibold',
                  index === 0 && 'text-left text-gray-900',
                  index === 1 && 'rounded-t-xl bg-[#0161ef] text-center text-white',
                  index > 1 && 'text-center text-gray-500',
                ]}>
                  {header}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {copy.table.rows.map((row) => (
              <tr>
                {row.map((cell, index) => (
                  <td class:list={[
                    'px-4 py-3.5',
                    index === 0 && 'font-medium text-gray-700',
                    index === 1 && 'bg-blue-50/50 text-center font-medium text-green-600',
                    index === 2 && 'ai-text-dim text-center',
                    index === 3 && 'text-center text-red-500',
                  ]}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-3xl font-bold text-slate-950 md:text-4xl">{copy.faqTitle}</h2>
        <p class="text-lg text-slate-600">{copy.faqIntro}</p>
      </div>
      <div class="space-y-3">
        {copy.faqs.map((item, index) => (
          <details class="group rounded-xl border border-slate-200" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-medium text-slate-950">
              {item.question}
              <span class="text-slate-400 transition group-open:rotate-180">⌄</span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-7 text-slate-600">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-[#030620] py-16 md:py-20">
    <div class="absolute inset-0 ai-grid opacity-20"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">{copy.ctaTitle}</h2>
      <p class="mx-auto mb-8 max-w-xl text-lg leading-8 text-slate-300">{copy.ctaIntro}</p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://dashboard.ipflex.ink/register" target="_blank" rel="noopener noreferrer" class="ai-btn-primary inline-flex items-center justify-center rounded-full px-8 py-3.5 text-base font-semibold text-white">
          {t('aiAccelerator.primaryCta')}
        </a>
        <a href="https://t.me/IPFlexProxy" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-slate-300 transition hover:text-white">
          {copy.contact}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ai-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at center, black, transparent 75%);
  }

  .ai-btn-primary,
  .ai-step {
    background: linear-gradient(135deg, #0161ef, #6d28d9);
  }

  .ai-btn-primary {
    box-shadow: 0 12px 30px rgba(1, 97, 239, 0.28);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .ai-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 38px rgba(1, 97, 239, 0.34);
  }
</style>
