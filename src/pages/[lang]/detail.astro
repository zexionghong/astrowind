---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyService from '~/components/widgets/ProxyService.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;
const t = await useTranslations(lang);

const metadata = {
  title: t('detail.title'),
  description: t('detail.metadata.description'),
};
---

<Layout metadata={metadata}>

    <div class="relative h-[350px] text-center bg-[#2a64f4] w-full flex flex-col items-center justify-center">
      <div class="absolute inset-0 bg-gradient-to-b from-blue-500/20 to-transparent"></div>
      <div class="relative z-10 max-w-3xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight mb-6 font-heading text-white drop-shadow-md">
          {t('detail.title')}
        </h2>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto leading-relaxed">
          {t('detail.slogan.line1')}
          <br/>
          {t('detail.slogan.line2')}
        </p>
        <div class="flex flex-col items-center gap-4">
          <a href="https://dashboard.ipflex.ink/register" 
             class="relative inline-flex items-center justify-center rounded-full border-2 border-white bg-transparent px-8 py-4 text-lg font-medium text-white shadow-lg hover:bg-white hover:text-[#2a64f4] transition-all duration-300 hover:scale-105">
            {t('scenarios.cta')}
          </a>
          <div class="flex flex-wrap justify-center gap-3 text-sm">
            <a href={`/${lang}/static-residential-proxy`} class="text-white/90 hover:text-white underline underline-offset-4">{t('detail.staticResidential.title')}</a>
            <a href={`/${lang}/dynamic-residential-proxy`} class="text-white/90 hover:text-white underline underline-offset-4">{t('detail.dynamicResidential.title')}</a>
            <a href={`/${lang}/static-datacenter-proxy`} class="text-white/90 hover:text-white underline underline-offset-4">{t('detail.datacenter.title')}</a>
            <a href={`/${lang}/pricing`} class="text-white/90 hover:text-white underline underline-offset-4">{t('pricing.metadata.title')}</a>
          </div>
        </div>
      </div>
    </div>
  <!-- 波浪形状背景 -->
  <div class="relative w-full h-[300px]">
    <div class="absolute bottom-0 left-0 w-full ">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
        <path fill="#2a64f4" fill-opacity="1" d="M0,160L60,170.7C120,181,240,203,360,192C480,181,600,139,720,101.3C840,64,960,32,1080,26.7C1200,21,1320,43,1380,53.3L1440,64L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z" transform="scale(1, -1) translate(0, -320)"></path>
      </svg>
      
      
      
      
    </div>
  </div>
  <ProxyService
  subtitle={t('index.content.residentialProxy.title')}
  description=""
  descriptionList={t('index.content.residentialProxy.descriptionList')}
  features={(Array.isArray(t('index.content.residentialProxy.items')) ? t('index.content.residentialProxy.items') : [])}
/>

<br/>
<br/>
<ProxyService
  subtitle={t('index.content.dynamicProxy.title')}
  isEven={true}
  descriptionList={t('index.content.dynamicProxy.descriptionList')}
  features={(Array.isArray(t('index.content.dynamicProxy.items')) ? t('index.content.dynamicProxy.items') : [])}
/>
<br/>
<br/>
<ProxyService
  subtitle={t('index.content.dataCenterProxy.title')}

  descriptionList={t('index.content.dataCenterProxy.descriptionList')}
  features={(Array.isArray(t('index.content.dataCenterProxy.items')) ? t('index.content.dataCenterProxy.items') : [])}
/>

 
</Layout>
