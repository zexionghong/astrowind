---
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import PerformanceFeatures from '~/components/widgets/PerformanceFeatures.astro';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import DeductionMethods from '~/components/widgets/DeductionMethods.astro';
import { useTranslations } from '~/utils/i18n';

// Import images
import heroImage from '~/assets/images/proxies/2-1.webp';
import comparisonImage from '~/assets/images/proxies/2-2.webp';
// import googlesvg from "~/assets/images/proxies/google.svg"

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('dynamicResidentialProxy.metadata.title'),
  description: t('dynamicResidentialProxy.metadata.description'),
  ignoreTitleTemplate: true,
};

const stats = t('dynamicResidentialProxy.stats.items');
const faqs = t('dynamicResidentialProxy.faqs.items');

const whyChooseUsFeatures = t('dynamicResidentialProxy.whyChooseUs.features').map((feature, index) => ({
  ...feature,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-refresh-cw"><polyline points="23,4 23,10 17,10"></polyline><polyline points="1,20 1,14 7,14"></polyline><path d="M20.49,9A9,9,0,0,0,5.64,5.64L1,10m22,4L18.36,18.36A9,9,0,0,1,3.51,15"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trending-up"><polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline><polyline points="17,6 23,6 23,12"></polyline></svg>'
  ][index]
}));

const useCasesItems = t('dynamicResidentialProxy.useCases.items').map((item, index) => ({
  ...item,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27,6.96 12,12.01 20.73,6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"></path><path d="M21 12c.552 0 1-.448 1-1V5c0-.552-.448-1-1-1H3c-.552 0-1 .448-1 1v6c0 .552.448 1 1 1"></path><path d="M3 12v6c0 .552.448 1 1 1h16c.552 0 1-.448 1-1v-6"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M9 12l2 2 4-4"></path></svg>'
  ][index]
}));

const relatedLinks = [
  { href: `/${lang}/pricing`, label: lang === 'zh' ? '查看代理定价' : 'View Pricing' },
  { href: `/${lang}/static-residential-proxy`, label: lang === 'zh' ? '静态住宅代理' : 'Static Residential Proxy' },
  { href: `/${lang}/static-datacenter-proxy`, label: lang === 'zh' ? '静态数据中心代理' : 'Static Datacenter Proxy' },
  { href: `/${lang}/detail`, label: lang === 'zh' ? '产品详情' : 'Product Details' },
  { href: `/${lang}/blog`, label: lang === 'zh' ? '代理博客' : 'Proxy Blog' },
];
const geoMethodFaqs = lang === 'zh'
  ? [
      {
        q: '动态住宅代理更适合什么场景？',
        a: '更适合需要高覆盖、频繁切换出口和大规模并发采集的场景，如数据抓取、广告核验和区域可见性测试。',
      },
      {
        q: '动态住宅代理应该看哪些核心指标？',
        a: '建议关注覆盖成功率、封禁恢复时长和单位采集成本，按周观察趋势变化。',
      },
      {
        q: '怎样降低封禁导致的成本外溢？',
        a: '通过目标分层、重试策略分级和峰值窗口限流，可以降低重复请求开销。',
      },
    ]
  : [
      {
        q: 'What workloads are best for dynamic residential proxies?',
        a: 'They are best for high-coverage tasks requiring frequent IP rotation, such as scraping and ad verification.',
      },
      {
        q: 'Which metrics should teams monitor first?',
        a: 'Start with coverage success, recovery time after blocks, and unit collection cost.',
      },
      {
        q: 'How can teams reduce block-related cost spillover?',
        a: 'Use target segmentation, tiered retry policy, and peak-window throttling to control retry overhead.',
      },
    ];
const combinedFaqSchemaItems = [
  ...faqs,
  ...geoMethodFaqs.map((item) => ({
    title: item.q,
    description: item.a,
  })),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IPFlex',
      item: `https://ipflex.ink/${lang}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '动态住宅代理' : 'Dynamic Residential Proxy',
      item: `https://ipflex.ink/${lang}/dynamic-residential-proxy`,
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero Widget -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-b from-purple-600 to-purple-10"></div>
    <Hero
      image={{
        src: heroImage,
        alt: t('dynamicResidentialProxy.hero.title'),
      }}
      class="relative z-10 pt-16 pb-10"
    >
      <Fragment slot="title">
        <span class="block text-5xl font-bold text-white leading-tight" style="margin-left:50px;">
          {t('dynamicResidentialProxy.hero.title')}
        </span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="block text-left" style="margin-left:50px;">
          {t('dynamicResidentialProxy.hero.subtitle')}
        </span>
      </Fragment>
      <Fragment slot="content">
        <div class="text-gray-200 space-y-6 mt-6" style="margin-left:50px;">
          <ul class="space-y-3 text-lg">
            {t('dynamicResidentialProxy.hero.features').map((feature) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 pt-4">
             <a  href="https://dashboard.ipflex.ink/register" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              {t('dynamicResidentialProxy.hero.cta.primary')}
            </a>
          </div>
        </div>
      </Fragment>
    </Hero>
  </div>

  <!-- Stats Widget -->
  <Stats
    stats={stats}
    title={t('dynamicResidentialProxy.stats.title')}
    subtitle={t('dynamicResidentialProxy.stats.subtitle')}
    classes={{
      container: 'max-w-6xl',
      title: 'text-white',
      subtitle: 'text-purple-100',
    }}
  />

  <!-- Performance Features Widget -->
  <PerformanceFeatures
    title={t('dynamicResidentialProxy.performance.title')}
    description={t('dynamicResidentialProxy.performance.description')}
    features={t('dynamicResidentialProxy.performance.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('dynamicResidentialProxy.performance.title')
    }}
    classes={{
      container: 'py-16'
    }}
  />

  <!-- Why Choose Us Widget -->
  <WhyChooseUs
    title={t('dynamicResidentialProxy.whyChooseUs.title')}
    features={whyChooseUsFeatures}
  />

  <!-- Use Cases Widget -->
  <UseCases
    title={t('dynamicResidentialProxy.useCases.title')}
    useCases={useCasesItems}
  />

  <!-- 计费方式对比 -->
  <DeductionMethods lang={lang} deductionData={t('dynamicResidentialProxy.deductionMethods')} />

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '动态住宅代理选择清单' : 'Dynamic Residential Proxy Selection Checklist'}
    </h2>
    <p class="text-base leading-7 text-gray-700 dark:text-gray-300">
      {lang === 'zh'
        ? '动态住宅代理更适合覆盖率优先的任务，但是否值得投入，取决于封禁恢复能力、区域可达性和单位采集成本是否能在真实流量下保持平衡。'
        : 'Dynamic residential proxies are designed for coverage-heavy workloads, but the right choice depends on whether block recovery, geo reach, and unit collection cost stay balanced under real traffic.'}
    </p>
    <ol class="mt-4 list-decimal pl-5 space-y-2 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '先按国家、城市或目标站点类型拆分测试样本。' : 'Segment tests by country, city, or target-site type before comparing outcomes.'}</li>
      <li>{lang === 'zh' ? '同时跟踪覆盖成功率、封禁恢复时长和单位有效数据成本。' : 'Track coverage success, recovery time after blocking, and cost per valid record at the same time.'}</li>
      <li>{lang === 'zh' ? '只在峰值窗口和常态窗口都稳定时再放大并发。' : 'Increase concurrency only after both peak and normal windows remain stable.'}</li>
    </ol>
  </section>

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '动态住宅代理如何评估是否适配' : 'How to Evaluate Dynamic Residential Proxy Fit'}
    </h2>
    <div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'zh' ? '关键指标口径' : 'Key Metric Definitions'}
      </h3>
      <ul class="list-disc pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
        <li>{lang === 'zh' ? '覆盖成功率：目标页面/区域可访问任务占比。' : 'Coverage success: share of target pages/regions reached successfully.'}</li>
        <li>{lang === 'zh' ? '封禁恢复时长：触发限制后恢复可访问的时间。' : 'Recovery time: time to restore successful access after blocking events.'}</li>
        <li>{lang === 'zh' ? '单位采集成本：完成一条有效数据的综合成本。' : 'Unit collection cost: blended cost per valid collected record.'}</li>
      </ul>
    </div>
    <ol class="mt-4 list-decimal pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '先按国家/城市拆分目标并建立样本池。' : 'Segment targets by country/city and build sample pools.'}</li>
      <li>{lang === 'zh' ? '记录封禁触发点与恢复策略效果。' : 'Log block triggers and recovery strategy effectiveness.'}</li>
      <li>{lang === 'zh' ? '按周复盘覆盖率与单位成本趋势。' : 'Review weekly trends in coverage and unit cost.'}</li>
    </ol>
  </section>

  <!-- FAQs Widget -->
  <FAQs
    title={t('dynamicResidentialProxy.faqs.title')}
    subtitle={t('dynamicResidentialProxy.faqs.subtitle')}
    tagline={t('dynamicResidentialProxy.faqs.tagline')}
    items={faqs}
    schemaItems={combinedFaqSchemaItems}
    classes={{
      container: 'max-w-6xl py-16 bg-gray-50',
      title: 'text-3xl font-bold',
      subtitle: 'text-xl text-gray-600',
    }}
  />

  <section class="max-w-6xl mx-auto py-10 px-4 md:px-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '相关页面' : 'Related Pages'}</h2>
    <div class="flex flex-wrap gap-3">
      {relatedLinks.map((link) => (
        <a href={link.href} class="px-4 py-2 rounded-lg border border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100 transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '方法型常见问题' : 'Method FAQ'}</h2>
    <div class="space-y-3">
      {geoMethodFaqs.map((item) => (
        <div class="rounded-lg border border-gray-200 p-4 dark:border-slate-700">
          <h3 class="font-semibold text-gray-900 dark:text-white">{item.q}</h3>
          <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">{item.a}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-gray-500 dark:text-slate-400">
      {lang === 'zh' ? 'Last updated: 2026-03-05。来源：定价页、动态代理评估口径、帮助中心文档。' : 'Last updated: 2026-03-05. Sources: pricing framework, dynamic proxy evaluation baseline, and help center docs.'}
    </p>
  </section>

</Layout>

<style>
  .bg-gradient-to-b {
    background-size: 100% 100%;
    background-position: 0% 0%;
  }
  
  .from-purple-600 {
    --tw-gradient-from: #9333ea;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(147 51 234 / 0));
  }
  
  .to-purple-10 {
    --tw-gradient-to: #f3e8ff;
  }
</style>
