---
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import PerformanceFeatures from '~/components/widgets/PerformanceFeatures.astro';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import DeductionMethods from '~/components/widgets/DeductionMethods.astro';
import { useTranslations } from '~/utils/i18n';

// Import images
import heroImage from '~/assets/images/proxies/1-1.webp';
import comparisonImage from '~/assets/images/proxies/1-2.webp';
// import googlesvg from "~/assets/images/proxies/google.svg"

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('metadata.title'),
  description: t('metadata.description'),
  ignoreTitleTemplate: true,
};

const answerFirstSummary =
  lang === 'zh'
    ? '直接结论：如果业务依赖长期会话、账号一致性和低身份波动，静态住宅代理通常是优先选项。'
    : 'Answer first: static residential proxies are the best starting point when your workflow depends on long sessions, stable identity, and low profile volatility.';

const stats = t('stats.items');
const faqs = t('faqs.items');

const whyChooseUsFeatures = t('whyChooseUs.features').map((feature, index) => ({
  ...feature,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-dollar-sign"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-infinity"><path d="M13.833 8.875S15.085 7 18.043 7C21 7 23 9.5 23 12s-1.784 5-4.864 5-4.914-3.124-6.136-5c-1.222 1.876-3.296 5-6.446 5A4.79 4.79 0 0 1 1 12c0-2.5 2-5 4.957-5 2.958 0 4.208 1.875 4.208 1.875"></path></svg>'
  ][index]
}));

// 用于 UseCases Widget 的场景卡片数据直接采用 i18n 配置（url 也一并来源 i18n）
const useCasesItems = t('useCases.items').map((item, index) => ({
  ...item,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M9 12l2 2 4-4"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>'
  ][index]
}));

const relatedLinks = [
  { href: `/${lang}/pricing`, label: lang === 'zh' ? '查看代理定价' : 'View Pricing' },
  { href: `/${lang}/dynamic-residential-proxy`, label: lang === 'zh' ? '动态住宅代理' : 'Dynamic Residential Proxy' },
  { href: `/${lang}/static-datacenter-proxy`, label: lang === 'zh' ? '静态数据中心代理' : 'Static Datacenter Proxy' },
  { href: `/${lang}/detail`, label: lang === 'zh' ? '产品详情' : 'Product Details' },
  { href: `/${lang}/blog`, label: lang === 'zh' ? '代理博客' : 'Proxy Blog' },
];
const geoMethodFaqs = lang === 'zh'
  ? [
      {
        q: '静态住宅代理最适合哪些任务？',
        a: '最适合需要会话连续性和账号稳定身份的任务，如登录、支付校验、长期账号运营和低波动业务流程。',
      },
      {
        q: '如何量化静态住宅代理效果？',
        a: '建议持续跟踪会话保持率、登录成功率、异常验证触发率，并在峰值与常态窗口对比趋势。',
      },
      {
        q: '何时从小流量切到生产扩容？',
        a: '当样本窗口内关键指标连续稳定且重试开销可控时，再按业务优先级逐步扩容。',
      },
    ]
  : [
      {
        q: 'What workloads fit static residential proxies best?',
        a: 'They fit long-session workflows requiring identity consistency, such as login, checkout, and account operations.',
      },
      {
        q: 'How should teams measure static residential proxy performance?',
        a: 'Track session retention, login success ratio, and challenge trigger rate across peak and normal windows.',
      },
      {
        q: 'When should teams move from pilot traffic to production scale?',
        a: 'Scale after key metrics remain stable across the baseline window with controlled retry overhead.',
      },
    ];
const combinedFaqSchemaItems = [
  ...faqs,
  ...geoMethodFaqs.map((item) => ({
    title: item.q,
    description: item.a,
  })),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IPFlex',
      item: `https://ipflex.ink/${lang}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lang === 'zh' ? '静态住宅代理' : 'Static Residential Proxy',
      item: `https://ipflex.ink/${lang}/static-residential-proxy`,
    },
  ],
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero Widget -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-b from-blue-600 to-blue-10"></div>
    <Hero
      image={{
        src: heroImage,
        alt: t('hero.title'),
      }}
      class="relative z-10 pt-16 pb-10"
    >
      <Fragment slot="title">
        <span class="block text-5xl font-bold text-white leading-tight" style="margin-left:50px;">
          {t('hero.title')}
        </span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="block text-left" style="margin-left:50px;">
          {t('hero.subtitle')}
        </span>
      </Fragment>
      <Fragment slot="content">
        <div class="text-gray-200 space-y-6 mt-6" style="margin-left:50px;">
          <p class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-base font-medium leading-7 text-left text-white/95">
            {answerFirstSummary}
          </p>
          <ul class="space-y-3 text-lg">
            {t('hero.features').map((feature) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 pt-4">
             <a  href="https://dashboard.ipflex.ink/register" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              {t('hero.cta.primary')}
            </a>
            <!-- <a href="#" class="flex items-center gap-2 bg-white hover:bg-gray-100 text-gray-800 font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              <img src={googlesvg.src} alt="Google" class="w-5 h-5" />
              {t('hero.cta.secondary')}
            </a> -->
          </div>
        </div>
      </Fragment>
    </Hero>
  </div>

  <!-- Stats Widget -->
  <Stats
    stats={stats}
    title={t('stats.title')}
    subtitle={t('stats.subtitle')}
    classes={{
      container: 'max-w-6xl',
      title: 'text-white',
      subtitle: 'text-blue-100',
    }}
  />

  <!-- Performance Features Widget -->
  <PerformanceFeatures
    title={t('performance.title')}
    description={t('performance.description')}
    features={t('performance.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('performance.title')
    }}
    classes={{
      container: 'py-16'
    }}
  />

  <!-- Why Choose Us Widget -->
  <WhyChooseUs
    title={t('whyChooseUs.title')}
    features={whyChooseUsFeatures}
  />

  <!-- Use Cases Widget -->
   
  <UseCases
    title={t('useCases.title')}
    useCases={useCasesItems}
  />

  <!-- Unlimited Session Widget -->
  <!-- <PerformanceFeatures
    title={t('unlimitedSession.title')}
    description={t('unlimitedSession.description')}
    features={t('unlimitedSession.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('unlimitedSession.title')
    }}
    isReversed={true}
    classes={{
      container: 'py-16 bg-gray-50'
    }}
  /> -->

  <!-- 计费方式对比 -->
  <DeductionMethods lang={lang} deductionData={t('deductionMethods')} />

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '静态住宅代理选择清单' : 'Static Residential Proxy Selection Checklist'}
    </h2>
    <p class="text-base leading-7 text-gray-700 dark:text-gray-300">
      {lang === 'zh'
        ? '评估静态住宅代理时，建议先看业务是否真的需要稳定身份，再验证会话持续时间、登录成功率和异常验证触发率。只有这些指标在同一负载下持续稳定，静态住宅代理的价值才会真正体现。'
        : 'Evaluate static residential proxies by confirming whether the workflow truly needs identity persistence, then validate session duration, login success, and challenge trigger rate under the same workload assumptions.'}
    </p>
    <ol class="mt-4 list-decimal pl-5 space-y-2 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '确认目标任务是否依赖固定身份，例如登录、支付校验、账号运营。' : 'Confirm the target workflow depends on a persistent identity such as login, checkout validation, or account operations.'}</li>
      <li>{lang === 'zh' ? '在单一业务链路下记录 3 至 7 天会话稳定样本。' : 'Capture a 3-to-7 day stability baseline on one representative workflow.'}</li>
      <li>{lang === 'zh' ? '对比扩容前后成功率、重试开销和异常验证波动。' : 'Compare success ratio, retry overhead, and verification volatility before and after scale-up.'}</li>
    </ol>
  </section>

  <section class="max-w-6xl mx-auto px-4 md:px-6 py-10">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
      {lang === 'zh' ? '静态住宅代理如何评估是否适配' : 'How to Evaluate Static Residential Proxy Fit'}
    </h2>
    <p class="rounded-lg border border-blue-100 bg-blue-50/60 p-4 text-sm leading-6 text-blue-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
      {lang === 'zh'
        ? '直接结论：如果业务依赖长期会话稳定、账号一致性和低身份波动，优先选择静态住宅代理。'
        : 'Answer-first: choose static residential proxies when your workflow requires persistent sessions, identity consistency, and low profile volatility.'}
    </p>
    <div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'zh' ? '关键指标口径' : 'Key Metric Definitions'}
      </h3>
      <ul class="list-disc pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
        <li>{lang === 'zh' ? '会话保持率：同一账号流程中保持同出口身份的比例。' : 'Session retention: share of workflows maintaining the same outbound identity.'}</li>
        <li>{lang === 'zh' ? '登录成功率：目标平台登录流程一次完成比例。' : 'Login success ratio: one-pass completion rate for authentication workflows.'}</li>
        <li>{lang === 'zh' ? '异常验证触发率：验证码/二次验证触发占比。' : 'Challenge trigger rate: share of CAPTCHA or secondary verification events.'}</li>
      </ul>
    </div>
    <ol class="mt-4 list-decimal pl-5 space-y-1 text-sm leading-6 text-gray-700 dark:text-gray-300">
      <li>{lang === 'zh' ? '先用小流量做 3-7 天稳定性样本。' : 'Run a 3-7 day baseline with controlled low traffic.'}</li>
      <li>{lang === 'zh' ? '按业务流程记录成功率、会话稳定和重试开销。' : 'Track workflow success, session stability, and retry overhead.'}</li>
      <li>{lang === 'zh' ? '高峰与常态双窗口对比后再扩容。' : 'Compare peak and normal windows before scale-up.'}</li>
    </ol>
  </section>

  <!-- FAQs Widget -->
  <FAQs
    title={t('faqs.title')}
    subtitle={t('faqs.subtitle')}
    tagline={t('faqs.tagline')}
    items={faqs}
    schemaItems={combinedFaqSchemaItems}
    classes={{
      container: 'max-w-6xl py-16 bg-gray-50',
      title: 'text-3xl font-bold',
      subtitle: 'text-xl text-gray-600',
    }}
  />

  <section class="max-w-6xl mx-auto py-10 px-4 md:px-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '相关页面' : 'Related Pages'}</h2>
    <div class="flex flex-wrap gap-3">
      {relatedLinks.map((link) => (
        <a href={link.href} class="px-4 py-2 rounded-lg border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-6">
    <h2 class="text-2xl font-bold mb-4">{lang === 'zh' ? '方法型常见问题' : 'Method FAQ'}</h2>
    <div class="space-y-3">
      {geoMethodFaqs.map((item) => (
        <div class="rounded-lg border border-gray-200 p-4 dark:border-slate-700">
          <h3 class="font-semibold text-gray-900 dark:text-white">{item.q}</h3>
          <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">{item.a}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-gray-500 dark:text-slate-400">
      {lang === 'zh' ? 'Last updated: 2026-03-05。来源：定价页、产品页基线方法、帮助中心文档。' : 'Last updated: 2026-03-05. Sources: pricing framework, product baseline method, and help center docs.'}
    </p>
  </section>

</Layout>

<style>
  .bg-gradient-to-b {
    background-size: 100% 100%;
    background-position: 0% 0%;
  }
  
  .from-purple-900 {
    --tw-gradient-from: #581c87;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(88 28 135 / 0));
  }
  
  .to-blue-900 {
    --tw-gradient-to: #1e3a8a;
  }
  
  .from-blue-900 {
    --tw-gradient-from: #1e3a8a;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(30 58 138 / 0));
  }
  
  .to-purple-900 {
    --tw-gradient-to: #581c87;
  }
</style>
