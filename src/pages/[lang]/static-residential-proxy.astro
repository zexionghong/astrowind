---
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import PerformanceFeatures from '~/components/widgets/PerformanceFeatures.astro';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import DeductionMethods from '~/components/widgets/DeductionMethods.astro';
import { useTranslations } from '~/utils/i18n';

// Import images
import heroImage from '~/assets/images/proxies/1-1.webp';
import comparisonImage from '~/assets/images/proxies/1-2.webp';
// import googlesvg from "~/assets/images/proxies/google.svg"

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('metadata.title'),
  description: t('metadata.description'),
  ignoreTitleTemplate: true,
};

const stats = t('stats.items');
const faqs = t('faqs.items');

const whyChooseUsFeatures = t('whyChooseUs.features').map((feature, index) => ({
  ...feature,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-dollar-sign"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-infinity"><path d="M13.833 8.875S15.085 7 18.043 7C21 7 23 9.5 23 12s-1.784 5-4.864 5-4.914-3.124-6.136-5c-1.222 1.876-3.296 5-6.446 5A4.79 4.79 0 0 1 1 12c0-2.5 2-5 4.957-5 2.958 0 4.208 1.875 4.208 1.875"></path></svg>'
  ][index]
}));

const useCasesItems = t('useCases.items').map((item, index) => ({
  ...item,
  icon: [
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M9 12l2 2 4-4"></path></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>',
    '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>'
  ][index]
}));
---

<Layout metadata={metadata}>
  <!-- Hero Widget -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-b from-blue-600 to-blue-10"></div>
    <Hero
      image={{
        src: heroImage,
        alt: t('hero.title'),
      }}
      class="relative z-10 pt-16 pb-10"
    >
      <Fragment slot="title">
        <div class="flex flex-col items-start gap-2 mb-6" style="margin-left:50px;">
          <h1 class="text-5xl font-bold text-white leading-tight">
            {t('hero.title')}
          </h1>
        </div>
      </Fragment>
      <Fragment slot="subtitle">
        <div class="text-gray-200 space-y-6" style="margin-left:50px;">
            <p class="text-xl font-light leading-relaxed text-left">
            {t('hero.subtitle')}
          </p>
          <ul class="space-y-3 text-lg">
            {t('hero.features').map((feature) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 pt-4">
             <a  href="https://dashboard.ipflex.ink/register" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              {t('hero.cta.primary')}
            </a>
            <!-- <a href="#" class="flex items-center gap-2 bg-white hover:bg-gray-100 text-gray-800 font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              <img src={googlesvg.src} alt="Google" class="w-5 h-5" />
              {t('hero.cta.secondary')}
            </a> -->
          </div>
        </div>
      </Fragment>
    </Hero>
  </div>

  <!-- Stats Widget -->
  <Stats
    stats={stats}
    title={t('stats.title')}
    subtitle={t('stats.subtitle')}
    classes={{
      container: 'max-w-6xl',
      title: 'text-white',
      subtitle: 'text-blue-100',
    }}
  />

  <!-- Performance Features Widget -->
  <PerformanceFeatures
    title={t('performance.title')}
    description={t('performance.description')}
    features={t('performance.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('performance.title')
    }}
    classes={{
      container: 'py-16'
    }}
  />

  <!-- Why Choose Us Widget -->
  <WhyChooseUs
    title={t('whyChooseUs.title')}
    features={whyChooseUsFeatures}
  />

  <!-- Use Cases Widget -->
   
  <UseCases
    title={t('useCases.title')}
    useCases={useCasesItems}
  />

  <!-- Unlimited Session Widget -->
  <!-- <PerformanceFeatures
    title={t('unlimitedSession.title')}
    description={t('unlimitedSession.description')}
    features={t('unlimitedSession.features').map(feature => ({ title: feature }))}
    image={{
      src: comparisonImage,
      alt: t('unlimitedSession.title')
    }}
    isReversed={true}
    classes={{
      container: 'py-16 bg-gray-50'
    }}
  /> -->

  <!-- 计费方式对比 -->
  <DeductionMethods lang={lang} deductionData={t('deductionMethods')} />

  <!-- FAQs Widget -->
  <FAQs
    title={t('faqs.title')}
    subtitle={t('faqs.subtitle')}
    tagline={t('faqs.tagline')}
    items={faqs}
    classes={{
      container: 'max-w-6xl py-16 bg-gray-50',
      title: 'text-3xl font-bold',
      subtitle: 'text-xl text-gray-600',
    }}
  />

</Layout>

<style>
  .bg-gradient-to-b {
    background-size: 100% 100%;
    background-position: 0% 0%;
  }
  
  .from-purple-900 {
    --tw-gradient-from: #581c87;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(88 28 135 / 0));
  }
  
  .to-blue-900 {
    --tw-gradient-to: #1e3a8a;
  }
  
  .from-blue-900 {
    --tw-gradient-from: #1e3a8a;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(30 58 138 / 0));
  }
  
  .to-purple-900 {
    --tw-gradient-to: #581c87;
  }
</style>
