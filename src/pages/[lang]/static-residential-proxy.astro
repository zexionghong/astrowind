---
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import PerformanceFeatures from '~/components/widgets/PerformanceFeatures.astro';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import PricingTable from '~/components/widgets/PricingTable.astro';
// 计费方式对比组件
import DeductionMethods from '~/components/widgets/DeductionMethods.astro';
import PricingCards from '~/components/widgets/PricingCards.astro';

// Import images
import heroImage from '~/assets/images/hero.webp';
import proxyImage from '~/assets/images/proxy1.png';
import comparisonImage from '~/assets/images/proxy1.png'; // 使用已有的图片作为替代

const metadata = {
  title: '静态住宅代理 - 高稳定性IP解决方案 | IPFlex',
  description: 'IPFlex静态住宅代理，专为跨境电商、数据采集等场景设计，提供高稳定性、低封禁风险的住宅IP服务。支持中国及全球地区，助力业务合规高效。',
  ignoreTitleTemplate: true,
};

const stats = [
  { amount: '9000万+', title: '全球住宅IP资源' },
  { amount: '200+', title: '覆盖国家/地区' },
  { amount: '99.9%', title: '服务可用性' },
  { amount: '24/7', title: '技术支持' },
];

const features = [
  {
    title: '全球IP资源',
    description: '覆盖200+国家和地区，9000万+真实住宅IP',
    icon: 'tabler:globe',
  },
  {
    title: '高匿名性',
    description: '真实住宅网络出口，极难被识别为代理',
    icon: 'tabler:shield-lock',
  },
  {
    title: 'IP稳定性',
    description: 'IP长期不变，适合账号养护和长期业务',
    icon: 'tabler:clock',
  },
  {
    title: '企业级带宽',
    description: '低延迟高并发，保障业务连续性',
    icon: 'tabler:rocket',
  },
  {
    title: '灵活套餐',
    description: '按需付费，性价比高',
    icon: 'tabler:coin',
  },
  {
    title: '技术支持',
    description: '7x24小时技术支持，快速响应',
    icon: 'tabler:headset',
  },
];

const faqs = [
  {
    title: '静态住宅代理和动态住宅代理有什么区别？',
    description: '静态住宅代理的IP长期不变，适合需要长期、稳定IP的业务场景；动态住宅代理的IP会定期更换，适合大规模数据抓取等灵活性需求。'
  },
  {
    title: '静态住宅代理适合哪些应用场景？',
    description: '适用于跨境电商账号养护、社交媒体运营、长期数据采集、广告投放等对IP稳定性要求高的场景。'
  },
  {
    title: '如何购买和使用静态住宅代理？',
    description: '注册IPFlex账号后，可在控制台选择静态住宅代理套餐，获取IP和端口信息，按需配置到您的业务系统中。'
  }
];

const steps = [
  {
    title: '注册账号',
    description: '填写基本信息，快速注册IPFlex账号',
    icon: 'tabler:user-plus',
  },
  {
    title: '选择套餐',
    description: '根据业务需求选择合适的静态住宅代理套餐',
    icon: 'tabler:package',
  },
  {
    title: '获取代理',
    description: '在控制台获取代理IP和端口信息',
    icon: 'tabler:key',
  },
  {
    title: '开始使用',
    description: '将代理配置到您的业务系统中即可使用',
    icon: 'tabler:check',
  },
];

const comparison = {
  title: '服务对比',
  subtitle: 'IPFlex静态住宅代理 vs 传统动态住宅代理',
  items: [
    {
      title: 'IP类型',
      description: '真实住宅IP，长期不变 vs 住宅IP，定期更换',
    },
    {
      title: '适用场景',
      description: '账号养护、长期业务 vs 大规模抓取、短期任务',
    },
    {
      title: '匿名性',
      description: '极高 vs 高',
    },
    {
      title: '带宽',
      description: '企业级，独享 vs 共享',
    },
    {
      title: '价格',
      description: '灵活套餐，按需付费 vs 按流量计费',
    },
  ],
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-b from-blue-600 to-blue-10"></div>
    <Hero
      image={{
        src: heroImage,
        alt: '住宅代理示意图',
      }}
      class="relative z-10 pt-16 pb-10"
    >
      <Fragment slot="title">
        <div class="flex flex-col items-start gap-2 mb-6">
          <h1 class="text-5xl font-bold text-white leading-tight">
            Residential Proxies
          </h1>
        </div>
      </Fragment>
      <Fragment slot="subtitle">
        <div class="text-gray-200 space-y-6">
          <p class="text-xl font-light leading-relaxed">
            The fastest and largest Residential Proxies network, made of 175M+ highest-quality proxies.
          </p>
          <ul class="space-y-3 text-lg">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-lg">Free geo-targeting</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-lg">Fastest proxies in the market</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-lg">Real profile, human-like Residential IPs</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[#00E062]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-lg">Quality assurance framework for most reliable IPs</span>
            </li>
          </ul>
          <div class="flex items-center gap-4 pt-4">
            <a href="#" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              Try Oxylabs today
            </a>
            <a href="#" class="flex items-center gap-2 bg-white hover:bg-gray-100 text-gray-800 font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              <img src="/images/google.svg" alt="Google" class="w-5 h-5" />
              Get started with Google
            </a>
          </div>
        </div>
      </Fragment>
    </Hero>
  </div>

    <!-- Stats Widget -->
    <Stats
      stats={stats}
      title="全球资源覆盖"
      subtitle="IPFlex拥有海量优质住宅IP资源，为您的业务保驾护航"
      classes={{
        container: 'max-w-6xl',
        title: 'text-white',
        subtitle: 'text-blue-100',
      }}
    />


     <!-- Performance Features Widget -->
  <PerformanceFeatures
    title="卓越性能，无限制"
    description="使用互联网服务提供商代理，被封锁的情况非常罕见，因为网站不希望限制来自知名自治系统号码的流量。由AT&T、Comcast、Lumen和Frontier等高级自治系统号码提供商提供的互联网服务提供商代理旨在以99.9%的成功率解锁最具挑战性的目标。"
    features={[
      { title: '半专用代理' },
      { title: '不限时长会话' },
      { title: 'HTTP、HTTPS和SOCKS5协议' },
      { title: 'UDP和TCP连接' }
    ]}
    image={{
      src: comparisonImage,
      alt: '代理服务对比'
    }}
    classes={{
      container: 'py-16'
    }}
  />
  <!-- Why Choose Us Widget -->
  <WhyChooseUs
    title="为什么要选择IPFlex？"
    features={[
      {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-dollar-sign"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>',
      title: '性价比高',
      description: '灵活套餐，按需付费，满足不同业务需求，经济实惠。'
      },
      {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
      title: '地区资源多',
      description: '覆盖全球200+国家和地区，IP资源丰富，满足多样化需求。'
      },
      {
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-infinity"><path d="M13.833 8.875S15.085 7 18.043 7C21 7 23 9.5 23 12s-1.784 5-4.864 5-4.914-3.124-6.136-5c-1.222 1.876-3.296 5-6.446 5A4.79 4.79 0 0 1 1 12c0-2.5 2-5 4.957-5 2.958 0 4.208 1.875 4.208 1.875"></path></svg>',
      title: '无限带宽',
      description: '按代理计费模式下，流量费用无额外收费，无限带宽畅享。'
      }
    ]}
  />

  <!-- Use Cases Widget -->
