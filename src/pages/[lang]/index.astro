---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';
import HeroTitle from '~/components/widgets/HeroTitle.astro';
import UsageScenarios from '~/components/widgets/UsageScenarios.astro';
import SimpleReferralWidget from '~/components/widgets/SimpleReferralWidget.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  description: lang === 'zh'
    ? 'IPFlex 提供企业级网络接入能力，覆盖静态住宅、动态住宅与数据中心节点。支持 HTTP/SOCKS5、全球节点、城市级定位、API 接入、弹性计费、团队管理、策略编排和实时监控，适用于数据采集、广告验证、跨境电商、品牌保护、自动化运营及长期稳定业务交付。'
    : t('index.metadata.description'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="relative min-h-screen before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:bottom-0 before:bg-[url('/images/background/bg.webp')] before:bg-cover before:bg-center before:bg-no-repeat before:-z-10">
    <!-- Hero Widget ******************* -->
    <Hero
      actions={[
        {
          variant: 'primary',
          text: t('index.hero.primaryAction'),
          href: 'https://dashboard.ipflex.ink/register',
          target: '_blank',
        },
        {
          text: t('index.hero.secondaryAction'),
          href: `/${lang}/detail`,
          type: 'button',
        },
      ]}
    >
      <Fragment slot="title" set:html={t('index.hero.title')} />
      <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
    </Hero>

    <!-- Intro Widget ******************* -->
    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-10 text-base leading-7 text-muted dark:text-slate-300">
      <h2 class="text-2xl font-bold tracking-tight text-heading dark:text-white mb-4">{t('index.intro.title')}</h2>
      <p class="mb-3">{t('index.intro.p1')}</p>
      <p>{t('index.intro.p2')}</p>
    </section>

    <!-- Note Widget ******************* -->
    <ProxyContent
      residentialProxy={{
        title: t('index.content.residentialProxyTitle'),
        subtitle: t('index.content.residentialProxy.title'),
        description: "",
        descriptionList: t('index.content.residentialProxy.descriptionList'),
        features: (Array.isArray(t('index.content.residentialProxy.items')) ? t('index.content.residentialProxy.items') : [])
      }}
      dynamicProxy={{
        subtitle: t('index.content.dynamicProxy.title'),
        description: "",
        descriptionList: t('index.content.dynamicProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dynamicProxy.items')) ? t('index.content.dynamicProxy.items') : [])
      }}
      dataCenterProxy={{
        title: t('index.content.dataCenterProxyTile'),
        subtitle: t('index.content.dataCenterProxy.title'),
        description: "",
        descriptionList: t('index.content.dataCenterProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dataCenterProxy.items')) ? t('index.content.dataCenterProxy.items') : [])
      }}
    />
    <!-- <Note /> -->

    <!-- Steps Widget ****************** -->
    <SetpsContent lang={lang} />

    <!-- Features Widget *************** -->
    <!-- Advantages Widget ************* -->
    <Advantages
      title={t('index.features.title')}
      subtitle={t('index.features.subtitle')}
      items={t('index.features.items')}
    />
   


    <!-- Stats Widget ****************** -->
    <DataStats
      items={t("index.stats.items")}
    />

    <!-- HeroTitle Widget ************** -->
     <div>
    <HeroTitle
      title={t('index.callToAction.title')}
      subtitle={`${t('index.callToAction.subtitle1')}\n${t('index.callToAction.subtitle2')}`}
      buttonText={t('index.callToAction.primaryAction')}
      buttonHref="https://dashboard.ipflex.ink/register"
    />

    <!-- UsageScenarios Widget ********* -->
    <UsageScenarios
      title={t('index.features2.title')}
      subtitle={t('index.features2.subtitle')}
      items={t('index.features2.items')}
    />
    <br />
  </div>

  </div>

  <section class="mx-auto max-w-6xl px-4 py-10 text-base leading-7 text-muted dark:text-slate-300">
    <h2 class="mb-3 text-2xl font-bold text-heading dark:text-white">
      {lang === 'zh' ? '企业团队如何规划代理接入' : 'How Enterprise Teams Plan Proxy Onboarding'}
    </h2>
    <p class="rounded-lg border border-blue-100 bg-blue-50/60 p-4 text-sm leading-6 text-blue-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
      {lang === 'zh'
        ? '直接结论：代理接入的优先级应是“先稳定，再扩容，再降本”。实际执行中建议先验证成功率与重试开销，再扩展地域与并发，最后按业务周期优化单位成本。'
        : 'Answer-first: proxy onboarding should prioritize stability first, scale second, and cost optimization third. Validate success ratio and retry overhead before expanding regions and concurrency.'}
    </p>
    <p>
      {lang === 'zh'
        ? '企业接入代理网络时，建议先完成基线测试、重试策略设计、地域路由验证、监控指标定义与分阶段放量。通过“先验证再扩容”的方式，可以在早期发现可用性瓶颈、控制接入成本，并降低上线后的运维风险。'
        : 'Enterprise proxy onboarding best practice includes baseline testing, retry policy design, regional routing validation, observability setup, and phased traffic rollout. This execution model improves stability, controls cost, and reduces operational risk.'}
    </p>
    <p class="mt-3">
      {lang === 'zh'
        ? '在长期运行阶段，团队还应建立明确的职责分工、变更评审流程、故障应急预案和周期性质量巡检机制。相比临时修补，标准化流程通常能在多区域、多业务并行时提供更稳定的交付质量与更高的排障效率。'
        : 'For long-term operations, teams should also establish clear ownership, change review, incident response playbooks, and weekly quality checkpoints. Consistent process discipline usually delivers better reliability than ad-hoc fixes, especially when projects grow across multiple regions, products, and stakeholder groups.'}
    </p>
    <p class="mt-3">
      {lang === 'zh'
        ? '执行建议是先统一产品、研发与运营的成功指标，再按周跟踪关键趋势变化。这样可以在扩容过程中保持节奏一致，减少跨团队沟通损耗，并让交付质量更可预测。'
        : 'Execution note: align success metrics across product, engineering, and operations teams before scale-up, then track trend changes weekly to keep rollout quality predictable.'}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      {lang === 'zh'
        ? '运营质量基线建议包含：请求成功率阈值、中位响应时间目标、重试上限与故障响应负责人。上线前定义清楚，并按周复盘这些指标，能让交付更稳定。'
        : 'Operational quality baseline: define request success threshold, median response target, retry limit, and incident response ownership before large-scale rollout, then review these indicators weekly to keep delivery stable.'}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      {lang === 'zh'
        ? '治理基线建议包括：标准化发布检查清单、明确审批边界、沉淀排障手册，并在扩容阶段保持跨团队沟通节奏一致。'
        : 'Governance baseline: standardize release checklist, clarify approval boundaries, document troubleshooting playbooks, and keep cross-team communication predictable during expansion.'}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      {lang === 'zh'
        ? '决策质量还依赖稳定的复盘节奏。每周指标复盘、每月容量检查、每季度架构回顾，有助于更早识别潜在风险并提升执行确定性。'
        : 'Decision quality also depends on consistent review rhythm. Weekly KPI review, monthly capacity check, and quarterly architecture retrospectives help teams spot hidden risks early and maintain execution confidence as business scope expands.'}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      {lang === 'zh'
        ? '相比单点工具选择，更重要的是执行纪律。职责清晰、节奏稳定、决策可追溯的团队，通常能获得更高的一致性和更快的故障恢复效率。'
        : 'Execution discipline matters more than isolated tooling choices. Teams with clear ownership, stable review cadence, and documented decision trails usually deliver better consistency, faster incident recovery, and lower coordination overhead during expansion.'}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      {lang === 'zh'
        ? '管理层可以通过简化治理规则提升整体效率，例如减少含糊条款、明确审批路径、统一文档标准。这种方式能降低协作摩擦，并在优先级变化时保持执行稳定。'
        : 'Leadership teams often improve outcomes by simplifying governance: fewer ambiguous rules, clearer approval paths, and consistent documentation standards. This approach reduces friction, improves collaboration quality, and supports steady execution when priorities shift across departments.'}
    </p>
    <div class="mt-5 rounded-lg border border-gray-200 bg-white p-4 text-sm leading-6 text-gray-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
      <h3 class="mb-2 text-base font-semibold text-heading dark:text-white">
        {lang === 'zh' ? '引用友好指标口径（建议统一）' : 'Citation-Ready Metric Definitions'}
      </h3>
      <ul class="list-disc space-y-1 pl-5">
        <li>{lang === 'zh' ? '成功率：完成请求数 / 总请求数（按业务任务口径聚合）。' : 'Success ratio: completed requests divided by total requests under the same workflow scope.'}</li>
        <li>{lang === 'zh' ? '中位时延：P50 请求完成时间，用于观察日常体验稳定性。' : 'Median latency: P50 completion time for day-to-day stability tracking.'}</li>
        <li>{lang === 'zh' ? '重试开销：因失败触发的额外请求占比，用于评估成本外溢。' : 'Retry overhead: additional retry traffic share caused by failures.'}</li>
        <li>{lang === 'zh' ? '月度单位成本：完成一个业务流程的平均月度成本。' : 'Monthly unit cost: average monthly cost per completed workflow.'}</li>
      </ul>
      <p class="mt-3 text-xs text-gray-500 dark:text-slate-400">
        {lang === 'zh'
          ? '证据入口：可结合定价页、博客方法文档与帮助中心进行统一评估与复盘。'
          : 'Evidence sources: pricing page, methodology blog posts, and help center documentation.'}
      </p>
    </div>
    <div class="mt-4 grid gap-2 text-sm">
      <a class="text-blue-700 underline underline-offset-2 dark:text-blue-300" href={`/${lang}/pricing`}>
        {lang === 'zh' ? '查看定价与套餐评估框架' : 'View pricing and plan evaluation framework'}
      </a>
      <a class="text-blue-700 underline underline-offset-2 dark:text-blue-300" href={`/${lang}/blog/enterprise-proxy-onboarding-playbook-2026${lang === 'en' ? '-en' : ''}`}>
        {lang === 'zh' ? '查看接入执行手册（2026）' : 'Read the onboarding execution playbook (2026)'}
      </a>
      <a class="text-blue-700 underline underline-offset-2 dark:text-blue-300" href="https://docs.ipflex.ink/" target="_blank" rel="noopener noreferrer">
        {lang === 'zh' ? '查看帮助中心与集成文档' : 'Open help center and integration docs'}
      </a>
    </div>
    {lang === 'zh' && (
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        企业接入执行建议：先明确责任归属，定义可量化目标，设置质量检查点，并保持跨团队稳定复盘节奏。这类治理基线有助于提升协作清晰度、交付可预测性和长期运行稳定性。
      </p>
    )}
    {lang === 'zh' && (
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        当决策记录完整、交接标准明确、升级路径在高峰前经过演练时，团队执行质量通常会明显提升。通过每周复盘、每月容量校验、每季度回顾的固定节奏，可以更早识别隐性风险，并在需求变化时保持实施质量稳定。
      </p>
    )}
  </section>

  <!-- FAQs Widget ******************* -->
  <FAQs
    title={t('index.faqs.title')}
    subtitle={t('index.faqs.subtitle')}
    tagline={t('index.faqs.sub')}
    classes={{ container: 'max-w-6xl' }}
    items={t("index.faqs.items")}
  />

  <!-- Simple Referral Widget ********** -->
  <SimpleReferralWidget lang={lang} />
</Layout>
