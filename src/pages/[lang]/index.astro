---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import DataStats from '~/components/widgets/DataStats.astro';
import { useTranslations } from '~/utils/i18n';
import ProxyContent from '~/components/widgets/ProxyContent.astro';
import SetpsContent from '~/components/widgets/SetpsContent.astro';
import Advantages from '~/components/widgets/Advantages.astro';
import HeroTitle from '~/components/widgets/HeroTitle.astro';
import UsageScenarios from '~/components/widgets/UsageScenarios.astro';
import SimpleReferralWidget from '~/components/widgets/SimpleReferralWidget.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang='zh' } = Astro.params;
const t = await useTranslations(lang);
const metadata = {
  title: t('index.metadata.title'),
  description: lang === 'zh'
    ? 'IPFlex 提供企业级网络接入能力，覆盖静态住宅、动态住宅与数据中心节点。支持 HTTP/SOCKS5、全球节点、城市级定位、API 接入、弹性计费、团队管理、策略编排和实时监控，适用于数据采集、广告验证、跨境电商、品牌保护、自动化运营及长期稳定业务交付。'
    : t('index.metadata.description'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="relative min-h-screen before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:bottom-0 before:bg-[url('/images/background/bg.webp')] before:bg-cover before:bg-center before:bg-no-repeat before:-z-10">
    <!-- Hero Widget ******************* -->
    <Hero
      actions={[
        {
          variant: 'primary',
          text: t('index.hero.primaryAction'),
          href: 'https://dashboard.ipflex.ink/register',
          target: '_blank',
        },
        {
          text: t('index.hero.secondaryAction'),
          href: `/${lang}/detail`,
          type: 'button',
        },
      ]}
    >
      <Fragment slot="title" set:html={t('index.hero.title')} />
      <Fragment slot="subtitle" set:html={t('index.hero.subtitle')} />
    </Hero>

    <!-- Intro Widget ******************* -->
    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-10 text-base leading-7 text-muted dark:text-slate-300">
      <h2 class="text-2xl font-bold tracking-tight text-heading dark:text-white mb-4">{t('index.intro.title')}</h2>
      <p class="mb-3">{t('index.intro.p1')}</p>
      <p>{t('index.intro.p2')}</p>
    </section>

    <!-- Note Widget ******************* -->
    <ProxyContent
      residentialProxy={{
        title: t('index.content.residentialProxyTitle'),
        subtitle: t('index.content.residentialProxy.title'),
        description: "",
        descriptionList: t('index.content.residentialProxy.descriptionList'),
        features: (Array.isArray(t('index.content.residentialProxy.items')) ? t('index.content.residentialProxy.items') : [])
      }}
      dynamicProxy={{
        subtitle: t('index.content.dynamicProxy.title'),
        description: "",
        descriptionList: t('index.content.dynamicProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dynamicProxy.items')) ? t('index.content.dynamicProxy.items') : [])
      }}
      dataCenterProxy={{
        title: t('index.content.dataCenterProxyTile'),
        subtitle: t('index.content.dataCenterProxy.title'),
        description: "",
        descriptionList: t('index.content.dataCenterProxy.descriptionList'),
        features: (Array.isArray(t('index.content.dataCenterProxy.items')) ? t('index.content.dataCenterProxy.items') : [])
      }}
    />
    <!-- <Note /> -->

    <!-- Steps Widget ****************** -->
    <SetpsContent lang={lang} />

    <!-- Features Widget *************** -->
    <!-- Advantages Widget ************* -->
    <Advantages
      title={t('index.features.title')}
      subtitle={t('index.features.subtitle')}
      items={t('index.features.items')}
    />
   


    <!-- Stats Widget ****************** -->
    <DataStats
      items={t("index.stats.items")}
    />

    <!-- HeroTitle Widget ************** -->
     <div>
    <HeroTitle
      title={t('index.callToAction.title')}
      subtitle={`${t('index.callToAction.subtitle1')}\n${t('index.callToAction.subtitle2')}`}
      buttonText={t('index.callToAction.primaryAction')}
      buttonHref="https://dashboard.ipflex.ink/register"
    />

    <!-- UsageScenarios Widget ********* -->
    <UsageScenarios
      title={t('index.features2.title')}
      subtitle={t('index.features2.subtitle')}
      items={t('index.features2.items')}
    />
    <br />
  </div>

  </div>

  <section class="mx-auto max-w-6xl px-4 py-10 text-base leading-7 text-muted dark:text-slate-300">
    <h2 class="mb-3 text-2xl font-bold text-heading dark:text-white">
      {lang === 'zh' ? '企业团队如何规划代理接入' : 'How Enterprise Teams Plan Proxy Onboarding'}
    </h2>
    <p>
      {lang === 'zh'
        ? '企业接入代理网络时，建议先完成基线测试、重试策略设计、地域路由验证、监控指标定义与分阶段放量。通过“先验证再扩容”的方式，可以在早期发现可用性瓶颈、控制接入成本，并降低上线后的运维风险。'
        : 'Enterprise proxy onboarding best practice includes baseline testing, retry policy design, regional routing validation, observability setup, and phased traffic rollout. This execution model improves stability, controls cost, and reduces operational risk.'}
    </p>
    <p class="mt-3">
      {lang === 'zh'
        ? '在长期运行阶段，团队还应建立明确的职责分工、变更评审流程、故障应急预案和周期性质量巡检机制。相比临时修补，标准化流程通常能在多区域、多业务并行时提供更稳定的交付质量与更高的排障效率。'
        : 'For long-term operations, teams should also establish clear ownership, change review, incident response playbooks, and weekly quality checkpoints. Consistent process discipline usually delivers better reliability than ad-hoc fixes, especially when projects grow across multiple regions, products, and stakeholder groups.'}
    </p>
    <p class="mt-3">
      {lang === 'zh'
        ? 'Execution note: align success metrics across product, engineering, and operations teams before scale-up, then track trend changes weekly to keep rollout quality predictable.'
        : 'Execution note: align success metrics across product, engineering, and operations teams before scale-up, then track trend changes weekly to keep rollout quality predictable.'}
    </p>
  </section>

  <!-- FAQs Widget ******************* -->
  <FAQs
    title={t('index.faqs.title')}
    subtitle={t('index.faqs.subtitle')}
    tagline={t('index.faqs.sub')}
    classes={{ container: 'max-w-6xl' }}
    items={t("index.faqs.items")}
  />

  <!-- Simple Referral Widget ********** -->
  <SimpleReferralWidget lang={lang} />
</Layout>
