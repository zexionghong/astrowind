---
import Layout from '~/layouts/PageLayout.astro';
import Form from '~/components/ui/Form.astro';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang } from '~/utils/schema';
import registerBg from '~/assets/images/bg/register.png';

export async function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const url = Astro.url;
const urlInviteCode = url.searchParams.get('invite') || url.searchParams.get('ref') || url.searchParams.get('code');
const metadata = {
  title: t('register.title'),
  description: t('register.description'),
  robots: {
    index: false,
    follow: false,
  },
  ignoreTitleTemplate: true,
};

const inviteCode = urlInviteCode;

const handleRegisterSubmit = `async (e, form) => {
  e.preventDefault();
  
  const submitBtn = form.querySelector('button[type="submit"]');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = '${lang === 'zh' ? '注册中...' : 'Registering...'}';
  }

  try {
    const formData = new FormData(form);
    
    // 映射字段名到后端期望的格式
    const username = formData.get('username');
    const email = formData.get('email');
    const password = formData.get('password');
    const invite = formData.get('invite');
    
    const params = new URLSearchParams();
    params.append('username', username);
    params.append('name', username);
    params.append('email', email);
    params.append('password', password);
    params.append('confirm_password', password);
    if (invite) {
      params.append('invite_code', invite);
    }
    
    const response = await fetch('https://api.ipflex.ink/user/register_link', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: params.toString()
    });

    const result = await response.json();
    console.log('Registration result:', result);
  
    if (result.code === 0) {
      alert('${lang === 'zh' ? '注册成功!请查看邮箱中的验证邮件完成注册。' : 'Registration successful! Please check your email for verification.'}');
    } else {
      alert(result.msg || '${lang === 'zh' ? '注册失败，请重试' : 'Registration failed, please try again'}');
    }
  } catch (error) {
    console.error('Registration error:', error);
    alert('${lang === 'zh' ? '注册失败，请重试' : 'Registration failed, please try again'}');
  } finally {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = '${lang === 'zh' ? '注 册' : 'Register'}';
    }
  }
}`;
---

<Layout metadata={metadata} has_header={false} has_footer={false}>
  <div id="page-root" data-lang={lang} class="min-h-screen flex">
    <!-- 左侧背景图和文案 -->
    <aside class="hidden md:block relative" style="width: min(45%, 714px);">
      <img src={registerBg.src} alt={t('register.sidebar.alt')} class="h-screen w-full object-cover object-left" />
      <div class="absolute inset-0 flex flex-col justify-between p-12">
        <div>
          <p class="text-xl font-medium text-gray-800 mb-16 text-center">{t('register.sidebar.tagline')}</p>
          
          <div class="space-y-3">
            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{t('register.sidebar.fastStable.title')}</p>
                <p class="text-sm text-gray-600">{t('register.sidebar.fastStable.desc')}</p>
              </div>
            </div>

            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{t('register.sidebar.safeAnonymous.title')}</p>
                <p class="text-sm text-gray-600">{t('register.sidebar.safeAnonymous.desc')}</p>
              </div>
            </div>

            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{t('register.sidebar.payAsYouGo.title')}</p>
                <p class="text-sm text-gray-600">{t('register.sidebar.payAsYouGo.desc')}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-11 p-4 bg-blue-500/60 rounded-xl">
          <p class="text-sm font-medium mb-1 text-white">{t('register.sidebar.newUser.title')}</p>
          <div class="flex items-baseline space-x-2">
            <span class="text-4xl font-bold text-white">￥15</span>
            <span class="text-sm text-white/90">{t('register.sidebar.newUser.trial')}</span>
          </div>
        </div>
      </div>
    </aside>
    
    <!-- 右侧注册表单 -->
    <main class="w-full flex-1 flex items-center justify-center p-4 bg-white">
      <article class="w-full max-w-md">
        <div class="flex items-center mb-8">
          <span class="text-2xl font-bold text-blue-600 mr-3">IPFlex</span>
          <h1 class="text-2xl font-bold text-gray-900">{t('register.title')}</h1>
        </div>

        <Form 
          onSubmit={handleRegisterSubmit}
          inputs={[
            {
              type: 'text',
              name: 'username',
              label: t('register.form.username'),
              placeholder: t('register.form.usernamePlaceholder'),
              required: true,
              containerClassName: 'mb-4'
            },
            {
              type: 'email',
              name: 'email',
              label: t('register.form.email'),
              placeholder: t('register.form.emailPlaceholder'),
              required: true,
              containerClassName: 'mb-4'
            },
            {
              type: 'password',
              name: 'password',
              label: t('register.form.password'),
              placeholder: t('register.form.passwordPlaceholder'),
              required: true,
              containerClassName: 'mb-4'
            },
            {
              type: 'text',
              name: 'invite',
              label: t('register.form.invite'),
              placeholder: t('register.form.invitePlaceholder'),
              containerClassName: 'mb-6',
              value: inviteCode,
              disabled: !!urlInviteCode,
            },
          ]}
          button={{
            text: t('register.form.submit'),
            className: 'w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors',
          }}
        />

      

        <div class="mt-6 text-center text-sm text-gray-500">
          {t('register.hasAccount')}
          <a href='https://dashboard.ipflex.ink/login' class="text-blue-600 hover:text-blue-700 font-medium ml-1">
            {t('register.signIn')}
          </a>
        </div>

        <section class="sr-only" aria-label={t('register.onboardingNotes.title')}>
          <h2>{t('register.onboardingNotes.title')}</h2>
          <p>{t('register.onboardingNotes.p1')}</p>
          <p>{t('register.onboardingNotes.p2')}</p>
        </section>

        <details class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4 text-left">
          <summary class="cursor-pointer list-none text-sm font-semibold text-gray-700">
            {t('register.onboardingNotes.expandTitle')}
          </summary>
          <section class="mt-3">
            <h2 class="mb-3 text-lg font-bold text-gray-900">
              {t('register.onboardingNotes.afterRegisterTitle')}
            </h2>
            <p class="mb-3 text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.afterRegisterP1')}
            </p>
            <p class="text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.afterRegisterP2')}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.checklist')}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.onboardingProcess')}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.productionReadiness')}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {t('register.onboardingNotes.relatedLinksTitle')}
              <a class="ml-2 text-blue-600 hover:text-blue-700" href={`/${lang}/pricing`}>
                {t('register.onboardingNotes.pricing')}
              </a>
              <span class="mx-2">·</span>
              <a class="text-blue-600 hover:text-blue-700" href={`/${lang}/detail`}>
                {t('register.onboardingNotes.productDetails')}
              </a>
              <span class="mx-2">·</span>
              <a class="text-blue-600 hover:text-blue-700" href={`/${lang}/scenarios`}>
                {t('register.onboardingNotes.useCases')}
              </a>
            </p>
          </section>
        </details>
      </article>
    </main>
  </div>
</Layout>

<style>
  :global(main) {
    padding: 0 !important;
  }
  
  input::placeholder {
    color: #9CA3AF;
  }
  
  .form-input {
    @apply block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500;
  }
  
  .form-label {
    @apply block text-sm font-medium text-gray-700 mb-1;
  }
</style>
