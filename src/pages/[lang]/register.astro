---
import Layout from '~/layouts/PageLayout.astro';
import Form from '~/components/ui/Form.astro';
import registerBg from '~/assets/images/bg/register.png';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;

const url = Astro.url;
const urlInviteCode = url.searchParams.get('invite') || url.searchParams.get('ref') || url.searchParams.get('code');
const metadata = {
  title: lang === 'zh'
    ? 'IPFlex 企业代理服务账号注册与接入开通中心与新手接入指引'
    : 'IPFlex Enterprise Proxy Account Registration and Onboarding',
  description: lang === 'zh'
    ? '注册 IPFlex 企业账号，快速开通静态住宅、动态住宅与数据中心线路。支持 API 接入、用量计费、区域定位、会话管理、访问策略、团队协作、日志审计、权限控制和实时监控，适配数据采集、广告核验、跨境运营、账号管理、自动化任务与长期稳定接入。'
    : 'Create an IPFlex account to activate enterprise proxy services with static residential, dynamic residential and datacenter options, API integration, usage-based billing, and global coverage.',
  robots: {
    index: false,
    follow: false,
  },
  ignoreTitleTemplate: true,
};

const alert_msg = lang === 'zh' ? '注册成功!请查看邮箱中的验证邮件完成注册。' : 'Registration successful! Please check your email for verification.';

// 获取缓存的邀请码
const getCachedInviteCode = () => {
  if (typeof window !== 'undefined') {
    const cachedData = localStorage.getItem('inviteCodeData');
    if (cachedData) {
      try {
        const { code, timestamp } = JSON.parse(cachedData);
        const now = new Date().getTime();
        const isExpired = now - timestamp > 24 * 60 * 60 * 1000; // 24小时过期
        
        if (!isExpired) {
          return code;
        }
      } catch (e) {
        // 忽略解析错误
      }
    }
  }
  return null;
};

// 优先使用URL参数中的邀请码，如果没有则使用缓存的邀请码
const inviteCode = urlInviteCode || getCachedInviteCode();

const handleSubmit = `async function(e) {
  e.preventDefault();
  console.log(111111111111111111111111);
  try {
    const formData = new FormData(e.target);
    const inviteInput = e.target.querySelector('input[name="invite"]');
    
    if (inviteInput && inviteInput.disabled) {
      formData.set('invite', inviteInput.value);
    }
    
    // 将常用字段映射到后端期望的字段名
    formData.set('name', formData.get('username')); 
    formData.set('confirm_password', formData.get('password')); 
    formData.set('invite_code', formData.get('invite'));
    
    // 同时提交验证码字段，兼容可能的后端接收字段
    const codeValue = formData.get('code');
    if (codeValue) {
      formData.set('code', codeValue);
    }
    
    const response = await fetch('https://api.ipflex.ink/user/register_link', {
      method: 'POST',
      body: formData
    });

    const result = await response.json();
    console.log(result);
  
    if (result.code === 0) {
      alert('${alert_msg}');
    } else {
      alert(result.msg || '注册失败，请重试');
    }
  } catch (error) {
    console.error('Registration error:', error);
    alert('注册失败，请重试');
  }
}`;
---

<Layout metadata={metadata} has_header={false} has_footer={false}>
  <div id="page-root" data-lang={lang} class="min-h-screen flex">
    <!-- 左侧背景图和文案 -->
    <aside class="hidden md:block relative" style="width: min(45%, 714px);">
      <img src={registerBg.src} alt={lang === 'zh' ? "IPFlex代理IP服务注册背景 - 高速稳定的IP代理" : "IPFlex proxy IP service registration background - Fast and stable IP proxy"} class="h-screen w-full object-cover object-left" />
      <div class="absolute inset-0 flex flex-col justify-between p-12">
        <div>
          <p class="text-xl font-medium text-gray-800 mb-16 text-center">{lang === 'zh' ? '专业的代理服务提供商' : 'Professional Proxy Service Provider'}</p>
          
          <div class="space-y-3">
            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{lang === 'zh' ? '高速稳定' : 'Fast & Stable'}</p>
                <p class="text-sm text-gray-600">{lang === 'zh' ? '采用优质线路，确保代理服务的稳定性和速度' : 'Premium network ensures stability and speed'}</p>
              </div>
            </div>

            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{lang === 'zh' ? '安全匿名' : 'Safe & Anonymous'}</p>
                <p class="text-sm text-gray-600">{lang === 'zh' ? '采用加密技术，保护您的隐私安全' : 'Encryption technology protects your privacy'}</p>
              </div>
            </div>

            <div class="flex items-start space-x-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg">
              <div class="w-12 h-12 rounded-lg bg-blue-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
              </div>
              <div>
                <p class="text-lg font-medium mb-1 text-gray-800">{lang === 'zh' ? '按量计费' : 'Pay As You Go'}</p>
                <p class="text-sm text-gray-600">{lang === 'zh' ? '无需月付，充值即可使用，余额永久有效' : 'No monthly fee, pay as you go, balance never expires'}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-11 p-4 bg-blue-500/60 rounded-xl">
          <p class="text-sm font-medium mb-1 text-white">{lang === 'zh' ? '新用户专享' : 'New User Special'}</p>
          <div class="flex items-baseline space-x-2">
            <span class="text-4xl font-bold text-white">￥15</span>
            <span class="text-sm text-white/90">{lang === 'zh' ? '体验金' : 'Trial Balance'}</span>
          </div>
        </div>
      </div>
    </aside>
    
    <!-- 右侧注册表单 -->
    <main class="w-full flex-1 flex items-center justify-center p-4 bg-white">
      <article class="w-full max-w-md">
        <div class="flex items-center mb-8">
          <span class="text-2xl font-bold text-blue-600 mr-3">IPFlex</span>
          <h1 class="text-2xl font-bold text-gray-900">{lang === 'zh' ? '立即注册 IPFlex 账号' : 'Create Your IPFlex Account'}</h1>
        </div>

        <Form 
          inputs={[
            {
              type: 'text',
              name: 'username',
              label: lang === 'zh' ? '用户名' : 'Username',
              placeholder: lang === 'zh' ? '4~6位字符' : '4-6 characters',
              required: true,
              containerClassName: 'mb-4'
            },
            {
              type: 'email',
              name: 'email',
              label: lang === 'zh' ? '邮箱' : 'Email',
              placeholder: lang === 'zh' ? '请输入邮箱' : 'Enter your email',
              required: true,
              containerClassName: 'mb-4'
            },
            //             {
            //   type: 'text',
            //   name: 'code',
            //   label: lang === 'zh' ? '验证码' : 'Verification Code',
            //   placeholder: lang === 'zh' ? '请输入邮箱验证码' : 'Enter the code you received by email',
            //   containerClassName: 'mb-6',
            //   value: '',
            //   required: true
            // },
            {
              type: 'password',
              name: 'password',
              label: lang === 'zh' ? '密码' : 'Password',
              placeholder: lang === 'zh' ? '6~20位字符' : '6-20 characters',
              required: true,
              containerClassName: 'mb-4'
            },
            {
              type: 'text',
              name: 'invite',
              label: lang === 'zh' ? '邀请码' : 'Invite Code',
              placeholder: lang === 'zh' ? '选填' : 'Optional',
              containerClassName: 'mb-6',
              value: inviteCode,
              disabled: !!urlInviteCode,
            },

          ]}
          button={{
            text: lang === 'zh' ? '注 册' : 'Register',
            className: 'w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors',
            onclick: handleSubmit
          }}
        />

      

        <div class="mt-6 text-center text-sm text-gray-500">
          {lang === 'zh' ? '已有账号？' : 'Already have an account?'}
          <a href='https://dashboard.ipflex.ink/login' class="text-blue-600 hover:text-blue-700 font-medium ml-1">
            {lang === 'zh' ? '立即登录' : 'Sign in'}
          </a>
        </div>

        <details class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4 text-left">
          <summary class="cursor-pointer list-none text-sm font-semibold text-gray-700">
            {lang === 'zh' ? '注册接入说明（展开查看）' : 'Registration Onboarding Notes (Expand)'}
          </summary>
          <section class="mt-3">
            <h2 class="mb-3 text-lg font-bold text-gray-900">
              {lang === 'zh' ? '注册后你可以立即开始什么' : 'What You Can Start Right After Registration'}
            </h2>
            <p class="mb-3 text-sm leading-6 text-gray-700">
              {lang === 'zh'
                ? '完成注册后，你可以在控制台创建代理提取配置、查看实时用量、管理 API 凭证并按业务场景选择不同代理类型。对于账号运营和长期会话任务，建议优先启用静态住宅代理；对于大规模采集任务，建议使用动态住宅代理并配置重试策略；对于高并发程序化任务，可使用数据中心代理优化吞吐和成本。'
                : 'After registration, you can create proxy extraction settings, monitor real-time usage, manage API credentials, and select proxy types by workload. Use static residential proxies for persistent account sessions, dynamic residential proxies for large-scale collection with retry strategy, and datacenter proxies for high-throughput automation at lower cost.'}
            </p>
            <p class="text-sm leading-6 text-gray-700">
              {lang === 'zh'
                ? '建议首次接入时先进行小流量验证，确认目标站点可达性、请求成功率和地域命中情况，再逐步放量。这样可以更稳妥地控制预算，并在上线前提前发现风控或兼容性问题。'
                : 'For first-time onboarding, begin with a small traffic test to validate reachability, success rate, and geo targeting before scaling up. This staged rollout helps control budget and catch compatibility or anti-bot issues early.'}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {lang === 'zh'
                ? '建议在接入初期优先完成基础检查项：创建 API 凭证、确认线路区域、验证请求成功率、监测响应时延，并按阶段逐步放量。'
                : 'Registration onboarding checklist: create API credentials, configure endpoint region, validate request success rate, monitor response latency, and scale traffic gradually from staging to production.'}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {lang === 'zh'
                ? '完整接入流程通常包括：明确业务目标、梳理请求模式、配置鉴权机制、验证路由行为、检查异常处理并建立统一监控指标。上线前做完这些准备，通常能获得更稳定的运行表现、更清晰的容量规划和更高效的排障节奏。'
                : 'Successful onboarding usually follows a clear sequence: define business goals, map request patterns, configure authentication, validate routing behavior, review error handling, and monitor service quality with consistent metrics. Teams that complete this checklist before production rollout often achieve better stability, clearer capacity planning, and faster troubleshooting when traffic scales. This practical process also reduces avoidable rework in later integration stages.'}
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-700">
              {lang === 'zh'
                ? '生产阶段可继续建立凭证轮换策略、线路兜底方案、超时基线和每周质量复盘机制，以保证持续交付的稳定性。'
                : 'Production readiness checklist: credential rotation policy, endpoint fallback strategy, request timeout baseline, and weekly quality review cadence.'}
            </p>
          </section>
        </details>
        <section class="mt-4 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3 text-xs text-gray-600">
          <p>
            {lang === 'zh'
              ? 'Onboarding baseline: validate endpoint availability, authentication behavior, success ratio, latency trend, and retry handling before scaling traffic. This reduces integration risk and improves operational predictability.'
              : 'Onboarding baseline: validate endpoint availability, authentication behavior, success ratio, latency trend, and retry handling before scaling traffic. This reduces integration risk and improves operational predictability.'}
          </p>
          <p class="mt-2">
            {lang === 'zh'
              ? 'Delivery checklist: assign ownership, define rollback path, monitor quality drift, and keep weekly review cadence so integration progress remains measurable and stable.'
              : 'Delivery checklist: assign ownership, define rollback path, monitor quality drift, and keep weekly review cadence so integration progress remains measurable and stable.'}
          </p>
          <p class="mt-2">
            {lang === 'zh'
              ? 'Execution guidance: document assumptions, keep change records, verify outcomes against predefined checkpoints, and summarize lessons after each rollout. Teams that follow this discipline usually reduce rework and improve delivery consistency over time.'
              : 'Execution guidance: document assumptions, keep change records, verify outcomes against predefined checkpoints, and summarize lessons after each rollout. Teams that follow this discipline usually reduce rework and improve delivery consistency over time.'}
          </p>
          <ul class="mt-2 list-disc pl-4">
            <li>{lang === 'zh' ? 'Create credentials and configure access policy.' : 'Create credentials and configure access policy.'}</li>
            <li>{lang === 'zh' ? 'Run small-batch verification and monitor logs.' : 'Run small-batch verification and monitor logs.'}</li>
            <li>{lang === 'zh' ? 'Scale gradually with weekly quality review.' : 'Scale gradually with weekly quality review.'}</li>
          </ul>
        </section>
      </article>
    </main>
  </div>
</Layout>

<style>
  :global(main) {
    padding: 0 !important;
  }
  
  input::placeholder {
    color: #9CA3AF;
  }
  
  .form-input {
    @apply block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500;
  }
  
  .form-label {
    @apply block text-sm font-medium text-gray-700 mb-1;
  }
</style>



<!-- 邀请码优先从URL参数获取，若无则读取本地缓存 -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const urlInviteCodeLocal = urlParams.get('invite') || urlParams.get('ref') || urlParams.get('code');

    // 获取缓存的邀请码
    const getCachedInviteCode = () => {
      const cachedData = localStorage.getItem('inviteCodeData');
      if (cachedData) {
        try {
          const { code, timestamp } = JSON.parse(cachedData);
          const now = new Date().getTime();
          const isExpired = now - timestamp > 24 * 60 * 60 * 1000; // 24小时过期
          if (!isExpired) return code;
        } catch (e) {
          // 解析失败忽略
        }
      }
      return null;
    };

    // 优先使用URL参数中的邀请码，如果没有则使用缓存的邀请码
    const cachedInvite = getCachedInviteCode();
    const finalInvite = urlInviteCodeLocal || cachedInvite;

    if (finalInvite) {
      const inviteInput = document.querySelector('input[name="invite"]');
      if (inviteInput) {
        inviteInput.value = finalInvite;
        if (urlInviteCodeLocal) {
          inviteInput.disabled = true;
        }
      }
    }
  });
</script>
