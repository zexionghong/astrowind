---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang } from '~/utils/schema';

export async function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('referral.title'),
  description: t('referral.description'),
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="bg-white dark:bg-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-blue-600 dark:text-blue-400 font-semibold text-lg mb-4">
          🎉 {t('referral.hero.badge')}
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6">
          {t('referral.hero.title')}
          <span class="text-blue-600 dark:text-blue-400">
            {t('referral.hero.titleHighlight')}
          </span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
          {t('referral.hero.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="https://dashboard.ipflex.ink/register"
            target="_blank"
            class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold text-lg transition-colors"
          >
            {t('referral.hero.primaryCta')}
          </a>
          <a 
            href="https://dashboard.ipflex.ink/login"
            target="_blank"
            class="border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 px-8 py-3 rounded-lg font-semibold text-lg transition-colors"
          >
            {t('referral.hero.secondaryCta')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-gray-50 dark:bg-gray-800 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {Array.isArray(t('referral.stats')) && t('referral.stats').map((stat: any) => (
          <div class="text-center">
            <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">{stat.value}</div>
            <div class="text-gray-600 dark:text-gray-300">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it Works -->
  <section class="bg-white dark:bg-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          {t('referral.howItWorks.title')}
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300">
          {t('referral.howItWorks.subtitle')}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {Array.isArray(t('referral.howItWorks.steps')) && t('referral.howItWorks.steps').map((step: any, index: number) => (
          <div class="text-center">
            <div class:list={[
              'w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4',
              index === 0 && 'bg-blue-100 dark:bg-blue-900',
              index === 1 && 'bg-green-100 dark:bg-green-900',
              index === 2 && 'bg-purple-100 dark:bg-purple-900',
              index === 3 && 'bg-orange-100 dark:bg-orange-900',
            ]}>
              <span class="text-2xl">{index + 1}</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{step.title}</h3>
            <p class="text-gray-600 dark:text-gray-300">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simple Commission Structure -->
  <section class="bg-gray-50 dark:bg-gray-800 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          {t('referral.commission.title')}
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300">
          {t('referral.commission.subtitle')}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-xl text-center border-2 border-blue-500">
          <div class="text-6xl mb-6">💰</div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            {t('referral.commission.highlight')}
          </h3>
          <div class="text-5xl font-bold text-blue-600 dark:text-blue-400 mb-6">10%</div>
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
            {t('referral.commission.description')}
          </p>
          
          <div class="grid md:grid-cols-3 gap-6">
            {Array.isArray(t('referral.commission.features')) && t('referral.commission.features').map((feature: any, index: number) => (
              <div class:list={[
                'p-6 rounded-xl',
                index === 0 && 'bg-blue-50 dark:bg-blue-900/30',
                index === 1 && 'bg-green-50 dark:bg-green-900/30',
                index === 2 && 'bg-purple-50 dark:bg-purple-900/30',
              ]}>
                <h4 class="font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-blue-600 dark:bg-blue-800 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {t('referral.cta.title')}
      </h2>
      <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
        {t('referral.cta.description')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://dashboard.ipflex.ink/register"
          target="_blank"
          class="bg-white hover:bg-gray-100 text-blue-600 px-8 py-3 rounded-lg font-semibold text-lg transition-colors"
        >
          {t('referral.cta.primaryCta')}
        </a>
        <a 
          href="https://dashboard.ipflex.ink/login"
          target="_blank"
          class="border border-blue-300 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold text-lg transition-colors"
        >
          {t('referral.cta.secondaryCta')}
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 text-sm leading-7 text-gray-700" lang="en">
      Referral compliance note: communicate commission terms clearly, avoid exaggerated earning claims, respect local advertising regulations, and keep payout records for audit and dispute resolution.
    </div>
  </section>
</Layout>