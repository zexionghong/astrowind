---
import Layout from '~/layouts/PageLayout.astro';
import Prices from '~/components/widgets/Pricing.astro';
import SimpleReferralWidget from '~/components/widgets/SimpleReferralWidget.astro';
import { SITE } from 'astrowind:config';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang, generateBreadcrumbSchema, generateFAQSchema } from '~/utils/schema';

export function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('pricing.metadata.title'),
  description: t('pricing.metadata.description'),
};
const pricingIntro = t('pricing.intro');
const guideContent = t('pricing.guideContent');
const guideList = t('pricing.guideList');

const pricingFaqsRaw = t('pricing.faqs');
const pricingFaqs = Array.isArray(pricingFaqsRaw) ? pricingFaqsRaw : [];

const breadcrumbSchema = generateBreadcrumbSchema(lang, t('pricing.hero.title'), 'pricing');
const pricingFaqSchema = generateFAQSchema(pricingFaqs);

const prices = [
  {
    title: t('pricing.plans.static.title'),
    subtitle: t('pricing.plans.static.subtitle'),
    price: t('pricing.plans.static.price'),
    period: t('pricing.plans.static.period'),
    items: Array.isArray(t('pricing.plans.static.features')) ? t('pricing.plans.static.features').map((feature: any) => ({
      description: feature,
    })) : [],
    callToAction: {
      target: '_blank',
      text: t('pricing.plans.static.action'),
      href: SITE.dashboard,
    },
  },
  {
    title: t('pricing.plans.dynamic.title'),
    subtitle: t('pricing.plans.dynamic.subtitle'),
    price: t('pricing.plans.dynamic.price'),
    period: t('pricing.plans.dynamic.period'),
    items: Array.isArray(t('pricing.plans.dynamic.features')) ? t('pricing.plans.dynamic.features').map((feature: any) => ({
      description: feature,
    })) : [],
    callToAction: {
      target: '_blank',
      text: t('pricing.plans.dynamic.action'),
      href: SITE.dashboard,
    },
    hasRibbon: true,
    ribbonTitle: t('pricing.plans.dynamic.ribbon'),
  },
  {
    title: t('pricing.plans.datacenter.title'),
    subtitle: t('pricing.plans.datacenter.subtitle'),
    price: t('pricing.plans.datacenter.price'),
    period: t('pricing.plans.datacenter.period'),
    items: Array.isArray(t('pricing.plans.datacenter.features')) ? t('pricing.plans.datacenter.features').map((feature: any) => ({
      description: feature,
    })) : [],
    callToAction: {
      target: '_blank',
      text: t('pricing.plans.datacenter.action'),
      href: SITE.dashboard,
    },
  },
];

const features = {
  title: t('pricing.features.title'),
    subtitle: t('pricing.features.subtitle'),
    items: t('pricing.features.items'),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: t('pricing.metadata.title'),
  description: pricingIntro,
  provider: {
    '@type': 'Organization',
    name: 'IPFlex',
    url: 'https://ipflex.ink',
  },
  areaServed: 'Worldwide',
  serviceType: [
    'Static Residential Proxy',
    'Dynamic Residential Proxy',
    'Datacenter Proxy',
  ],
  offers: prices.map((plan) => ({
    '@type': 'Offer',
    name: plan.title,
    price: plan.price,
    priceCurrency: 'USD',
    category: plan.subtitle,
    availability: 'https://schema.org/InStock',
    url: 'https://ipflex.ink/' + lang + '/pricing',
  })),
  url: 'https://ipflex.ink/' + lang + '/pricing',
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)} />
  
  <!-- <HeroText
    title={t('pricing.hero.title')}
    subtitle={t('pricing.hero.subtitle')}
  /> -->

  <div class="overflow-x-hidden">
    <Prices prices={prices} title={t('pricing.hero.title')} subtitle={t('pricing.hero.subtitle')} features={features} />
  </div>

  <section class="mx-auto max-w-5xl px-4 py-14">
    <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
      {t('pricing.guideTitle')}
    </h2>
    <p class="mb-4 text-base leading-7 text-gray-700 dark:text-gray-300">
      {pricingIntro}
    </p>
    {Array.isArray(guideContent) && guideContent.map((item: any) => (
      <p class="mb-4 text-base leading-7 text-gray-700 dark:text-gray-300">{item}</p>
    ))}
    <ul class="list-disc space-y-2 pl-5 text-base leading-7 text-gray-700 dark:text-gray-300">
      {Array.isArray(guideList) && guideList.map((item: any) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-14">
    <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
      {t('pricing.faqTitle')}
    </h2>
    <div class="space-y-4">
      {pricingFaqs.map((item: any) => (
        <article class="rounded-xl border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{item.q}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-700 dark:text-gray-300">{item.a}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- <Features3
    title={t('pricing.features.title')}
    subtitle={t('pricing.features.subtitle')}
    columns={2}
    items={t('pricing.features.items')}
    classes={{ container: 'max-w-5xl' }}
  /> -->

  <!-- 其他组件的国际化... -->

  <!-- Simple Referral Widget -->
  <SimpleReferralWidget lang={lang} />
</Layout>

<style>
  :global(main) {
    overflow-x: hidden;
  }
</style>
