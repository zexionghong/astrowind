---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import WhyChooseUs from '~/components/widgets/WhyChooseUs.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import heroImage from '~/assets/images/proxies/2-1.webp';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const cases = t('moreCases');

---

<Layout
  metadata={{
    title: t('crawling.metadata.title'),
    description: t('crawling.metadata.description'),
    ignoreTitleTemplate: true,
  }}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-900 via-blue-900 to-indigo-900 text-white overflow-hidden">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
            {t('crawling.hero.title')}
          </h1>
          <p class="text-xl mb-8 text-purple-100">
            {t('crawling.hero.subtitle')}
          </p>
          <ul class="space-y-4 mb-8">
            {(t('crawling.hero.features') || []).map((feature: string) => (
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg">{feature}</span>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 pt-4">
             <a  href="https://dashboard.ipflex.ink/register" class="bg-[#00E062] hover:bg-[#00C054] text-[#1A1147] font-semibold px-6 py-3 rounded-lg transition-all duration-200">
              {t('crawling.hero.cta.primary')}
            </a>
          </div>
        </div>
        <div class="relative">
          <img src={heroImage.src} alt="Dynamic Residential Proxy Crawling" class="rounded-2xl shadow-2xl" />
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- 场景卡片 -->
      <div class="rounded-xl shadow-lg border p-7 bg-gradient-to-br from-purple-50 to-white">
        <h2 class="text-3xl font-bold mb-4 text-[#6B46C1] flex items-center gap-2">
          <svg width="30" height="30" fill="none" stroke="#8B5CF6" stroke-width="3"><circle cx="15" cy="15" r="14" /></svg>
          {t('crawling.scenario.title')}
        </h2>
        <ul class="divide-y divide-[#C4B5FD]">
          {(t('crawling.scenario.steps') || []).map((step: string, idx: number) => (
            <li class="py-4 flex items-center gap-3">
              <span class="inline-flex items-center justify-center w-10 h-10 text-lg bg-[#8B5CF633] rounded-full font-bold text-[#6B46C1]">{idx + 1}</span>
              {step}
            </li>
          ))}
        </ul>
      </div>

      <!-- 优势/痛点卡片 -->
      <div class="rounded-xl shadow-lg border p-7 bg-gradient-to-br from-slate-50 to-white">
        <h2 class="text-2xl font-bold mb-4 text-[#ba732c] flex items-center gap-2">
          <svg width="28" height="28" fill="none" stroke="#F59E42" stroke-width="2.5"><rect x="4" y="4" width="20" height="20" rx="10" /></svg>
          {t('crawling.painGain.title')}
        </h2>
        <div class="flex flex-col gap-2">
          {(t('crawling.painGain.pros') || []).map((pro: string) => (
            <div class="bg-green-100/80 px-3 py-2 rounded flex gap-2 items-center">
              <span class="font-bold text-[#14a67d]">✓</span> {pro}
            </div>
          ))}
          {(t('crawling.painGain.cons') || []).map((con: string) => (
            <div class="bg-red-100/80 px-3 py-2 rounded flex gap-2 items-center">
              <span class="font-bold text-[#dc2626]">✗</span> {con}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 工作流程 -->
  <section class="max-w-6xl mx-auto py-10">
    <h2 class="text-3xl font-bold text-center mb-8">{t('crawling.flow.title')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
      {(t('crawling.flow.steps') || []).map((step: string, idx: number) => (
        <div class="text-center">
          <div class="w-16 h-16 bg-[#8B5CF6] text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">
            {idx + 1}
          </div>
          <p class="text-sm font-medium">{step}</p>
        </div>
      ))}
    </div>
  </section>

  <WhyChooseUs
    title={t('crawling.whyChooseUs.title')}
    items={t('crawling.whyChooseUs.features')}
    classes={{
      container: 'max-w-6xl',
      title: 'text-3xl font-bold text-center mb-12',
    }}
  />

  <section class="max-w-5xl mx-auto py-10">
    <h2 class="text-2xl font-semibold mb-4">{t('moreCasesTitle') || '更多动态住宅代理应用场景'}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      {cases.map((x) => (
        <a href={x.url} class="block p-4 rounded-lg border-2 border-[#8B5CF6] bg-purple-50 text-[#6B46C1] font-semibold cursor-pointer">
          {x.title}
          <div class="text-xs text-gray-500 mt-2">{x.description}</div>
        </a>
      ))}
    </div>
  </section>

  <FAQs
    title={t('crawling.faqs.title')}
    subtitle={t('crawling.faqs.subtitle')}
    tagline={t('crawling.faqs.tagline')}
    items={t('crawling.faqs.items')}
  />
</Layout>
