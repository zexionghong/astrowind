---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/utils/i18n';
import { getStaticPathsForLang, generateBreadcrumbSchema } from '~/utils/schema';

export async function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang = 'zh' } = Astro.params;
const t = useTranslations(lang);

const metadata = {
  title: t('about.title'),
  description: t('about.description'),
  ignoreTitleTemplate: true,
};

const principles = t('about.principles.items');
const facts = t('about.whatWeDo.facts');
const faqs = t('about.faq.items');

const breadcrumbSchema = generateBreadcrumbSchema(lang, t('about.header.title'), 'about');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IPFlex',
  url: 'https://ipflex.ink',
  logo: 'https://ipflex.ink/_astro/logo.C27jQ6H2.png',
  description: t('about.header.description'),
  sameAs: ['https://x.com/IPFlexSupport', 'https://t.me/IPFlexProxy', 'https://docs.ipflex.ink/'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'support@ipflex.ink',
    availableLanguage: ['zh-CN', 'en-US'],
  },
};

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t('about.header.title'),
  description: metadata.description,
  url: `https://ipflex.ink/${lang}/about`,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
  about: {
    '@type': 'Organization',
    name: 'IPFlex',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <header class="rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-blue-50 p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">
        {t('about.header.eyebrow')}
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        {t('about.header.title')}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-gray-700">
        {t('about.header.description')}
      </p>
    </header>

    <section class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900">
          {t('about.whatWeDo.title')}
        </h2>
        <p class="mt-3 text-base leading-7 text-gray-700">
          {t('about.whatWeDo.description')}
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-700">
          {Array.isArray(facts) && facts.map((item: any) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900">
          {t('about.evaluation.title')}
        </h2>
        <p class="mt-3 text-base leading-7 text-gray-700">
          {t('about.evaluation.description')}
        </p>
        <div class="mt-4 rounded-xl border border-gray-200 bg-slate-50 p-4 text-sm leading-6 text-gray-700">
          <strong>{t('about.evaluation.fourQuestions')}</strong>
          <ol class="mt-2 list-decimal space-y-1 pl-5">
            {Array.isArray(t('about.evaluation.questions')) && t('about.evaluation.questions').map((q: any) => <li>{q}</li>)}
          </ol>
        </div>
      </article>
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-bold text-gray-900">
        {t('about.principles.title')}
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {Array.isArray(principles) && principles.map((item: any) => (
          <article class="rounded-xl border border-gray-200 p-5">
            <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-700">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-slate-50 p-6">
      <h2 class="text-2xl font-bold text-gray-900">
        {t('about.nextSteps.title')}
      </h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <a href={`/${lang}/detail`} class="rounded-xl border border-gray-200 bg-white p-5 transition-colors hover:border-blue-300 hover:bg-blue-50/40">
          <h3 class="text-lg font-semibold text-gray-900">{t('about.nextSteps.proxyGuide.title')}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-700">
            {t('about.nextSteps.proxyGuide.description')}
          </p>
        </a>
        <a href={`/${lang}/resources`} class="rounded-xl border border-gray-200 bg-white p-5 transition-colors hover:border-blue-300 hover:bg-blue-50/40">
          <h3 class="text-lg font-semibold text-gray-900">{t('about.nextSteps.resources.title')}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-700">
            {t('about.nextSteps.resources.description')}
          </p>
        </a>
      </div>
    </section>

    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-bold text-gray-900">
        {t('about.faq.title')}
      </h2>
      <div class="mt-5 space-y-4">
        {Array.isArray(faqs) && faqs.map((item: any) => (
          <article class="rounded-xl border border-gray-200 p-5">
            <h3 class="text-lg font-semibold text-gray-900">{item.q}</h3>
            <p class="mt-2 text-sm leading-6 text-gray-700">{item.a}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</Layout>
