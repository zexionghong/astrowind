---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '~/i18n/utils';

const metadata = {
  title: 'IPFlex应用场景',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section with Animation -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary-100 to-primary-50 dark:from-slate-900 dark:to-slate-800">
    <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    <div class="container mx-auto px-4 py-20 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6 bg-gradient-to-r from-primary-600 to-primary-400 dark:from-primary-400 dark:to-primary-200 text-transparent bg-clip-text">
          解锁边界，畅享无限可能
        </h1>
        <p class="text-2xl text-gray-700 dark:text-gray-300 mb-10">
          IPFlex 代理让每一业务场景畅行无忧，助您突破限制，链接全球
        </p>
        <div class="flex justify-center gap-6">
          <a href="/register" class="btn btn-primary px-8 py-4 text-lg rounded-full hover:scale-105 transform transition-transform duration-200 shadow-lg hover:shadow-xl">
            立即使用
          </a>
          <a href="#scenarios" class="btn btn-ghost px-8 py-4 text-lg rounded-full hover:bg-primary-50 dark:hover:bg-slate-700">
            了解更多
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Scenarios Section -->
  <section id="scenarios" class="py-20 bg-white dark:bg-slate-900">
    <div class="container mx-auto px-4">
      <!-- 网页数据采集 & 电子商务运营 -->
      <div class="grid lg:grid-cols-2 gap-8 mb-20">
        <div class="group">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-slate-800 dark:to-slate-700 p-8 rounded-3xl transition-all duration-300 hover:shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-200 dark:bg-blue-800 rounded-full -mr-16 -mt-16 opacity-50"></div>
            <div class="relative">
              <div class="flex items-center mb-6">
                <div class="bg-blue-500 text-white p-3 rounded-2xl">
                  <Icon name="tabler:database" class="w-8 h-8" />
                </div>
                <h3 class="text-2xl font-bold ml-4 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">网页数据采集</h3>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-8 text-lg leading-relaxed">
                突破网站反爬虫限制，隐藏真实 IP，模拟多用户访问，让数据采集持续、高效。
              </p>
              <ul class="space-y-4">
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-blue-500 mr-3 flex-shrink-0" />
                  <span>数据获取全面广泛，无遗漏</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-blue-500 mr-3 flex-shrink-0" />
                  <span>采集过程高效快速，省时间</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-blue-500 mr-3 flex-shrink-0" />
                  <span>定位目标精准准确，质量高</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="group">
          <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-slate-800 dark:to-slate-700 p-8 rounded-3xl transition-all duration-300 hover:shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-purple-200 dark:bg-purple-800 rounded-full -mr-16 -mt-16 opacity-50"></div>
            <div class="relative">
              <div class="flex items-center mb-6">
                <div class="bg-purple-500 text-white p-3 rounded-2xl">
                  <Icon name="tabler:shopping-cart" class="w-8 h-8" />
                </div>
                <h3 class="text-2xl font-bold ml-4 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">电子商务运营</h3>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-8 text-lg leading-relaxed">
                监控竞品价格、库存，跨境时突破地域限制，模拟各地用户访问，助力商家灵活制定策略。
              </p>
              <ul class="space-y-4">
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-purple-500 mr-3 flex-shrink-0" />
                  <span>敏锐洞察商机，抢占市场先机</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-purple-500 mr-3 flex-shrink-0" />
                  <span>精准优化策略，提升产品竞争力</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-purple-500 mr-3 flex-shrink-0" />
                  <span>突显竞争优势，稳固市场地位</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- 市场调研洞察 & 社交媒体拓展 -->
      <div class="grid lg:grid-cols-2 gap-8 mb-20">
        <div class="group">
          <div class="bg-gradient-to-br from-green-50 to-green-100 dark:from-slate-800 dark:to-slate-700 p-8 rounded-3xl transition-all duration-300 hover:shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-green-200 dark:bg-green-800 rounded-full -mr-16 -mt-16 opacity-50"></div>
            <div class="relative">
              <div class="flex items-center mb-6">
                <div class="bg-green-500 text-white p-3 rounded-2xl">
                  <Icon name="tabler:chart-dots" class="w-8 h-8" />
                </div>
                <h3 class="text-2xl font-bold ml-4 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">市场调研洞察</h3>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-8 text-lg leading-relaxed">
                跨越地域与访问频率阻碍，深入各地数据源，确保调研数据精准、可靠。
              </p>
              <ul class="space-y-4">
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" />
                  <span>深度洞察需求，助力产品研发</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" />
                  <span>精准定位市场，优化推广策略</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" />
                  <span>准确预测趋势，引领行业发展</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="group">
          <div class="bg-gradient-to-br from-orange-50 to-orange-100 dark:from-slate-800 dark:to-slate-700 p-8 rounded-3xl transition-all duration-300 hover:shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-orange-200 dark:bg-orange-800 rounded-full -mr-16 -mt-16 opacity-50"></div>
            <div class="relative">
              <div class="flex items-center mb-6">
                <div class="bg-orange-500 text-white p-3 rounded-2xl">
                  <Icon name="tabler:share" class="w-8 h-8" />
                </div>
                <h3 class="text-2xl font-bold ml-4 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">社交媒体拓展</h3>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-8 text-lg leading-relaxed">
                突破平台地域限制，伪装多样用户操作，提升账号曝光与互动，帮您挖掘全球潜在粉丝。
              </p>
              <ul class="space-y-4">
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-orange-500 mr-3 flex-shrink-0" />
                  <span>大幅加速品牌曝光，吸引潜在客户</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-orange-500 mr-3 flex-shrink-0" />
                  <span>精准定位目标受众，提高粉丝质量</span>
                </li>
                <li class="flex items-center text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm">
                  <Icon name="tabler:check" class="w-5 h-5 text-orange-500 mr-3 flex-shrink-0" />
                  <span>有效规避平台限制，保障营销稳定</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- 其他场景快速预览 -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- SEO策略优化 -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-lg hover:shadow-xl transition-shadow group cursor-pointer">
          <div class="flex items-center mb-4">
            <div class="bg-indigo-100 dark:bg-indigo-900 p-3 rounded-xl">
              <Icon name="tabler:search" class="w-6 h-6 text-indigo-600 dark:text-indigo-400" />
            </div>
            <h3 class="text-xl font-bold ml-4 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">SEO策略优化</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400">模拟各地搜索行为，精准洞察排名，优化网站内容与关键词。</p>
        </div>

        <!-- 广告投放增效 -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-lg hover:shadow-xl transition-shadow group cursor-pointer">
          <div class="flex items-center mb-4">
            <div class="bg-pink-100 dark:bg-pink-900 p-3 rounded-xl">
              <Icon name="tabler:ad" class="w-6 h-6 text-pink-600 dark:text-pink-400" />
            </div>
            <h3 class="text-xl font-bold ml-4 group-hover:text-pink-600 dark:group-hover:text-pink-400">广告投放增效</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400">模拟多元用户投放反馈，精准优化广告，识别过滤欺诈点击。</p>
        </div>

        <!-- 网站性能测试 -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-lg hover:shadow-xl transition-shadow group cursor-pointer">
          <div class="flex items-center mb-4">
            <div class="bg-cyan-100 dark:bg-cyan-900 p-3 rounded-xl">
              <Icon name="tabler:gauge" class="w-6 h-6 text-cyan-600 dark:text-cyan-400" />
            </div>
            <h3 class="text-xl font-bold ml-4 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">网站性能测试</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400">模拟不同网络、地域用户访问，精准定位性能瓶颈。</p>
        </div>

        <!-- 品牌安全守护 -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-lg hover:shadow-xl transition-shadow group cursor-pointer">
          <div class="flex items-center mb-4">
            <div class="bg-red-100 dark:bg-red-900 p-3 rounded-xl">
              <Icon name="tabler:shield" class="w-6 h-6 text-red-600 dark:text-red-400" />
            </div>
            <h3 class="text-xl font-bold ml-4 group-hover:text-red-600 dark:group-hover:text-red-400">品牌安全守护</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400">全网扫描侵权假冒，追踪攻击源头，加密数据共享。</p>
        </div>

        <!-- 舆情动态追踪 -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-lg hover:shadow-xl transition-shadow group cursor-pointer">
          <div class="flex items-center mb-4">
            <div class="bg-amber-100 dark:bg-amber-900 p-3 rounded-xl">
              <Icon name="tabler:radar" class="w-6 h-6 text-amber-600 dark:text-amber-400" />
            </div>
            <h3 class="text-xl font-bold ml-4 group-hover:text-amber-600 dark:group-hover:text-amber-400">舆情动态追踪</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400">突破信息获取限制，汇集全球舆情，掌握舆论风向。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-primary-700 dark:from-primary-900 dark:to-primary-800">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold text-white mb-8">准备好开始使用了吗？</h2>
      <p class="text-xl text-primary-100 mb-10 max-w-2xl mx-auto">
        立即注册，体验 IPFlex 为您带来的无限可能
      </p>
      <a href="/register" class="inline-block bg-white text-primary-600 px-8 py-4 rounded-full text-lg font-semibold hover:bg-primary-50 transition-colors duration-200">
        开始免费试用
      </a>
    </div>
  </section>
</Layout>

<style>
  .bg-grid-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.1) 1px, transparent 0);
    background-size: 40px 40px;
  }
</style> 