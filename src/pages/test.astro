---
import Layout from '~/layouts/PageLayout.astro';


const metadata = {
  title: 'IpFlex — 专业的IP代理服务提供商',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="py-16 bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-base text-primary-600 font-semibold tracking-wide uppercase">应用场景</p>
        <h2 class="mt-2 text-3xl leading-8 font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          IPFlex 助力多场景应用
        </h2>
        <p class="mt-4 max-w-2xl text-xl text-gray-500 dark:text-gray-300 mx-auto">
          为您的业务提供全方位的IP代理解决方案
        </p>
      </div>
  
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {/* 数据采集类 */}
        <div class="relative group">
          <div class="h-full p-6 bg-white dark:bg-gray-800 rounded-xl shadow-xl transition duration-500 ease-in-out hover:transform hover:-translate-y-1 hover:shadow-2xl">
            <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600 dark:text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">网页数据采集</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-4">
              借助代理IP，轻松突破网站限制，穿梭于海量网页间，精准抓取文本、图片、数据等信息，为市场分析、竞品调研提供有力支撑。
            </p>
            <a href="#" class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline">
              了解更多
              <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
  
        {/* 可以继续添加其他8个场景，使用相同的卡片结构 */}
      </div>
  
      <div class="mt-16 text-center">
        <a href="#contact" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 md:py-4 md:text-lg md:px-10">
          联系我们
        </a>
      </div>
    </div>
  </section>
  
</Layout>
<style>
  /* 添加渐变背景动画效果 */
  .bg-gradient-to-b {
    background-size: 200% 200%;
    animation: gradient 15s ease infinite;
  }

  @keyframes gradient {
    0% {
      background-position: 50% 0%;
    }
    50% {
      background-position: 50% 100%;
    }
    100% {
      background-position: 50% 0%;
    }
  }

  /* 卡片悬停效果 */
  .group:hover .shadow-xl {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
</style>